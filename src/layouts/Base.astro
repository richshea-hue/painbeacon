---
import '../styles/global.css';
import { SITE } from '../lib/site.js';

const {
  title,
  description = SITE.description,
  canonical,
  jsonld = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE.url).href;
const blocks = Array.isArray(jsonld) ? jsonld : [jsonld];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2e3a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Montserrat:wght@600;700&display=swap"
      rel="stylesheet"
    />

    {blocks.map((b) => (
      <script type="application/ld+json" set:html={JSON.stringify(b)} />
    ))}
  </head>
  <body>
    {SITE.disclosureActive && (
      <div class="disclosure">
        <div class="wrap">
          Some clinics in this directory are owned by our affiliate. Clinics we own
          are clearly labeled. See our <a href="/ownership-disclosure/">ownership disclosure</a>.
        </div>
      </div>
    )}

    <header class="site-head">
      <div class="wrap bar">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
            <circle cx="32" cy="32" r="29" fill="none" stroke="#0f2e3a" stroke-width="5"/>
            <rect x="30.2" y="13.6" width="6" height="4.8" rx="2.2" fill="#23b3a3"/><circle cx="28.8" cy="16" r="1.7" fill="#23b3a3"/><circle cx="37.6" cy="16" r="1.7" fill="#23b3a3"/>
            <rect x="27.9" y="20.6" width="7" height="4.8" rx="2.2" fill="#23b3a3"/><circle cx="26.5" cy="23" r="1.7" fill="#23b3a3"/><circle cx="36.3" cy="23" r="1.7" fill="#23b3a3"/>
            <rect x="28" y="28.1" width="8" height="4.8" rx="2.2" fill="#23b3a3"/><circle cx="26.6" cy="30.5" r="1.7" fill="#23b3a3"/><circle cx="37.4" cy="30.5" r="1.7" fill="#23b3a3"/>
            <rect x="28.9" y="36.1" width="7.5" height="4.8" rx="2.2" fill="#23b3a3"/><circle cx="27.5" cy="38.5" r="1.7" fill="#23b3a3"/><circle cx="37.8" cy="38.5" r="1.7" fill="#23b3a3"/>
            <rect x="29.8" y="44.1" width="6.5" height="4.8" rx="2.2" fill="#23b3a3"/><circle cx="28.4" cy="46.5" r="1.7" fill="#23b3a3"/><circle cx="37.6" cy="46.5" r="1.7" fill="#23b3a3"/>
            <g fill="none" stroke="#23b3a3" stroke-width="3.1" stroke-linecap="round"><path d="M19 28 A 8 8 0 0 0 19 40"/><path d="M13.5 24.5 A 13 13 0 0 0 13.5 43.5"/><path d="M45 28 A 8 8 0 0 1 45 40"/><path d="M50.5 24.5 A 13 13 0 0 1 50.5 43.5"/></g>
          </svg><span>Pain</span><span style="color:#1f9e8f">Beacon</span>
        </a>
        <nav class="nav">
          <a href="/pain-clinics/">Browse by state</a>
          <a href="/how-we-rank/">How we rank</a>
          <a href="/ownership-disclosure/">Disclosure</a>
        </nav>
      </div>
    </header>

    <div class="trust-bar">
      <div class="wrap">
        <span>Independently ranked — <a href="/how-we-rank/">no pay-to-rank</a></span>
        <span class="sep">·</span>
        <span>Built on the federal NPI registry</span>
        <span class="sep">·</span>
        <span><a href="/ownership-disclosure/">Who’s behind this</a></span>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap cols">
        <div>
          <div class="brand" style="font-size:1.2rem;margin-bottom:0.5rem;">
            <svg class="brand-mark" viewBox="0 0 64 64" width="24" height="24" aria-hidden="true">
              <circle cx="32" cy="32" r="29" fill="none" stroke="#0f2e3a" stroke-width="5"/>
              <rect x="30.2" y="13.6" width="6" height="4.8" rx="2.2" fill="#1f9e8f"/><circle cx="28.8" cy="16" r="1.7" fill="#1f9e8f"/><circle cx="37.6" cy="16" r="1.7" fill="#1f9e8f"/>
              <rect x="27.9" y="20.6" width="7" height="4.8" rx="2.2" fill="#1f9e8f"/><circle cx="26.5" cy="23" r="1.7" fill="#1f9e8f"/><circle cx="36.3" cy="23" r="1.7" fill="#1f9e8f"/>
              <rect x="28" y="28.1" width="8" height="4.8" rx="2.2" fill="#1f9e8f"/><circle cx="26.6" cy="30.5" r="1.7" fill="#1f9e8f"/><circle cx="37.4" cy="30.5" r="1.7" fill="#1f9e8f"/>
              <rect x="28.9" y="36.1" width="7.5" height="4.8" rx="2.2" fill="#1f9e8f"/><circle cx="27.5" cy="38.5" r="1.7" fill="#1f9e8f"/><circle cx="37.8" cy="38.5" r="1.7" fill="#1f9e8f"/>
              <rect x="29.8" y="44.1" width="6.5" height="4.8" rx="2.2" fill="#1f9e8f"/><circle cx="28.4" cy="46.5" r="1.7" fill="#1f9e8f"/><circle cx="37.6" cy="46.5" r="1.7" fill="#1f9e8f"/>
              <g fill="none" stroke="#1f9e8f" stroke-width="3.1" stroke-linecap="round"><path d="M19 28 A 8 8 0 0 0 19 40"/><path d="M13.5 24.5 A 13 13 0 0 0 13.5 43.5"/><path d="M45 28 A 8 8 0 0 1 45 40"/><path d="M50.5 24.5 A 13 13 0 0 1 50.5 43.5"/></g>
            </svg><span>Pain</span><span style="color:#1f9e8f">Beacon</span>
          </div>
          <p style="max-width:32rem;">{SITE.description}</p>
          {SITE.medicalReviewer.active ? (
            <p class="muted">
              Medically reviewed by {SITE.medicalReviewer.name},
              {' '}{SITE.medicalReviewer.credentials}. Last reviewed {SITE.editorial.lastReviewed}.
            </p>
          ) : (
            <p class="muted">
              Editorially maintained — last updated {SITE.editorial.lastReviewed}.
              Informational only and not a substitute for professional medical advice.
            </p>
          )}
        </div>
        <div>
          <p><strong>Directory</strong></p>
          <p><a href="/pain-clinics/">All states</a></p>
          <p><a href="/how-we-rank/">Ranking methodology</a></p>
        </div>
        <div>
          <p><strong>About</strong></p>
          <p><a href="/ownership-disclosure/">Ownership disclosure</a></p>
          <p><a href="/privacy/">Privacy</a></p>
          <p class="muted" style="margin-top:1rem;">
            Clinic data sourced from the U.S. federal NPI registry, enriched with
            public location and review information. Informational only — not medical
            advice. Always consult a licensed clinician.
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Lazy-load Leaflet (free OpenStreetMap maps) ONLY on pages that have a
      // .clinic-map container — keeps mapless pages (home, state hubs) light.
      (function () {
        var maps = document.querySelectorAll('.clinic-map');
        if (!maps.length) return;
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
        var js = document.createElement('script');
        js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        js.onload = function () {
          maps.forEach(function (el) {
            var pts;
            try { pts = JSON.parse(el.getAttribute('data-points') || '[]'); }
            catch (e) { return; }
            if (!pts.length) return;
            var map = L.map(el, { scrollWheelZoom: false });
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }).addTo(map);
            var pbIcon = L.divIcon({
              className: 'pb-pin',
              html: '<svg viewBox="0 0 48 60" width="32" height="40" xmlns="http://www.w3.org/2000/svg">'
                + '<path d="M24 59 C20 50 4 40 4 24 A20 20 0 1 1 44 24 C44 40 28 50 24 59 Z" fill="#0f2e3a"/>'
                + '<circle cx="24" cy="22" r="15" fill="#ffffff"/>'
                + '<rect x="21.8" y="10.7" width="4.5" height="3.6" rx="1.7" fill="#23b3a3"/><circle cx="20.6" cy="12.5" r="1.2" fill="#23b3a3"/><circle cx="27.4" cy="12.5" r="1.2" fill="#23b3a3"/>'
                + '<rect x="21.2" y="16.7" width="5.5" height="3.6" rx="1.7" fill="#23b3a3"/><circle cx="20.1" cy="18.5" r="1.2" fill="#23b3a3"/><circle cx="27.9" cy="18.5" r="1.2" fill="#23b3a3"/>'
                + '<rect x="21" y="22.7" width="6" height="3.6" rx="1.7" fill="#23b3a3"/><circle cx="19.9" cy="24.5" r="1.2" fill="#23b3a3"/><circle cx="28.1" cy="24.5" r="1.2" fill="#23b3a3"/>'
                + '<rect x="21.5" y="28.7" width="5" height="3.6" rx="1.7" fill="#23b3a3"/><circle cx="20.4" cy="30.5" r="1.2" fill="#23b3a3"/><circle cx="27.6" cy="30.5" r="1.2" fill="#23b3a3"/>'
                + '<g fill="none" stroke="#23b3a3" stroke-width="2" stroke-linecap="round"><path d="M14 17 A 5 5 0 0 0 14 27"/><path d="M9.5 14.5 A 8.5 8.5 0 0 0 9.5 29.5"/><path d="M34 17 A 5 5 0 0 1 34 27"/><path d="M38.5 14.5 A 8.5 8.5 0 0 1 38.5 29.5"/></g></svg>',
              iconSize: [32, 40],
              iconAnchor: [16, 40],
              popupAnchor: [0, -36],
            });
            var coords = [];
            pts.forEach(function (p) {
              var mk = L.marker([p.lat, p.lng], { icon: pbIcon }).addTo(map);
              var label = p.slug
                ? '<a href="/clinic/' + p.slug + '/"><strong>' + p.name + '</strong></a>'
                : '<strong>' + p.name + '</strong>';
              if (p.address) label += '<br>' + p.address;
              mk.bindPopup(label);
              coords.push([p.lat, p.lng]);
            });
            var z = parseInt(el.getAttribute('data-zoom'), 10);
            if (coords.length === 1) {
              map.setView(coords[0], isNaN(z) ? 14 : z);
            } else {
              map.fitBounds(coords, { padding: [30, 30], maxZoom: 14 });
            }
          });
        };
        document.body.appendChild(js);
      })();
    </script>
  </body>
</html>
