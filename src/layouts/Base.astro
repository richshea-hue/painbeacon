---
import '../styles/global.css';
import { SITE } from '../lib/site.js';
import LeadChat from '../components/LeadChat.astro';

const {
  title,
  description = SITE.description,
  canonical,
  jsonld = [],
  noindex = false,
  // Social share image. Defaults to the site card — the home screen at 1200×630
  // (see scripts/generate-social-cards.mjs), the 1.91:1 shape every link
  // preview is built around. The old default was 1200×1200, which every
  // platform then cropped to that shape, cutting the headline off.
  //
  // Pages with art of their own pass it here. Anything that is NOT 1200×630 —
  // notably the square article cards — must pass its own width and height too,
  // or it will claim a shape it does not have. The ratio also picks the X card
  // type below: wider than tall gets summary_large_image, square gets summary.
  ogImage = '/social/painbeacon-home.png',
  ogImageAlt = `${SITE.name} — ${SITE.tagline}`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const twitterCard = ogImageWidth > ogImageHeight ? 'summary_large_image' : 'summary';

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE.url).href;

/**
 * Organization, emitted on every page with a stable @id.
 *
 * The socials config already said these were "emitted as sameAs in the site's
 * Organization JSON-LD" — but no Organization block existed, so sameAs was
 * never actually published and every page asserted an unlinked publisher.
 * Other blocks can now reference `${SITE.url}/#organization` instead of
 * repeating a bare publisher name.
 *
 * Deliberately NO author/reviewer claim here: SITE.medicalReviewer.active is
 * false, and the config is explicit that a fabricated reviewer must never
 * appear on a health site. When a real clinician is retained, add
 * `reviewedBy` here and nowhere else.
 */
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: `${SITE.url}/`,
  description: SITE.description,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE.url}/brand/painbeacon-logo-horizontal-dark.svg`,
    caption: `${SITE.name} logo`,
  },
  sameAs: [SITE.socials.x, SITE.socials.facebook].filter(Boolean),
  publishingPrinciples: `${SITE.url}/how-we-rank/`,
  knowsAbout: [
    'Pain management clinics',
    'Interventional pain medicine',
    'Board-certified pain specialists',
  ],
};

const blocks = [organizationLd, ...(Array.isArray(jsonld) ? jsonld : [jsonld])].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — News & guides`} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2e3a" />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    {SITE.bingSiteVerification && (
      <meta name="msvalidate.01" content={SITE.bingSiteVerification} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Montserrat:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    {blocks.map((b) => (
      <script type="application/ld+json" set:html={JSON.stringify(b)} />
    ))}
  </head>
  <body>
    {SITE.disclosureActive && (
      <div class="disclosure">
        <div class="wrap">
          Some clinics in this directory are owned by our affiliate. Clinics we own
          are clearly labeled. See our <a href="/ownership-disclosure/">ownership disclosure</a>.
        </div>
      </div>
    )}

    <header class="site-head" id="siteHead">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="PainBeacon home">
          <img class="logo-img" src="/brand/painbeacon-logo-horizontal-dark.svg" alt="PainBeacon" width="153" height="38" />
        </a>
        <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="siteNav">
          <svg class="nav-icon-open" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
          </svg>
          <svg class="nav-icon-close" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
          </svg>
          <span>Menu</span>
        </button>
        <nav class="nav" id="siteNav">
          <a href="/pain-clinics/">Browse by state</a>
          <a href="/map/">Map</a>
          <a href="/news/">News &amp; guides</a>
          <a href="/research/">Research</a>
          <a href="/how-we-rank/">How we rank</a>
          <a href="/for-practices/">For practices</a>
          <a href="/ownership-disclosure/">Disclosure</a>
        </nav>
      </div>
    </header>

    <div class="trust-bar">
      <div class="wrap">
        <span>Independently ranked — <a href="/how-we-rank/">no pay-to-rank</a></span>
        <span class="sep">·</span>
        <span>Built on the federal NPI registry</span>
        <span class="sep">·</span>
        <span><a href="/ownership-disclosure/">Who’s behind this</a></span>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap cols">
        <div>
          <img class="logo-img" src="/brand/painbeacon-logo-horizontal-dark.svg" alt="PainBeacon" width="121" height="30" />
          <p style="max-width:32rem;">{SITE.description}</p>
          {SITE.medicalReviewer.active ? (
            <p class="muted">
              Medically reviewed by {SITE.medicalReviewer.name},
              {' '}{SITE.medicalReviewer.credentials}. Last reviewed {SITE.editorial.lastReviewed}.
            </p>
          ) : (
            <p class="muted">
              Editorially maintained — last updated {SITE.editorial.lastReviewed}.
              Informational only and not a substitute for professional medical advice.
            </p>
          )}
        </div>
        <div>
          <p><strong>Directory</strong></p>
          <p><a href="/pain-clinics/">All states</a></p>
          <p><a href="/map/">Clinic map</a></p>
          <p><a href="/news/">News &amp; guides</a></p>
          <p><a href="/research/">Research &amp; data</a></p>
          <p><a href="/how-we-rank/">Ranking methodology</a></p>
          <p><a href="/for-practices/">For practices</a></p>
        </div>
        <div>
          <p><strong>About</strong></p>
          <p><a href="/ownership-disclosure/">Ownership disclosure</a></p>
          <p><a href="/privacy/">Privacy</a></p>
          <p><a href="https://richshea.com" target="_blank" rel="noopener">Founded by Rich Shea</a></p>
          {(SITE.socials.x || SITE.socials.facebook) && (
            <p class="social-links">
              <strong>Follow</strong><br />
              {SITE.socials.x && <a href={SITE.socials.x} target="_blank" rel="noopener">X (@painbeacon)</a>}
              {SITE.socials.x && SITE.socials.facebook && <span> · </span>}
              {SITE.socials.facebook && <a href={SITE.socials.facebook} target="_blank" rel="noopener">Facebook</a>}
            </p>
          )}
          <p class="muted" style="margin-top:1rem;">
            Clinic data sourced from the U.S. federal NPI registry, enriched with
            public location and review information. Informational only — not medical
            advice. Always consult a licensed clinician.
          </p>
        </div>
      </div>
      <div class="wrap" style="margin-top:1.5rem; padding-top:1.25rem; border-top:1px solid rgba(255,255,255,.12); display:flex; flex-wrap:wrap; align-items:center; gap:1rem;">
        <a href="https://smollaunch.com" target="_blank" rel="noopener">
          <img src="https://smollaunch.com/badges/featured.svg" alt="PainBeacon — Featured on Smol Launch" loading="lazy" width="250" height="60" />
        </a>
        <a href="https://www.producthunt.com/products/painbeacon-pain-clinic-locator?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-painbeacon-pain-clinic-locator" target="_blank" rel="noopener noreferrer">
          <img src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1178688&amp;theme=light&amp;t=1782524392334" alt="PainBeacon Pain Clinic Locator - Find a qualified pain clinic near you — free US directory | Product Hunt" loading="lazy" width="250" height="54" />
        </a>
      </div>
    </footer>

    <LeadChat />

    <script is:inline>
      // Mobile nav — the six links collapse into one "Menu" button under 900px.
      (function () {
        var head = document.getElementById('siteHead');
        var btn = document.getElementById('navToggle');
        var nav = document.getElementById('siteNav');
        if (!head || !btn || !nav) return;
        function setOpen(on) {
          head.classList.toggle('nav-open', on);
          btn.setAttribute('aria-expanded', on ? 'true' : 'false');
        }
        btn.addEventListener('click', function () {
          setOpen(!head.classList.contains('nav-open'));
        });
        nav.addEventListener('click', function (e) {
          if (e.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setOpen(false);
        });
        // Tapping outside the header closes it; resizing to desktop resets it.
        document.addEventListener('click', function (e) {
          if (!head.contains(e.target)) setOpen(false);
        });
        window.addEventListener('resize', function () {
          if (window.innerWidth > 900) setOpen(false);
        });
      })();
    </script>

    <script is:inline>
      // Lazy-load Leaflet (free OpenStreetMap maps) ONLY on pages that have a
      // .clinic-map container — keeps mapless pages (home, state hubs) light.
      (function () {
        var maps = document.querySelectorAll('.clinic-map');
        if (!maps.length) return;
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
        var js = document.createElement('script');
        js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        js.onload = function () {
          maps.forEach(function (el) {
            var pts;
            try { pts = JSON.parse(el.getAttribute('data-points') || '[]'); }
            catch (e) { return; }
            if (!pts.length) return;
            var map = L.map(el, { scrollWheelZoom: false });
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }).addTo(map);
            // The pin is the brand mark itself, served as one cached file rather
            // than inlined per marker. Regenerate it from the logo with
            // scripts/build_pin_svg.mjs if the logo ever changes.
            function pbIcon(count) {
              var html = '<img src="/brand/painbeacon-pin.svg" width="38" height="43" alt="" />';
              if (count > 1) html += '<span class="pb-pin-count">' + count + '</span>';
              return L.divIcon({
                className: 'pb-pin',
                html: html,
                iconSize: [38, 43],
                iconAnchor: [19, 43], // the tip of the tail, not the middle
                popupAnchor: [0, -40],
              });
            }

            function esc(s) {
              return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
              });
            }

            function entry(p) {
              var s = p.slug
                ? '<a href="/clinic/' + encodeURIComponent(p.slug) + '/"><strong>' + esc(p.name) + '</strong></a>'
                : '<strong>' + esc(p.name) + '</strong>';
              if (p.street) s += '<br>' + esc(p.street);
              if (p.address) s += '<br>' + esc(p.address);
              return s;
            }

            // Several practices commonly share one medical building, and their
            // coordinates land on the same spot — so the pins stack and the map
            // reads as a single clinic. Group them onto one pin that carries a
            // count and lists every practice in its popup. Grouping rather than
            // scattering the pins keeps each clinic on its real coordinates.
            // 4 decimal places is about 11m: tight enough to keep neighboring
            // practices apart, loose enough to catch the slightly different
            // geocodes one building can produce.
            var groups = {};
            var order = [];
            pts.forEach(function (p) {
              var key = p.lat.toFixed(4) + ',' + p.lng.toFixed(4);
              if (!groups[key]) { groups[key] = []; order.push(key); }
              groups[key].push(p);
            });

            var coords = [];
            order.forEach(function (key) {
              var list = groups[key];
              var first = list[0];
              var mk = L.marker([first.lat, first.lng], {
                icon: pbIcon(list.length),
                title: list.length > 1 ? list.length + ' clinics at this location' : first.name,
                riseOnHover: true,
              }).addTo(map);

              var label;
              if (list.length === 1) {
                label = entry(first);
              } else {
                label = '<strong class="pb-pop-head">' + list.length + ' clinics at this location</strong>'
                  + '<ul class="pb-pop-list">'
                  + list.map(function (p) { return '<li>' + entry(p) + '</li>'; }).join('')
                  + '</ul>';
              }
              mk.bindPopup(label);
              coords.push([first.lat, first.lng]);
            });
            var z = parseInt(el.getAttribute('data-zoom'), 10);
            if (coords.length === 1) {
              map.setView(coords[0], isNaN(z) ? 14 : z);
            } else {
              map.fitBounds(coords, { padding: [30, 30], maxZoom: 14 });
            }
          });
        };
        document.body.appendChild(js);
      })();
    </script>
  </body>
</html>
