---
import '../styles/global.css';
import { SITE } from '../lib/site.js';
import LeadChat from '../components/LeadChat.astro';

const {
  title,
  description = SITE.description,
  canonical,
  jsonld = [],
  noindex = false,
  // Social share image. 1200×1200 (1:1 survives every platform uncropped).
  // Defaults to the site card; article pages pass their own generated card
  // (see scripts/generate-social-cards.mjs).
  ogImage = '/social/painbeacon-card.png',
  ogImageAlt = `${SITE.name} — ${SITE.tagline}`,
} = Astro.props;
const ogImageUrl = new URL(ogImage, SITE.url).href;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE.url).href;
const blocks = Array.isArray(jsonld) ? jsonld : [jsonld];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — News & guides`} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2e3a" />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    {SITE.bingSiteVerification && (
      <meta name="msvalidate.01" content={SITE.bingSiteVerification} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Montserrat:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    {blocks.map((b) => (
      <script type="application/ld+json" set:html={JSON.stringify(b)} />
    ))}
  </head>
  <body>
    {SITE.disclosureActive && (
      <div class="disclosure">
        <div class="wrap">
          Some clinics in this directory are owned by our affiliate. Clinics we own
          are clearly labeled. See our <a href="/ownership-disclosure/">ownership disclosure</a>.
        </div>
      </div>
    )}

    <header class="site-head">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="PainBeacon home">
          <img class="logo-img" src="/brand/painbeacon-logo-horizontal-dark.svg" alt="PainBeacon" width="153" height="38" />
        </a>
        <nav class="nav">
          <a href="/pain-clinics/">Browse by state</a>
          <a href="/news/">News &amp; guides</a>
          <a href="/how-we-rank/">How we rank</a>
          <a href="/for-practices/">For practices</a>
          <a href="/ownership-disclosure/">Disclosure</a>
        </nav>
      </div>
    </header>

    <div class="trust-bar">
      <div class="wrap">
        <span>Independently ranked — <a href="/how-we-rank/">no pay-to-rank</a></span>
        <span class="sep">·</span>
        <span>Built on the federal NPI registry</span>
        <span class="sep">·</span>
        <span><a href="/ownership-disclosure/">Who’s behind this</a></span>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap cols">
        <div>
          <img class="logo-img" src="/brand/painbeacon-logo-horizontal-dark.svg" alt="PainBeacon" width="121" height="30" />
          <p style="max-width:32rem;">{SITE.description}</p>
          {SITE.medicalReviewer.active ? (
            <p class="muted">
              Medically reviewed by {SITE.medicalReviewer.name},
              {' '}{SITE.medicalReviewer.credentials}. Last reviewed {SITE.editorial.lastReviewed}.
            </p>
          ) : (
            <p class="muted">
              Editorially maintained — last updated {SITE.editorial.lastReviewed}.
              Informational only and not a substitute for professional medical advice.
            </p>
          )}
        </div>
        <div>
          <p><strong>Directory</strong></p>
          <p><a href="/pain-clinics/">All states</a></p>
          <p><a href="/news/">News &amp; guides</a></p>
          <p><a href="/how-we-rank/">Ranking methodology</a></p>
          <p><a href="/for-practices/">For practices</a></p>
        </div>
        <div>
          <p><strong>About</strong></p>
          <p><a href="/ownership-disclosure/">Ownership disclosure</a></p>
          <p><a href="/privacy/">Privacy</a></p>
          {(SITE.socials.x || SITE.socials.facebook) && (
            <p class="social-links">
              <strong>Follow</strong><br />
              {SITE.socials.x && <a href={SITE.socials.x} target="_blank" rel="noopener">X (@painbeacon)</a>}
              {SITE.socials.x && SITE.socials.facebook && <span> · </span>}
              {SITE.socials.facebook && <a href={SITE.socials.facebook} target="_blank" rel="noopener">Facebook</a>}
            </p>
          )}
          <p class="muted" style="margin-top:1rem;">
            Clinic data sourced from the U.S. federal NPI registry, enriched with
            public location and review information. Informational only — not medical
            advice. Always consult a licensed clinician.
          </p>
        </div>
      </div>
      <div class="wrap" style="margin-top:1.5rem; padding-top:1.25rem; border-top:1px solid rgba(255,255,255,.12); display:flex; flex-wrap:wrap; align-items:center; gap:1rem;">
        <a href="https://smollaunch.com" target="_blank" rel="noopener">
          <img src="https://smollaunch.com/badges/featured.svg" alt="PainBeacon — Featured on Smol Launch" loading="lazy" width="250" height="60" />
        </a>
        <a href="https://www.producthunt.com/products/painbeacon-pain-clinic-locator?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-painbeacon-pain-clinic-locator" target="_blank" rel="noopener noreferrer">
          <img src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1178688&amp;theme=light&amp;t=1782524392334" alt="PainBeacon Pain Clinic Locator - Find a qualified pain clinic near you — free US directory | Product Hunt" loading="lazy" width="250" height="54" />
        </a>
      </div>
    </footer>

    <LeadChat />

    <script is:inline>
      // Lazy-load Leaflet (free OpenStreetMap maps) ONLY on pages that have a
      // .clinic-map container — keeps mapless pages (home, state hubs) light.
      (function () {
        var maps = document.querySelectorAll('.clinic-map');
        if (!maps.length) return;
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
        var js = document.createElement('script');
        js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        js.onload = function () {
          maps.forEach(function (el) {
            var pts;
            try { pts = JSON.parse(el.getAttribute('data-points') || '[]'); }
            catch (e) { return; }
            if (!pts.length) return;
            var map = L.map(el, { scrollWheelZoom: false });
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }).addTo(map);
            var pbIcon = L.divIcon({
              className: 'pb-pin',
              html: '<svg viewBox="0 0 56 72" width="38" height="49" xmlns="http://www.w3.org/2000/svg">'
                + '<path d="M28 71 C23 60 2 46 2 28 A26 26 0 1 1 54 28 C54 46 33 60 28 71 Z" fill="#0f2e3a"/>'
                + '<circle cx="28" cy="28" r="21" fill="#ffffff"/>'
                + '<rect x="25.5" y="13" width="5" height="4" rx="1.8" fill="#23b3a3"/><circle cx="24.2" cy="15" r="1.3" fill="#23b3a3"/><circle cx="31.8" cy="15" r="1.3" fill="#23b3a3"/>'
                + '<rect x="25" y="20" width="6" height="4" rx="1.8" fill="#23b3a3"/><circle cx="23.7" cy="22" r="1.3" fill="#23b3a3"/><circle cx="32.3" cy="22" r="1.3" fill="#23b3a3"/>'
                + '<rect x="24.75" y="27" width="6.5" height="4" rx="1.8" fill="#23b3a3"/><circle cx="23.45" cy="29" r="1.3" fill="#23b3a3"/><circle cx="32.55" cy="29" r="1.3" fill="#23b3a3"/>'
                + '<rect x="25.25" y="34" width="5.5" height="4" rx="1.8" fill="#23b3a3"/><circle cx="23.95" cy="36" r="1.3" fill="#23b3a3"/><circle cx="32.05" cy="36" r="1.3" fill="#23b3a3"/>'
                + '<g fill="none" stroke="#23b3a3" stroke-width="2.4" stroke-linecap="round"><path d="M20 23.5 A 5.5 5.5 0 0 0 20 32.5"/><path d="M16 21 A 8 8 0 0 0 16 35"/><path d="M36 23.5 A 5.5 5.5 0 0 1 36 32.5"/><path d="M40 21 A 8 8 0 0 1 40 35"/></g></svg>',
              iconSize: [38, 49],
              iconAnchor: [19, 49],
              popupAnchor: [0, -45],
            });
            var coords = [];
            pts.forEach(function (p) {
              var mk = L.marker([p.lat, p.lng], { icon: pbIcon }).addTo(map);
              var label = p.slug
                ? '<a href="/clinic/' + p.slug + '/"><strong>' + p.name + '</strong></a>'
                : '<strong>' + p.name + '</strong>';
              if (p.address) label += '<br>' + p.address;
              mk.bindPopup(label);
              coords.push([p.lat, p.lng]);
            });
            var z = parseInt(el.getAttribute('data-zoom'), 10);
            if (coords.length === 1) {
              map.setView(coords[0], isNaN(z) ? 14 : z);
            } else {
              map.fitBounds(coords, { padding: [30, 30], maxZoom: 14 });
            }
          });
        };
        document.body.appendChild(js);
      })();
    </script>
  </body>
</html>
