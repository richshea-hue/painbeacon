---
// "Claim this profile" — a practice owner/manager requests to claim and
// (optionally) pay to enrich their listing. Writes ONE row to the Supabase
// `claims` table via the PUBLIC anon key (RLS allows anon INSERT only, never
// SELECT). Same security model as LeadFinder. A claim doubles as warm Candor
// deal-flow: a verified, engaged, contactable practice.
//
// IMPORTANT: only the anon/publishable key is embedded — never the service key.
const SUPABASE_URL = process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_ANON_KEY || '';
const { npi = '', slug = '', clinicName = 'this practice' } = Astro.props;
---
<div class="claim" data-su={SUPABASE_URL} data-sk={SUPABASE_KEY}
     data-npi={npi} data-slug={slug} data-name={clinicName}>
  <p class="claim-cta">
    Work at {clinicName}? <button class="claim-open" type="button">Claim this profile to manage your listing ↗</button>
  </p>

  <div class="claim-form" hidden>
    <p class="claim-form-intro">Claim <strong>{clinicName}</strong> to verify your details and add photos,
      services, accepted insurance, and a booking link.</p>

    <div class="claim-private-note">
      <strong>The details below are private.</strong> We use them only to confirm you represent
      this practice. They are <strong>never published</strong> on the site or shared — patients
      will not see them.
    </div>
    <div class="claim-row">
      <label>Your name <span class="claim-muted">(for verification)</span>
        <input class="claim-in" data-f="contact_name" type="text" autocomplete="name" />
      </label>
      <label>Your role
        <select class="claim-in" data-f="role">
          <option value="">Select…</option>
          <option>Owner</option>
          <option>Physician / provider</option>
          <option>Office manager</option>
          <option>Marketing</option>
          <option>Other</option>
        </select>
      </label>
    </div>
    <div class="claim-row">
      <label>Your work email <span class="claim-muted">(we reply here — not shown publicly)</span>
        <input class="claim-in" data-f="work_email" type="email" autocomplete="email" placeholder="you@practice.com" />
      </label>
      <label>Your phone <span class="claim-muted">(so we can reach you — not shown publicly)</span>
        <input class="claim-in" data-f="phone" type="tel" autocomplete="tel" />
      </label>
    </div>
    <label class="claim-web">
      <span class="claim-web-head">Your website
        <span class="claim-pub-badge">shown publicly on your listing</span>
        <span class="claim-tip" tabindex="0" aria-label="How this helps you">ⓘ
          <span class="claim-tip-pop">Add your website and your verified profile shows a direct, search-engine-followed link to your site — a quality backlink that helps your own SEO. <strong>Free for verified clinics for a limited time.</strong></span>
        </span>
      </span>
      <input class="claim-in" data-f="website" type="url" inputmode="url" autocomplete="url" placeholder="https://yourclinic.com" />
    </label>
    <label>What are you interested in?
      <select class="claim-in" data-f="interest">
        <option value="Claim &amp; verify (free)">Claim &amp; verify my listing (free)</option>
        <option value="Enhanced profile">Enhanced profile — photos, services, booking link</option>
        <option value="Featured placement">Featured placement in my area</option>
        <option value="Not sure yet">Not sure yet — tell me more</option>
      </select>
    </label>
    <label>Anything else? <span class="claim-muted">(optional)</span>
      <textarea class="claim-in" data-f="message" rows="2"></textarea>
    </label>
    <input class="claim-hp" data-f="_company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="btn claim-submit" type="button">Submit claim</button>
    <p class="claim-fine">We verify that you represent this practice before any changes go live.
      Submitting doesn’t change your listing or charge you anything — it starts the conversation.</p>
  </div>

  <div class="claim-done" hidden>
    <strong>Thanks — your claim request is in.</strong>
    <p class="claim-sub">We’ll reach out to verify you represent {clinicName}, then help you
      claim and enrich your profile. Want to stand out sooner?
      <a href="/for-practices/#upgrade">See Enhanced and Featured options →</a></p>
  </div>
</div>

<style>
  .claim { margin:1.5rem 0; position:relative; }
  .claim.open { border:1px solid var(--line,#e3ddcf); border-radius:14px;
    background:var(--card,#fff); padding:1.1rem 1.2rem; }
  .claim-cta { margin:0; padding:0.75rem 1rem; background:var(--teal-wash,#eaf6f4);
    border-radius:8px; font-size:0.9rem; color:var(--ink-soft,#4c5b59); line-height:1.5; }
  .claim.open .claim-cta { display:none; }
  .claim-open { background:none; border:none; padding:0; margin:0; font:inherit; cursor:pointer;
    color:var(--teal-deep,#0a4f46); font-weight:600; text-decoration:underline; text-underline-offset:2px; }
  .claim-open:hover { text-decoration:none; }
  .claim-form-intro { margin:0 0 .9rem; font-size:.95rem; color:var(--ink,#1c2b2a); line-height:1.5; }
  .claim-private-note { font-size:.8rem; color:var(--ink-soft,#4c5b59); line-height:1.5;
    background:var(--paper,#f7f4ed); border:1px solid var(--line,#e3ddcf); border-radius:9px;
    padding:.6rem .75rem; margin-bottom:.4rem; }
  .claim-private-note strong { color:var(--ink,#1c2b2a); }
  .claim-pub-badge { font-size:.66rem; font-weight:700; text-transform:uppercase; letter-spacing:.4px;
    color:var(--teal-deep,#0a4f46); background:color-mix(in srgb, var(--teal,#0e6e62) 14%, transparent);
    padding:2px 7px; border-radius:20px; }
  .claim-sub { color:var(--ink-soft,#4c5b59); font-size:.92rem; margin:.3rem 0 0; line-height:1.45; max-width:42ch; }
  .claim-muted { color:var(--ink-faint,#7c8a87); font-weight:400; }
  .claim-form { margin-top:1.1rem; display:flex; flex-direction:column; gap:.7rem; }
  .claim-row { display:flex; gap:.7rem; flex-wrap:wrap; }
  .claim-form label { flex:1 1 200px; display:flex; flex-direction:column; gap:.25rem;
    font-size:.82rem; color:var(--ink-soft,#4c5b59); }
  .claim-in { padding:.55rem .65rem; border:1px solid var(--line,#e3ddcf); border-radius:9px;
    font-size:1rem; font-family:inherit; box-sizing:border-box;
    background:var(--paper,#f7f4ed); color:var(--ink,#1c2b2a); }
  .claim-in:focus { outline:none; border-color:var(--teal,#0e6e62);
    box-shadow:0 0 0 3px color-mix(in srgb, var(--teal,#0e6e62) 16%, transparent); }
  .claim-submit { align-self:flex-start; }
  .claim-fine { font-size:.72rem; color:var(--ink-faint,#7c8a87); margin:.2rem 0 0; line-height:1.45; }
  .claim-done strong { font-size:1.02rem; }
  .claim-web { flex:1 1 100%; border:1.5px solid var(--teal,#0e6e62); border-radius:11px;
    padding:.6rem .7rem; background:color-mix(in srgb, var(--teal,#0e6e62) 6%, var(--card,#fff)); }
  .claim-web-head { display:flex; align-items:center; gap:.35rem; font-weight:600; color:var(--teal-deep,#0a4f46); }
  .claim-web .claim-in { margin-top:.35rem; background:var(--card,#fff); }
  .claim-tip { position:relative; display:inline-flex; align-items:center; justify-content:center;
    width:16px; height:16px; border-radius:50%; font-size:.72rem; cursor:help;
    background:var(--teal,#0e6e62); color:#fff; font-style:normal; }
  .claim-tip-pop { position:absolute; left:50%; bottom:135%; transform:translateX(-50%);
    width:240px; padding:.55rem .65rem; border-radius:9px; background:var(--ink,#1c2b2a); color:#fff;
    font-size:.76rem; font-weight:400; line-height:1.45; box-shadow:0 6px 20px rgba(0,0,0,.22);
    opacity:0; visibility:hidden; transition:opacity .14s; z-index:5; }
  .claim-tip-pop strong { color:var(--teal-bright,#5fd0c2); }
  .claim-tip:hover .claim-tip-pop, .claim-tip:focus .claim-tip-pop { opacity:1; visibility:visible; }
  .claim-hp { position:absolute; left:-9999px; width:1px; height:1px; opacity:0; }
  .claim-flash { animation: claimFlash 2.4s ease-out 1; }
  @keyframes claimFlash {
    0%, 100% { box-shadow:0 0 0 0 transparent; }
    15% { box-shadow:0 0 0 4px color-mix(in srgb, var(--teal,#0e6e62) 22%, transparent); border-color:var(--teal,#0e6e62); }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.claim');
    if (!root) return;
    var SU = root.getAttribute('data-su'), SK = root.getAttribute('data-sk');
    var openBtn = root.querySelector('.claim-open');
    var form = root.querySelector('.claim-form');
    var done = root.querySelector('.claim-done');
    var cta = root.querySelector('.claim-cta');

    openBtn.addEventListener('click', function () { openForm(true); });

    function openForm(focus) {
      form.hidden = false;
      root.classList.add('open');
      if (focus) { var n = root.querySelector('[data-f="contact_name"]'); if (n) n.focus(); }
    }

    // Deep link for outreach: ?claim=1 (or #claim) auto-opens the form, scrolls
    // to it, and briefly highlights it — so a link from an email/DM lands the
    // clinic right on their claim. Any ?src=... is preserved for attribution.
    try {
      var qp = new URLSearchParams(location.search);
      if (qp.get('claim') === '1' || location.hash === '#claim') {
        openForm(false);
        root.scrollIntoView({ behavior: 'smooth', block: 'center' });
        root.classList.add('claim-flash');
        setTimeout(function () { root.classList.remove('claim-flash'); }, 2400);
      }
    } catch (e) {}

    function get(f) { var el = root.querySelector('[data-f="' + f + '"]'); return el ? el.value.trim() : ''; }
    function normWebsite(v) { if (!v) return ''; v = v.trim(); if (!/^https?:\/\//i.test(v)) v = 'https://' + v; return /\.[a-z]{2,}/i.test(v) ? v : ''; }

    root.querySelector('.claim-submit').addEventListener('click', function () {
      if (root.querySelector('.claim-hp').value) return; // honeypot: bot — drop silently
      var name = get('contact_name'), email = get('work_email');
      if (!name) { root.querySelector('[data-f="contact_name"]').focus(); return; }
      if (!email || email.indexOf('@') < 1) { root.querySelector('[data-f="work_email"]').focus(); return; }

      var payload = {
        npi: root.getAttribute('data-npi'),
        clinic_slug: root.getAttribute('data-slug'),
        clinic_name: root.getAttribute('data-name'),
        contact_name: name,
        role: get('role'),
        work_email: email,
        phone: get('phone'),
        interest: get('interest'),
        website: normWebsite(get('website')),
        message: get('message'),
        source_page: location.pathname + location.search,
        user_agent: navigator.userAgent,
      };

      if (SU && SK) {
        fetch(SU.replace(/\/$/, '') + '/rest/v1/claims', {
          method: 'POST',
          headers: { apikey: SK, Authorization: 'Bearer ' + SK,
            'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify(payload),
        }).catch(function () {}); // fire-and-forget; never block the UX
      }
      cta.hidden = true; form.hidden = true; done.hidden = false; root.classList.add('open');
    });
  })();
</script>
