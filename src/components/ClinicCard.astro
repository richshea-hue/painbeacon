---
import { isPainPrimary, titleCase } from '../lib/data.js';
import { practiceGroup } from '../lib/practice-type.js';
const { clinic, rank } = Astro.props;
const c = clinic;
const interventional = (c.all_taxonomy_codes || '').includes('208VP0014X');
// Show what the practice actually is whenever pain medicine is not its primary
// registration — even when it also claims the interventional code. 856 listed
// clinics are in exactly that position, and the old `!interventional` test hid
// the practice type for every one of them: a chiropractor or a medical-supply
// company read as an interventional pain provider and nothing else. Where pain
// medicine IS the primary registration the interventional badge already says
// it, so the extra tag would only repeat itself.
const showPracticeType = Boolean(c.primary_taxonomy_desc)
  && (!isPainPrimary(c) || !interventional);
const stars = c.aggregate_rating ? '★'.repeat(Math.round(Number(c.aggregate_rating))) : '';
---
{/* data-group lets the practice filter show and hide cards without a round
    trip, and the rank slot is always rendered — empty when the card has no
    rank — so filtering to one group can number that group 1..N in place
    without the grid column collapsing and shifting the layout. */}
<li class="clinic" data-group={practiceGroup(c)}>
  <div class="rank-badge">{rank || ''}</div>
  <div>
    <h3><a href={`/clinic/${c.slug}/`}>{titleCase(c.name)}</a>
    </h3>
    <p class="meta">
      {[c.address_1 && titleCase(c.address_1), c.cityLabel, c.state].filter(Boolean).join(', ')}
      {c.phone && <> · {c.phone}</>}
    </p>
    <div class="tags">
      {['verified', 'enhanced', 'featured'].includes(c.listing_tier) && <span class="tag verified">✓ Verified</span>}
      {interventional && <span class="tag intervention">Interventional pain</span>}
      {showPracticeType && <span class="tag">{c.primary_taxonomy_desc.split(' - ').pop()}</span>}
      {c.website && <span class="tag">Website</span>}
    </div>
  </div>
  <div class="rating">
    {c.aggregate_rating ? (
      <>
        <div class="stars" title={`${c.aggregate_rating} out of 5`}>{stars}</div>
        <div class="count">{c.review_count || 0} reviews</div>
      </>
    ) : (
      <div class="count">No rating yet</div>
    )}
  </div>
</li>
