---
// Floating "Find your pain specialist" chat launcher. Lives in the site layout
// so it appears on every page and stays fixed bottom-right while scrolling.
// It NEVER opens on its own — only when the visitor taps the launcher or any
// [data-open-leadchat] trigger.
// Writes one row to the Supabase `leads` table via the PUBLIC anon key
// (RLS = anon INSERT only). Captures location + care type for every completion,
// plus an optional phone/text and/or email opt-in (wants_contact = demand signal).
//
// Trigger it from anywhere with: <button data-open-leadchat>…</button>
const SUPABASE_URL = process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_ANON_KEY || '';
---
<div class="lc" id="pbChat" data-su={SUPABASE_URL} data-sk={SUPABASE_KEY}>
  <button class="lc-launch" id="lcLaunch" type="button" aria-label="Find a pain clinic" aria-expanded="false">
    <svg viewBox="0 0 28 28" width="24" height="24" aria-hidden="true">
      <path d="M5 4h18a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H12l-5 4v-4H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Z" fill="#fff"/>
      <circle cx="9.5" cy="11.5" r="1.4" fill="#0a4f46"/>
      <circle cx="14" cy="11.5" r="1.4" fill="#0a4f46"/>
      <circle cx="18.5" cy="11.5" r="1.4" fill="#0a4f46"/>
    </svg>
    <span class="lc-launch-text">Find a pain clinic</span>
  </button>

  <div class="lc-panel" id="lcPanel" role="dialog" aria-label="Find your pain specialist">
    <div class="lc-bar">
      <span class="lc-bar-title"><span class="lc-dot"></span> Find your pain specialist</span>
      <button class="lc-close" id="lcClose" type="button" aria-label="Close chat">&times;</button>
    </div>
    <div class="lc-body">
      <div class="lc-step" data-step="1">
        <p class="lc-bot">Hi — I can help you find a pain clinic. What city or ZIP are you near?</p>
        <input class="lc-input" id="lcLoc" type="text" placeholder="e.g. Austin or 78701" autocomplete="off" />
        <input class="lc-hp" id="lcCompany" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn lc-next" type="button">Next</button>
        <p class="lc-alt">Work at a pain clinic?
          <button class="lc-link" id="lcPracticeStart" type="button">Find or add your practice</button>
        </p>
      </div>

      <!-- Practice branch: search the directory BY CLINIC NAME, then claim the
           match — or add the practice if it isn't listed yet. -->
      <div class="lc-step" data-step="p-find" hidden>
        <p class="lc-bot">What's your practice called? I'll look it up.</p>
        <input class="lc-input" id="lcPq" type="text" placeholder="e.g. Austin Interventional Pain" autocomplete="organization" />
        <button class="btn lc-psearch" type="button">Search</button>
        <div class="lc-presults" id="lcPResults" aria-live="polite"></div>
        <p class="lc-alt">
          <button class="lc-link" id="lcAddOpen" type="button">My practice isn't listed — add it</button>
        </p>
      </div>

      <div class="lc-step" data-step="p-add" hidden>
        <p class="lc-bot">We'll add your practice — free. Just the basics:</p>
        <input class="lc-input" id="lcAddName" type="text" placeholder="Practice name" autocomplete="organization" />
        <input class="lc-input" id="lcAddCity" type="text" placeholder="City, ST" autocomplete="address-level2" />
        <input class="lc-input" id="lcAddSite" type="url" inputmode="url" placeholder="Website (optional)" autocomplete="url" />
        <input class="lc-input" id="lcAddContact" type="text" placeholder="Your name" autocomplete="name" />
        <input class="lc-input" id="lcAddEmail" type="email" placeholder="Work email" autocomplete="email" />
        <input class="lc-input" id="lcAddPhone" type="tel" placeholder="Phone (optional)" autocomplete="tel" />
        <button class="btn lc-addsend" type="button">Add my practice</button>
        <p class="lc-fine">We verify that you represent the practice before it goes live.
          Adding your practice is free and doesn't charge you anything.</p>
      </div>

      <div class="lc-step" data-step="p-done" hidden>
        <p class="lc-bot"><strong>Thanks — we've got it.</strong> We'll verify you represent the
          practice and email you when your listing is live.</p>
        <a class="btn" href="/for-practices/">See what claiming gets you</a>
      </div>

      <div class="lc-step" data-step="2" hidden>
        <p class="lc-bot">What kind of care are you looking for?</p>
        <div class="lc-options">
          <button class="lc-opt" type="button" data-care="Interventional pain (injections / nerve blocks)">Injections / nerve blocks</button>
          <button class="lc-opt" type="button" data-care="General pain management">General pain management</button>
          <button class="lc-opt" type="button" data-care="Back or spine pain">Back or spine pain</button>
          <button class="lc-opt" type="button" data-care="Nerve pain / neuropathy">Nerve pain / neuropathy</button>
          <button class="lc-opt" type="button" data-care="Not sure — show top-rated clinics">Not sure / show top-rated</button>
        </div>
      </div>

      <div class="lc-step" data-step="3" hidden>
        <p class="lc-bot">Want a top-rated clinic near you to reach out and help you book? <span class="lc-muted">(optional)</span></p>
        <input class="lc-input" id="lcName" type="text" placeholder="Your name" autocomplete="name" />
        <input class="lc-input" id="lcPhone" type="tel" placeholder="Phone or text number" autocomplete="tel" />
        <input class="lc-input" id="lcEmail" type="email" placeholder="Email" autocomplete="email" />
        <p class="lc-muted lc-tiny">Give whichever you prefer — a phone/text number, an email, or both.</p>
        <button class="btn lc-connect" type="button">Yes, connect me</button>
        <button class="btn ghost lc-skip" type="button">No thanks — just show clinics</button>
        <p class="lc-fine">By choosing “connect me,” you agree we may share your contact with a clinic to help you book.
          PainBeacon is a directory, not a medical provider; this isn’t medical advice.</p>
      </div>

      <div class="lc-step" data-step="done" hidden>
        <p class="lc-bot" id="lcDone">Thanks! Browse top-rated pain clinics near you below.</p>
        <a class="btn" id="lcBrowse" href="/pain-clinics/">Browse clinics</a>
      </div>
    </div>
  </div>
</div>

<style>
  .lc { position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 9999; }
  @media (max-width: 480px) { .lc { right: .75rem; bottom: .75rem; } }

  /* Launcher */
  .lc-launch { display: inline-flex; align-items: center; gap: .5rem; border: 0; cursor: pointer;
    background: var(--teal-deep, #0a4f46); color: #fff; font: inherit; font-weight: 600; font-size: .95rem;
    padding: .7rem 1.05rem; border-radius: 999px; box-shadow: 0 6px 20px rgba(10,79,70,.32);
    transition: transform .15s ease, box-shadow .15s ease; }
  .lc-launch:hover { transform: translateY(-1px); box-shadow: 0 9px 26px rgba(10,79,70,.4); }
  .lc-launch svg { flex-shrink: 0; }
  /* Phones: a compact bubble instead of a wide pill, so it stops sitting on
     top of body copy. The page already offers a labelled "Find a pain clinic
     for me" button inline. */
  @media (max-width: 560px) { .lc-launch-text { display: none; } .lc-launch { padding: .8rem; } }

  /* Panel — hidden until .lc-open, with a small entrance */
  .lc-panel { position: absolute; right: 0; bottom: calc(100% + .6rem);
    width: min(360px, calc(100vw - 1.6rem)); max-height: min(560px, calc(100vh - 6rem));
    overflow-y: auto; overscroll-behavior: contain;
    background: var(--card, #fff); border: 1px solid var(--line, #e3ddcf);
    border-radius: 16px; box-shadow: 0 16px 44px rgba(15,46,58,.22);
    opacity: 0; visibility: hidden; transform: translateY(10px); pointer-events: none;
    transition: opacity .18s ease, transform .18s ease, visibility .18s; }
  .lc.lc-open .lc-panel { opacity: 1; visibility: visible; transform: none; pointer-events: auto; }
  .lc.lc-open .lc-launch { display: none; }
  @media (prefers-reduced-motion: reduce) { .lc-panel { transition: none; } }

  /* Phones: pin the panel to the viewport itself so it can never hang off the
     right edge (which is what made the page scroll sideways). */
  @media (max-width: 560px) {
    .lc-panel { position: fixed; left: .6rem; right: .6rem; bottom: .6rem; top: auto;
      width: auto; max-height: min(78vh, calc(100vh - 5rem)); }
    @supports (height: 100dvh) {
      .lc-panel { max-height: min(78dvh, calc(100dvh - 5rem)); }
    }
  }

  .lc-bar { position: sticky; top: 0; display: flex; align-items: center; justify-content: space-between;
    gap: .5rem; padding: .8rem 1rem; background: var(--teal-deep, #0a4f46); color: #fff;
    border-radius: 16px 16px 0 0; }
  .lc-bar-title { display: flex; align-items: center; gap: .5rem; font-weight: 600; font-size: .95rem; }
  .lc-dot { width: .55rem; height: .55rem; border-radius: 50%; background: #57e3a0;
    box-shadow: 0 0 0 3px rgba(87,227,160,.28); }
  .lc-close { background: transparent; border: 0; color: #fff; font-size: 1.5rem; line-height: 1;
    cursor: pointer; padding: 0 .15rem; opacity: .85; }
  .lc-close:hover { opacity: 1; }

  .lc-body { padding: 1rem 1.1rem 1.15rem; }
  .lc-bot { margin: .2rem 0 .7rem; }
  .lc-muted { color: var(--ink-faint, #7c8a87); font-weight: 400; }
  .lc-tiny { font-size: .78rem; margin: .1rem 0 .2rem; }
  .lc-input { width: 100%; padding: .6rem .7rem; margin: .3rem 0; border: 1px solid var(--line, #e3ddcf);
    border-radius: 9px; font-size: 1rem; font-family: inherit; box-sizing: border-box;
    background: var(--paper, #f7f4ed); color: var(--ink, #1c2b2a); }
  .lc-input:focus { outline: none; border-color: var(--teal, #0e6e62); }
  .lc-options { display: flex; flex-direction: column; gap: .45rem; }
  .lc-opt { text-align: left; padding: .6rem .75rem; border: 1px solid var(--line, #e3ddcf);
    border-radius: 9px; background: var(--paper, #f7f4ed); cursor: pointer; font-size: .95rem;
    color: var(--ink, #1c2b2a); font-family: inherit; }
  .lc-opt:hover { border-color: var(--teal, #0e6e62); }
  .lc .btn { margin-top: .5rem; }
  .lc .btn.ghost { margin-left: .4rem; }
  .lc-fine { font-size: .72rem; color: var(--ink-faint, #7c8a87); margin-top: .7rem; line-height: 1.4; }
  /* Honeypot — visually hidden without pushing layout off-canvas. */
  .lc-hp { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    border: 0; overflow: hidden; clip-path: inset(50%); opacity: 0; }

  /* Practice branch: name lookup + "not listed" fallback */
  .lc-alt { font-size: .8rem; color: var(--ink-faint, #7c8a87); margin: .8rem 0 0; line-height: 1.45;
    border-top: 1px solid var(--line, #e3ddcf); padding-top: .6rem; }
  .lc-link { background: none; border: 0; padding: 0; font: inherit; cursor: pointer;
    color: var(--teal-deep, #0a4f46); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .lc-link:hover { text-decoration: none; }
  .lc-presults { display: flex; flex-direction: column; gap: .4rem; margin-top: .7rem; }
  .lc-result { display: block; padding: .55rem .7rem; border: 1px solid var(--line, #e3ddcf);
    border-radius: 9px; background: var(--paper, #f7f4ed); font-size: .92rem;
    color: var(--ink, #1c2b2a); text-decoration: none; }
  .lc-result:hover { border-color: var(--teal, #0e6e62); text-decoration: none; }
  .lc-result .lc-where { display: block; font-size: .78rem; color: var(--ink-faint, #7c8a87); }
  .lc-note { font-size: .84rem; color: var(--ink-faint, #7c8a87); margin: .7rem 0 0; }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById('pbChat');
    if (!root) return;
    var SU = root.getAttribute('data-su'), SK = root.getAttribute('data-sk');
    var data = { zip_or_city: '', care_type: '', name: '', phone: '', email: '', contact: '', wants_contact: false };

    // When the visitor enters a ZIP, resolve it to the zone page that covers it
    // (via the build-time /zip3-zones.json) so "just show clinics" and the final
    // Browse button land them on clinics near that ZIP — not the whole state.
    var zonePromise = Promise.resolve(null);   // resolves to a zone URL or null
    function zip3(raw) {
      var d = (raw == null ? '' : String(raw)).replace(/\D/g, '');
      if (d.length === 4 || d.length === 8) d = '0' + d;
      return d.slice(0, 3);
    }
    var _zoneMap = null;
    function loadZoneMap() {
      if (_zoneMap) return Promise.resolve(_zoneMap);
      return fetch('/zip3-zones.json')
        .then(function (r) { return r.ok ? r.json() : {}; })
        .then(function (m) { return (_zoneMap = m); })
        .catch(function () { return (_zoneMap = {}); });
    }
    function resolveZone(raw) {
      var d = (raw || '').replace(/\D/g, '');
      if (d.length < 5) return Promise.resolve(null);   // not a full ZIP (e.g. a city name)
      return loadZoneMap().then(function (m) {
        var seg = m[zip3(raw)];
        return seg ? '/pain-clinics/' + seg + '/' : null;
      });
    }

    function open() {
      root.classList.add('lc-open');
      root.querySelector('#lcLaunch').setAttribute('aria-expanded', 'true');
      // Don't autofocus on touch/small screens: it pops the keyboard and makes
      // the browser scroll the page around under the panel. Desktop focuses the
      // field but never scrolls to do it.
      var loc = root.querySelector('#lcLoc');
      var isSmall = window.matchMedia('(max-width: 720px), (pointer: coarse)').matches;
      if (loc && !isSmall && !root.querySelector('[data-step="1"]').hidden) {
        setTimeout(function () {
          try { loc.focus({ preventScroll: true }); } catch (e) { loc.focus(); }
        }, 60);
      }
    }
    function close() {
      root.classList.remove('lc-open');
      root.querySelector('#lcLaunch').setAttribute('aria-expanded', 'false');
    }
    function show(step) {
      root.querySelectorAll('.lc-step').forEach(function (el) {
        el.hidden = el.getAttribute('data-step') !== step;
      });
    }
    function submit() {
      if (root.querySelector('#lcCompany').value) return;      // honeypot
      if (!SU || !SK) return;                                   // no backend (preview)
      data.source_page = location.pathname;
      data.user_agent = navigator.userAgent;
      fetch(SU.replace(/\/$/, '') + '/rest/v1/leads', {
        method: 'POST',
        headers: { apikey: SK, Authorization: 'Bearer ' + SK,
          'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify(data),
      }).catch(function () {});
    }

    // Site-wide, fire-and-forget search-event logger. Defined here because this
    // widget renders on every page and already holds the Supabase anon creds,
    // so the hero search (and anything else) can log via window.pbTrack without
    // re-plumbing credentials. No-ops safely if the backend isn't configured or
    // the search_events table doesn't exist yet. keepalive lets the beacon
    // survive the immediate navigation on a ZIP redirect.
    window.pbTrack = function (event) {
      try {
        if (!SU || !SK) return;
        var payload = Object.assign(
          { path: location.pathname, user_agent: navigator.userAgent }, event || {}
        );
        fetch(SU.replace(/\/$/, '') + '/rest/v1/search_events', {
          method: 'POST', keepalive: true,
          headers: { apikey: SK, Authorization: 'Bearer ' + SK,
            'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify(payload),
        }).catch(function () {});
      } catch (e) {}
    };

    // Site-wide clinic-name lookup, exposed for the same reason as pbTrack:
    // this widget renders on every page and already holds the anon creds, which
    // are read-only on the public clinics_public view. Resolves to [] on any
    // failure (no backend, network, bad query) so every caller can fall back to
    // "not listed — add your clinic" instead of showing an error.
    function lcTitle(s) {
      return String(s || '').toLowerCase().replace(/\b\w/g, function (m) { return m.toUpperCase(); })
        .replace(/\bLlc\b/, 'LLC').replace(/\bPc\b/, 'PC').replace(/\bPa\b/, 'PA');
    }
    window.pbSearchClinics = function (raw, limit) {
      var max = limit || 6;
      // Strip anything PostgREST would read as filter syntax; keep name chars.
      var q = String(raw == null ? '' : raw).replace(/[^A-Za-z0-9 &'.-]/g, ' ').trim();
      if (!SU || !SK || q.length < 3) return Promise.resolve([]);
      var words = q.split(/\s+/).slice(0, 4);
      var like = function (w) { return 'name.ilike.*' + encodeURIComponent(w) + '*'; };
      // Every word must appear, so "austin pain" doesn't require that exact substring.
      var filter = words.length > 1
        ? 'and=(' + words.map(like).join(',') + ')'
        : 'name=ilike.*' + encodeURIComponent(words[0]) + '*';
      var url = SU.replace(/\/$/, '') + '/rest/v1/clinics_public'
        + '?select=name,city,state,slug,npi,primary_npi&order=name.asc'
        + '&limit=' + max * 4 + '&' + filter;
      return fetch(url, { headers: { apikey: SK, Authorization: 'Bearer ' + SK } })
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (rows) {
          var seen = {}, out = [];
          (rows || []).forEach(function (c) {
            // Primaries only — folded duplicates would show the same practice twice.
            if (c.primary_npi != null && c.primary_npi !== c.npi) return;
            if (!c.slug || !c.city || !c.state || seen[c.slug]) return;
            seen[c.slug] = 1;
            out.push({ name: lcTitle(c.name), city: lcTitle(c.city), state: c.state,
                       slug: c.slug, href: '/clinic/' + c.slug + '/' });
          });
          return out.slice(0, max);
        })
        .catch(function () { return []; });
    };

    // Launcher + close + Esc + external triggers
    root.querySelector('#lcLaunch').addEventListener('click', open);
    root.querySelector('#lcClose').addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    // data-open-leadchat opens the patient flow; ="practice" jumps straight to
    // the clinic-name lookup for practice owners/managers.
    document.querySelectorAll('[data-open-leadchat]').forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.preventDefault();
        open();
        if (b.getAttribute('data-open-leadchat') === 'practice') openPractice();
      });
    });

    // Flow
    root.querySelector('.lc-next').addEventListener('click', function () {
      var v = root.querySelector('#lcLoc').value.trim();
      if (!v) { root.querySelector('#lcLoc').focus(); return; }
      data.zip_or_city = v;
      // Kick off the ZIP->zone lookup now so it's ready by the time they finish.
      zonePromise = resolveZone(v);
      var isZip = v.replace(/\D/g, '').length >= 5 && /^[\d\s-]+$/.test(v);
      zonePromise.then(function (href) {
        if (href) root.querySelector('#lcBrowse').setAttribute('href', href);
        window.pbTrack({
          source: 'chatbot', query: v, kind: isZip ? 'zip' : 'city',
          zip3: isZip ? zip3(v) : null, matched: !!href,
          zone: href ? href.replace(/^\/pain-clinics\/|\/$/g, '') : null,
        });
      });
      show('2');
    });
    root.querySelectorAll('.lc-opt').forEach(function (b) {
      b.addEventListener('click', function () { data.care_type = b.getAttribute('data-care'); show('3'); });
    });
    root.querySelector('.lc-connect').addEventListener('click', function () {
      var phone = root.querySelector('#lcPhone').value.trim();
      var email = root.querySelector('#lcEmail').value.trim();
      if (!phone && !email) { root.querySelector('#lcPhone').focus(); return; }
      data.name = root.querySelector('#lcName').value.trim();
      data.phone = phone; data.email = email;
      data.contact = [phone, email].filter(Boolean).join(' / ');
      data.wants_contact = true;
      submit();
      root.querySelector('#lcDone').textContent =
        "Thanks! A top-rated clinic near you may reach out. Meanwhile, browse clinics below.";
      show('done');
    });
    root.querySelector('.lc-skip').addEventListener('click', function () {
      data.wants_contact = false; submit();
      // "Just show clinics" — if they gave a ZIP, go straight to that zone;
      // otherwise fall back to the browse/done screen.
      zonePromise.then(function (href) {
        if (href) { window.location.href = href; } else { show('done'); }
      });
    });

    // ---- Practice branch: clinic-name search -> claim, or add if missing ----
    var pq = root.querySelector('#lcPq');
    var presults = root.querySelector('#lcPResults');
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (ch) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
      });
    }
    // 90ms > open()'s own 60ms focus timer, so the practice input wins the focus
    // when a [data-open-leadchat="practice"] trigger opens the panel.
    function openPractice() { show('p-find'); setTimeout(function () { pq.focus(); }, 90); }
    function openAdd(prefill) {
      root.querySelector('#lcAddName').value = prefill || '';
      show('p-add');
      setTimeout(function () {
        root.querySelector('#lcAdd' + (prefill ? 'City' : 'Name')).focus();
      }, 60);
    }
    root.querySelector('#lcPracticeStart').addEventListener('click', openPractice);
    root.querySelector('#lcAddOpen').addEventListener('click', function () {
      openAdd(pq.value.trim());
    });

    function runPracticeSearch() {
      var v = pq.value.trim();
      if (v.length < 3) { pq.focus(); return; }
      presults.innerHTML = '<p class="lc-note">Searching the directory…</p>';
      window.pbSearchClinics(v).then(function (list) {
        window.pbTrack({ source: 'chatbot_practice', query: v, kind: 'clinic',
                         zip3: null, matched: list.length > 0, zone: null });
        if (!list.length) {
          presults.innerHTML = '<p class="lc-note">No match for “' + esc(v) +
            '” yet — add it below and we\'ll build your listing.</p>';
          return;
        }
        // Claiming happens on the clinic's own page; ?claim=1 opens that form.
        presults.innerHTML = '<p class="lc-note">Found these — pick yours to claim it:</p>' +
          list.map(function (c) {
            return '<a class="lc-result" href="' + esc(c.href) + '?claim=1&src=chat">' +
              esc(c.name) + '<span class="lc-where">' + esc(c.city) + ', ' + esc(c.state) +
              ' · Claim this profile →</span></a>';
          }).join('');
      });
    }
    root.querySelector('.lc-psearch').addEventListener('click', runPracticeSearch);
    pq.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); runPracticeSearch(); }
    });

    // "Add my practice" writes to the same `claims` table as the claim form, so
    // new practices land in the existing review queue (npi/slug are null because
    // there's no listing yet; the details go in clinic_name/message).
    root.querySelector('.lc-addsend').addEventListener('click', function () {
      if (root.querySelector('#lcCompany').value) return;             // honeypot
      var name = root.querySelector('#lcAddName').value.trim();
      var contact = root.querySelector('#lcAddContact').value.trim();
      var email = root.querySelector('#lcAddEmail').value.trim();
      if (!name) { root.querySelector('#lcAddName').focus(); return; }
      if (!contact) { root.querySelector('#lcAddContact').focus(); return; }
      if (!email || email.indexOf('@') < 1) { root.querySelector('#lcAddEmail').focus(); return; }
      var site = root.querySelector('#lcAddSite').value.trim();
      if (site && !/^https?:\/\//i.test(site)) site = 'https://' + site;
      var city = root.querySelector('#lcAddCity').value.trim();
      if (SU && SK) {
        fetch(SU.replace(/\/$/, '') + '/rest/v1/claims', {
          method: 'POST',
          headers: { apikey: SK, Authorization: 'Bearer ' + SK,
            'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({
            npi: null, clinic_slug: null, clinic_name: name,
            contact_name: contact, role: '', work_email: email,
            phone: root.querySelector('#lcAddPhone').value.trim(),
            interest: 'Add my clinic (not listed)',
            website: /\.[a-z]{2,}/i.test(site) ? site : '',
            message: 'NEW LISTING REQUEST (chat)\nPractice: ' + name +
              '\nCity/State: ' + (city || '—') +
              '\nSearched for: ' + (pq.value.trim() || '—'),
            source_page: location.pathname, user_agent: navigator.userAgent,
          }),
        }).catch(function () {});
      }
      show('p-done');
    });
  })();
</script>
