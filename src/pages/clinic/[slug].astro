---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ClinicMap from '../../components/ClinicMap.astro';
import ClaimProfile from '../../components/ClaimProfile.astro';
import SponsorCard from '../../components/SponsorCard.astro';
import { getClinics, titleCase, stateName } from '../../lib/data.js';
import { scoreClinic, scoreBand } from '../../lib/ranking.js';
import { breadcrumbLd, clinicLd, faqLd } from '../../lib/schema.js';
import { SITE } from '../../lib/site.js';

export async function getStaticPaths() {
  const clinics = await getClinics();
  // Build a lookup by NPI once, so every page can resolve its primary's slug
  // (for folded duplicates) without re-scanning the full list per page.
  const byNpi = new Map(clinics.map((c) => [c.npi, c]));
  return clinics.map((c) => ({ params: { slug: c.slug }, props: { clinic: c, byNpi } }));
}

const { clinic: c, byNpi } = Astro.props;
const name = titleCase(c.name);
const interventional = (c.all_taxonomy_codes || '').includes('208VP0014X');
const { score } = scoreClinic(c);
const band = scoreBand(score);
const scoreDetail = band.showNumber ? `${score}/100` : 'limited verified data on file';
const addr = [c.address_1 && titleCase(c.address_1), c.address_2 && titleCase(c.address_2)].filter(Boolean).join(', ');
const yearsInPractice = c.enumeration_date
  ? Math.floor((Date.now() - new Date(c.enumeration_date).getTime()) / 3.15576e10) : null;

// Folded duplicates (matched via phone+ZIP dedup) get their canonical tag
// pointed at the primary listing instead of self-referencing, so search
// engines see one authoritative page per practice instead of near-duplicates.
// Falls back to self-reference if the primary record can't be found (data gap).
const primaryClinic = (c.primary_npi && c.primary_npi !== c.npi)
  ? byNpi.get(c.primary_npi)
  : null;
const canonicalUrl = primaryClinic
  ? new URL(`/clinic/${primaryClinic.slug}/`, SITE.url).href
  : undefined; // undefined = Base falls back to its own self-referencing default

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'States', href: '/pain-clinics/' },
  { name: stateName(c.state), href: `/pain-clinics/${c.stateSlug}/` },
  ...(c.zoneUrlSlug ? [{ name: c.zoneLabel, href: `/pain-clinics/${c.stateSlug}/${c.zoneUrlSlug}/` }] : []),
  { name },
];
const mapHref = c.google_maps_uri ||
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name} ${addr} ${c.cityLabel} ${c.state}`)}`;

// Single-location map pin (only when this clinic was matched and has coordinates).
const mapMarkers = (c.latitude != null && c.longitude != null)
  ? [{ lat: c.latitude, lng: c.longitude, name,
       address: [addr, `${c.cityLabel}, ${c.state}`].filter(Boolean).join(', ') }]
  : [];

// Outbound clinic-website links require BOTH the site-wide switch and a clean
// build-time Safe Browsing check (some practice domains are expired/hijacked).
// Unlinked profiles show the domain as text and route users through a Google
// search instead, which Google itself screens for malware.
const googleSearchHref =
  `https://www.google.com/search?q=${encodeURIComponent(`${name} ${c.cityLabel} ${c.state} pain clinic`)}`;
let websiteHost = '';
if (c.websiteHref) {
  try {
    websiteHost = new URL(c.websiteHref).hostname.replace(/^www\./, '');
  } catch (e) { websiteHost = ''; }
}

// Listing tier: free | verified | enhanced | featured. Enhanced/Featured unlock
// the rich profile block; verified+ get the trust badge.
const tier = c.listing_tier || 'free';
const isVerified = ['verified', 'enhanced', 'featured'].includes(tier);
const isEnhanced = ['enhanced', 'featured'].includes(tier);

// The followed website link — the claim perk. Verified tier + clean Safe
// Browsing result, or nothing.
const linkableWebsite =
  (SITE.linkClinicWebsites && isVerified && c.websiteSafe === true && c.websiteHref) || '';

// Embed-badge page link, pre-filled so the clinic lands on their own snippet.
const badgeHref = `/verified-badge/?slug=${encodeURIComponent(c.slug)}&name=${encodeURIComponent(name)}`;

// Self-reported (from the clinic's own claim form) always wins over the
// CMS federal-enrollment match, since the clinic knows its own billing
// better than an NPI lookup can. null = unknown either way.
const acceptsMedicare = c.accepts_medicare_self_reported != null
  ? c.accepts_medicare_self_reported
  : (c.accepts_medicare_cms === true ? true : null);
const toList = (s) => Array.isArray(s)
  ? s.filter(Boolean)
  : (s ? String(s).split(/[;,]/).map((x) => x.trim()).filter(Boolean) : []);
const svc = toList(c.services);
const cond = toList(c.conditions_treated);
const proc = toList(c.procedures_offered);
const ins = toList(c.accepted_insurance);
const photos = Array.isArray(c.enhanced_photos) ? c.enhanced_photos.filter(Boolean) : [];
const providers = Array.isArray(c.enhanced_providers) ? c.enhanced_providers : [];

// FAQ block. Built ONLY from fields we actually hold, so every answer is true
// and varies per clinic (name/address/phone/taxonomy/tenure) rather than being
// byte-identical across pages. Richer Q&As (telehealth, insurance, booking)
// switch on automatically the moment those fields exist on a record — e.g. the
// telehealth question stays hidden until a `telehealth` column ships.
const faqs = [];
const fullAddr = [addr, `${c.cityLabel}, ${c.state} ${(c.postal_code || '').slice(0, 5)}`.trim()]
  .filter(Boolean).join(', ');

faqs.push({
  q: `Where is ${name} located?`,
  a: `${name} is a pain medicine clinic located at ${fullAddr}.` +
     (c.phone ? ` You can reach the office at ${c.phone}.` : ''),
});

faqs.push({
  q: `Does ${name} offer interventional pain management?`,
  a: interventional
    ? `Yes — ${name} is registered under the Interventional Pain Medicine specialty in the federal NPI registry, which covers procedures such as injections, nerve blocks, and other image-guided pain treatments. Confirm the specific procedures offered directly with the clinic.`
    : `${name} is registered under the Pain Medicine specialty in the federal NPI registry. Contact the clinic directly to confirm whether it offers interventional procedures such as injections or nerve blocks.`,
});

if (yearsInPractice !== null) {
  faqs.push({
    q: `How long has ${name} been an established pain practice?`,
    a: `${name} has held a federal NPI as a pain medicine provider for about ${yearsInPractice} year${yearsInPractice === 1 ? '' : 's'}` +
       (c.enumeration_date ? ` (registered ${new Date(c.enumeration_date).getFullYear()}).` : '.'),
  });
}

faqs.push({
  q: `How do I book an appointment with ${name}?`,
  a: (isEnhanced && c.booking_url)
    ? `You can request an appointment with ${name} using the booking link on this page, or call ${c.phone || 'the clinic'} directly. Ask whether the clinic is currently accepting new patients.`
    : (c.phone
        ? `Call ${name} at ${c.phone} to request an appointment and to confirm whether it is currently accepting new patients.`
        : `Contact ${name} directly to request an appointment and to confirm whether it is currently accepting new patients.`),
});

// Lights up only once a telehealth flag exists on the record.
if (c.telehealth != null) {
  faqs.push({
    q: `Does ${name} offer telehealth or virtual visits?`,
    a: c.telehealth
      ? `Yes — ${name} offers telehealth or virtual appointments. Confirm which visit types are available when you book.`
      : `Based on the information on file, ${name} does not currently list telehealth or virtual visits, so appointments appear to be in person. Contact the clinic to confirm.`,
  });
}

// Lights up only once we have a Medicare signal (self-reported or CMS match).
if (acceptsMedicare != null) {
  faqs.push({
    q: `Does ${name} accept Medicare?`,
    a: acceptsMedicare
      ? `Yes — ${name} is listed as an enrolled Medicare provider${c.accepts_medicare_self_reported === true ? ', confirmed directly by the clinic' : ' in the federal CMS provider enrollment database'}. Confirm your specific plan and coverage details before scheduling.`
      : `Based on the information on file, ${name} does not currently show as accepting Medicare. Contact the clinic directly to confirm.`,
  });
}

if (ins.length > 0) {
  faqs.push({
    q: `What insurance does ${name} accept?`,
    a: `${name} lists the following accepted insurance: ${ins.join(', ')}. Verify your specific plan with the clinic before scheduling.`,
  });
}
---
<Base title={`${name} — ${c.cityLabel}, ${c.state}`}
      description={`${name} is a pain medicine clinic in ${c.cityLabel}, ${c.state}. Location, contact, credentials, and verified reviews.`}
      canonical={canonicalUrl}
      jsonld={[breadcrumbLd(crumbs), clinicLd(c, canonicalUrl), ...(faqs.length ? [faqLd(faqs)] : [])]}>
  <div class="wrap narrow">
    <Breadcrumbs items={crumbs} />

    <div class="profile-head">
      <div>
        <p class="eyebrow">{c.primary_taxonomy_desc || 'Pain Medicine'}</p>
        <h1 style="margin-bottom:0.25rem;">{name}</h1>
        {isVerified && (
          <p class="badges">
            <span class="badge-verified">✓ Verified</span>
            {tier === 'featured' && <span class="badge-featured">Featured</span>}
          </p>
        )}
        <p class="nap">
          <strong>{addr || 'Address on file'}</strong><br />
          {c.cityLabel}, {c.state} {(c.postal_code || '').slice(0, 5)}<br />
          {c.phone && <>{c.phone}<br /></>}
          {websiteHost && (linkableWebsite
            ? <a class="verified-site" href={linkableWebsite} rel="noopener" target="_blank">{websiteHost} ↗</a>
            : <span class="muted" style="font-size:0.9rem;">{websiteHost}</span>)}
        </p>
      </div>
      <div class="rating">
        {c.aggregate_rating ? (
          <>
            <div class="stars" style="font-size:1.3rem;">{'★'.repeat(Math.round(Number(c.aggregate_rating)))}</div>
            <div class="count">{c.aggregate_rating} · {c.review_count || 0} reviews</div>
          </>
        ) : <div class="count">No reviews yet</div>}
      </div>
    </div>

    <div style="display:flex;gap:0.6rem;margin:1.5rem 0;flex-wrap:wrap;">
      {isEnhanced && c.booking_url && (
        <a class="btn" href={c.booking_url} rel="noopener" target="_blank">Book / Contact</a>
      )}
      {linkableWebsite && (
        <a class="btn" href={linkableWebsite} rel="noopener" target="_blank">Visit website</a>
      )}
      <a class="btn ghost" href={mapHref} rel="nofollow noopener" target="_blank">Get directions</a>
      {c.phone && <a class="btn ghost" href={`tel:${c.phone.replace(/[^0-9+]/g, '')}`}>Call</a>}
      <a class="btn ghost" href={googleSearchHref} rel="nofollow noopener" target="_blank">Find on Google</a>
    </div>
    {linkableWebsite && (
      <p class="site-perk">✓ Verified website link · <span>free for verified clinics, limited time</span></p>
    )}

    {isEnhanced && (
      <section class="enhanced">
        <p class="enhanced-label">Verified practice profile</p>
        {c.enhanced_description && <p class="enhanced-desc">{c.enhanced_description}</p>}
        {photos.length > 0 && (
          <div class="gallery">
            {photos.map((src) => <img src={src} alt={`${name} photo`} loading="lazy" />)}
          </div>
        )}
        {(svc.length || cond.length || proc.length || ins.length) > 0 && (
          <div class="enh-grid">
            {svc.length > 0 && <div><h3>Services</h3><ul class="chips">{svc.map((x) => <li>{x}</li>)}</ul></div>}
            {cond.length > 0 && <div><h3>Conditions treated</h3><ul class="chips">{cond.map((x) => <li>{x}</li>)}</ul></div>}
            {proc.length > 0 && <div><h3>Procedures</h3><ul class="chips">{proc.map((x) => <li>{x}</li>)}</ul></div>}
            {ins.length > 0 && <div><h3>Accepted insurance</h3><ul class="chips">{ins.map((x) => <li>{x}</li>)}</ul></div>}
          </div>
        )}
        {providers.length > 0 && (
          <div class="providers">
            <h3>Providers</h3>
            {providers.map((p) => (
              <div class="provider">
                <strong>{p.name}</strong>{p.title && <span class="muted"> · {p.title}</span>}
                {p.bio && <p>{p.bio}</p>}
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    <ClinicMap markers={mapMarkers} height="320px" zoom={15} />

    <ul class="facts">
      <li><div class="k">Specialty</div><div class="v">{interventional ? 'Interventional pain' : 'Pain medicine'}</div></li>
      {yearsInPractice !== null && <li><div class="k">Years registered</div><div class="v">{yearsInPractice}</div></li>}
      <li><div class="k">Hours</div><div class="v">{c.hours
        ? c.hours.split(';')[0]
        : (c.phone
            ? <a href={`tel:${c.phone.replace(/[^0-9+]/g, '')}`}>Call to confirm</a>
            : <span class="muted">Call to confirm</span>)}</div></li>
      <li><div class="k">Qualification</div><div class="v">{band.label} <span class="score-detail">· {scoreDetail}</span></div></li>
      {acceptsMedicare != null && (
        <li><div class="k">Medicare</div><div class="v">{acceptsMedicare ? '✓ Accepted' : 'Not accepted'}</div></li>
      )}
    </ul>

    {c.hours && (
      <details style="margin:1rem 0;">
        <summary class="muted">Full hours</summary>
        <ul class="muted" style="margin-top:0.5rem;">
          {c.hours.split(';').map((h) => <li>{h.trim()}</li>)}
        </ul>
      </details>
    )}

    {faqs.length > 0 && (
      <section class="faqs">
        <h2>Frequently asked questions</h2>
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    {/* Brand sponsor bought for this clinic's STATE. After the profile and its
        FAQ, before the provenance note — it is never part of the listing. */}
    <SponsorCard placement="clinic" state={c.state} />

    <div class="notice">
      Listing built from public federal provider records (NPI registry) and enriched
      with verified location and review data. See <a href="/how-we-rank/">how we rank</a>.
      {c.nppes_last_updated && <> Provider record last updated {c.nppes_last_updated}.</>}
    </div>

    {isVerified ? (
      <p class="claimed-line">
        ✓ This profile is claimed and managed by the clinic.{' '}
        <a href={badgeHref}>Get your “Verified by PainBeacon” badge for your website →</a>{' · '}
        <a href={`mailto:contactus@painbeacon.com?subject=${encodeURIComponent('Update listing: ' + name)}&body=${encodeURIComponent('Clinic: ' + name + '\nNPI: ' + c.npi + '\n\nPlease describe the changes you would like to make to this listing:\n')}`}>Request an update to this listing ↗</a>
      </p>
    ) : (
      <ClaimProfile npi={c.npi} slug={c.slug} clinicName={name} />
    )}

    <p class="muted">
      Informational only and not medical advice. Confirm credentials, services, and
      insurance directly with the clinic before scheduling.
    </p>
  </div>
</Base>

<style>
  .verified-site { color:var(--teal-deep,#0a4f46); font-size:0.9rem; font-weight:600; text-decoration:none; }
  .claimed-line { margin-top:1.25rem; padding:0.75rem 1rem; background:var(--teal-wash,#eaf6f4); border-radius:8px; font-size:0.9rem; color:var(--teal-deep,#0a4f46); }
  .claimed-line a { color:var(--teal-deep,#0a4f46); font-weight:600; }
  .verified-site:hover { text-decoration:underline; }
  .site-perk { margin:-0.6rem 0 1rem; font-size:0.8rem; font-weight:600; color:var(--teal-deep,#0a4f46); }
  .site-perk span { font-weight:400; color:var(--ink-faint,#7c8a87); }
  .faqs { margin:2rem 0 1rem; }
  .faqs h2 { font-size:1.15rem; margin-bottom:0.75rem; }
  .faq { border:1px solid var(--rule,#e4e9e8); border-radius:8px; padding:0.75rem 1rem; margin-bottom:0.5rem; }
  .faq summary { cursor:pointer; font-weight:600; color:var(--navy,#0f2e3a); list-style:none; }
  .faq summary::-webkit-details-marker { display:none; }
  .faq summary::after { content:'+'; float:right; color:var(--teal,#23b3a3); font-weight:700; }
  .faq[open] summary::after { content:'–'; }
  .faq p { margin:0.6rem 0 0; color:var(--ink,#2a3b39); font-size:0.95rem; line-height:1.55; }
  .score-detail { font-size:0.82rem; font-weight:400; color:var(--ink-faint,#7c8a87); }
</style>
