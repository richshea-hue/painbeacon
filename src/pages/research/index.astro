---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../../lib/schema.js';
import { getDesertStats } from '../../lib/deserts.js';

const S = await getDesertStats();
const fmt = (n) => n.toLocaleString('en-US');
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Research', href: '/research/' }];

// One entry for now, but kept as a list so a second study is a push rather than
// a rewrite — and so the markup matches /news, which already reads as a feed.
const studies = [
  {
    href: '/research/pain-care-deserts/',
    title: 'Pain care deserts: U.S. counties with no pain management clinic',
    dek:
      `${fmt(S.desertCount)} of ${fmt(S.totalCounties)} U.S. counties (${S.desertPct}%) have no ` +
      `pain management clinic. County-by-county analysis of where ${S.desertPopPct}% of Americans ` +
      `live without a local pain management option — with the full dataset as CSV.`,
    updated: S.generatedAt,
    thumb: '/social/pain-care-deserts-thumb.png',
    thumbAlt:
      `Map of the United States with the ${fmt(S.desertCount)} counties that have no pain ` +
      `management clinic highlighted in teal — most of the map, densest across the rural West, ` +
      `Great Plains, Appalachia and the South.`,
  },
];
---

<Base
  title="Research & data studies"
  description="Original data studies on pain management access in the United States, built from the federal NPI registry. Free to cite with attribution."
  jsonld={breadcrumbLd(crumbs)}
>
  <div class="wrap narrow">
    <Breadcrumbs items={crumbs} />
    <h1>Research &amp; data studies</h1>
    <p class="lede">
      Original analyses of pain management access in the United States, built from the
      federal NPI registry and U.S. Census data. All statistics are free to cite with
      attribution, and every study includes a downloadable dataset.
    </p>

    <ol class="article-feed">
      {studies.map((s) => (
        <li>
          <a class="article-card" href={s.href}>
            <div class="article-card-body">
              <p class="article-kicker">
                Data study · <time datetime={s.updated}>Updated {s.updated}</time>
              </p>
              <h2>{s.title}</h2>
              <p class="article-dek">{s.dek}</p>
              <span class="article-more">Read the study →</span>
            </div>
            <img class="article-thumb" src={s.thumb} alt={s.thumbAlt}
              width="180" height="180" loading="lazy" />
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
