---
// PainBeacon internal dashboard — now gated by a real Supabase login.
// Drop this in at src/pages/dashboard.astro (replaces the old anon-key page).
//
// The anon key is still embedded as the Supabase `apikey` (it's meant to be
// public). Security now comes from RLS + is_admin(): claim PII, leads, and all
// writes are only available once you're logged in as an allowlisted admin.
//
// Recommended: keep Cloudflare Access on /dashboard as the edge gate, and use
// this login as the data-layer gate. You'll log in twice; that's the strongest
// posture and lets the page hold things like a deploy hook safely.
const SUPABASE_URL = process.env.SUPABASE_URL || '';
const SUPABASE_ANON_KEY = process.env.SUPABASE_ANON_KEY || '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>PainBeacon · Admin</title>
  <style>
    :root {
      --bg: #0e1113;
      --panel: #161a1d;
      --panel-2: #1d2226;
      --line: #2a3137;
      --ink: #e8edf0;
      --muted: #8b97a0;
      --teal: #2dd4bf;
      --amber: #f5b94a;
      --red: #f0726a;
      --green: #4ec98a;
      --radius: 12px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--bg); color: var(--ink); }
    body {
      font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      padding: 0 0 64px;
    }
    a { color: var(--teal); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .wrap { max-width: 980px; margin: 0 auto; padding: 0 18px; }

    /* Header */
    header {
      position: sticky; top: 0; z-index: 5;
      background: rgba(14,17,19,.85); backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line);
    }
    header .wrap { display: flex; align-items: center; gap: 12px; height: 58px; }
    .brand { font-weight: 700; letter-spacing: .2px; display: flex; align-items: center; gap: 8px; }
    .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 12px var(--teal); }
    .brand small { color: var(--muted); font-weight: 500; letter-spacing: .5px; text-transform: uppercase; font-size: 11px; }
    .spacer { flex: 1; }
    .who { color: var(--muted); font-size: 13px; }

    /* Buttons */
    .btn {
      appearance: none; border: 1px solid var(--line); background: var(--panel-2);
      color: var(--ink); padding: 8px 14px; border-radius: 9px; cursor: pointer;
      font-size: 14px; font-weight: 600; transition: border-color .15s, background .15s;
    }
    .btn:hover { border-color: var(--teal); }
    .btn.primary { background: var(--teal); color: #04201c; border-color: var(--teal); }
    .btn.ghost { background: transparent; }
    .btn:disabled { opacity: .5; cursor: default; }

    /* Login */
    .login { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
    .login-card {
      width: 100%; max-width: 360px; background: var(--panel); border: 1px solid var(--line);
      border-radius: 16px; padding: 28px;
    }
    .login-card h1 { font-size: 20px; margin: 0 0 4px; }
    .login-card p { color: var(--muted); margin: 0 0 20px; font-size: 14px; }
    .field { display: block; margin-bottom: 14px; }
    .field span { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .5px; }
    .field input {
      width: 100%; background: var(--bg); border: 1px solid var(--line); color: var(--ink);
      border-radius: 9px; padding: 11px 12px; font-size: 15px;
    }
    .field input:focus { outline: none; border-color: var(--teal); }
    .login .btn { width: 100%; padding: 12px; }
    .err { color: var(--red); font-size: 13px; margin-top: 12px; min-height: 18px; }

    /* Sections */
    section { margin-top: 28px; }
    .sec-head { display: flex; align-items: baseline; gap: 10px; margin: 0 0 12px; }
    .sec-head h2 { font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin: 0; font-weight: 700; }
    .pill { font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 999px; background: var(--panel-2); color: var(--muted); }
    .pill.hot { background: rgba(245,185,74,.16); color: var(--amber); }

    /* Stat cards */
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
    .card .n { font-size: 26px; font-weight: 700; line-height: 1; }
    .card .l { color: var(--muted); font-size: 13px; margin-top: 6px; }

    /* Lists */
    .list { display: flex; flex-direction: column; gap: 10px; }
    .item {
      background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 14px 16px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
    }
    .item.new { border-color: rgba(245,185,74,.4); }
    .item.resolved { opacity: .5; }
    .item.resolved.new { border-color: var(--border); }
    .item .main { flex: 1 1 240px; min-width: 0; }
    .item .name { font-weight: 700; }
    .item .meta { color: var(--muted); font-size: 13px; margin-top: 3px; word-break: break-word; }
    .item .meta a { color: var(--teal); }
    .tag { display: inline-block; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: var(--panel-2); color: var(--muted); margin-right: 6px; text-transform: uppercase; letter-spacing: .4px; }
    .claim-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .btn-approve { background:var(--teal,#0e6e62); color:#fff; border:0; border-radius:7px; padding:7px 12px; font-size:13px; font-weight:600; cursor:pointer; }
    .btn-approve:hover { filter:brightness(1.08); }  .btn-approve:disabled { opacity:.6; cursor:default; }
    .btn-reject { background:transparent; color:#c2603f; border:1px solid #c2603f55; border-radius:7px; padding:7px 12px; font-size:13px; font-weight:600; cursor:pointer; }
    .btn-reject:hover { background:#c2603f12; }
    .decided { font-size:12px; font-weight:600; color:var(--teal,#0e6e62); }
    .tag.featured { background: rgba(245,185,74,.18); color: var(--amber); }
    .tag.enhanced { background: rgba(45,212,191,.16); color: var(--teal); }
    .tag.verified { background: rgba(78,201,138,.16); color: var(--green); }
    select.ctl {
      background: var(--bg); border: 1px solid var(--line); color: var(--ink);
      border-radius: 8px; padding: 8px 10px; font-size: 14px; font-weight: 600;
    }
    select.ctl:focus { outline: none; border-color: var(--teal); }
    .saved { font-size: 12px; color: var(--green); opacity: 0; transition: opacity .2s; }
    .saved.show { opacity: 1; }

    .empty { color: var(--muted); font-size: 14px; padding: 18px; text-align: center; border: 1px dashed var(--line); border-radius: var(--radius); }

    /* Rebuild banner */
    .banner {
      position: sticky; bottom: 0; margin-top: 28px;
      background: rgba(245,185,74,.12); border: 1px solid rgba(245,185,74,.4);
      color: var(--amber); border-radius: var(--radius); padding: 14px 16px;
      display: none; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .banner.show { display: flex; }
    .banner .txt { flex: 1 1 280px; font-size: 14px; }
    .banner .txt b { color: var(--ink); }

    .loading { padding: 60px 0; text-align: center; color: var(--muted); }
    .hidden { display: none !important; }
  </style>
</head>
<body data-su={SUPABASE_URL} data-sk={SUPABASE_ANON_KEY}>

  <!-- LOGIN -->
  <div id="login" class="login hidden">
    <div class="login-card">
      <h1>PainBeacon Admin</h1>
      <p>Sign in to manage claims and listings.</p>
      <label class="field"><span>Email</span><input id="email" type="email" autocomplete="username" /></label>
      <label class="field"><span>Password</span><input id="password" type="password" autocomplete="current-password" /></label>
      <button id="signin" class="btn primary">Sign in</button>
      <div id="loginErr" class="err"></div>
    </div>
  </div>

  <!-- APP -->
  <div id="app" class="hidden">
    <header>
      <div class="wrap">
        <div class="brand"><span class="dot"></span> PainBeacon <small>Admin</small></div>
        <div class="spacer"></div>
        <span id="who" class="who"></span>
        <button id="signout" class="btn ghost">Sign out</button>
      </div>
    </header>

    <main class="wrap">
      <div id="loading" class="loading">Loading…</div>

      <div id="content" class="hidden">
        <section>
          <div class="sec-head"><h2>Overview</h2></div>
          <div id="cards" class="cards"></div>
        </section>

        <section>
          <div class="sec-head"><h2>Claim requests</h2><span id="claimsPill" class="pill">0</span></div>
          <div id="claims" class="list"></div>
        </section>

        <section>
          <div class="sec-head"><h2>Paid &amp; featured listings</h2><span id="paidPill" class="pill">0</span></div>
          <div id="paid" class="list"></div>
        </section>

        <section>
          <div class="sec-head"><h2>Recent leads</h2><span id="leadsPill" class="pill">0</span></div>
          <div id="leads" class="list"></div>
        </section>
      </div>
    </main>

    <div id="banner" class="banner">
      <div class="txt"><b>Listing changes saved.</b> They won't appear on the live site until you rebuild (the site is static).</div>
      <button id="rebuildBtn" class="btn primary hidden">Rebuild site</button>
      <span id="rebuildHint" class="who">Cloudflare Pages → Deployments → Retry latest</span>
    </div>
  </div>

  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';

    // OPTIONAL: paste a Cloudflare Pages "Deploy hook" URL here to enable the
    // one-click "Rebuild site" button. Leave '' to use the manual retry hint.
    // Only set this if Cloudflare Access stays on /dashboard — the URL lives in
    // this page's HTML. Create one at: CF Pages → your project → Settings →
    // Builds & deployments → Deploy hooks.
    const DEPLOY_HOOK = 'https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/ae49d78c-2b45-463f-9b8c-2a8bac146200';

    const SU = document.body.dataset.su;
    const SK = document.body.dataset.sk;
    const $ = (id) => document.getElementById(id);

    if (!SU || !SK) {
      document.body.innerHTML =
        '<div class="login"><div class="login-card"><h1>Config missing</h1>' +
        '<p>Set SUPABASE_URL and SUPABASE_ANON_KEY in the Cloudflare Pages env vars and rebuild.</p></div></div>';
      throw new Error('missing supabase config');
    }

    const sb = createClient(SU, SK, { auth: { persistSession: true, autoRefreshToken: true } });

const TIERS = ['free', 'verified', 'enhanced', 'featured']; // shared tier list — used by renderClaims() and renderPaid()

    // ---- helpers ----------------------------------------------------------
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const num = (x) => (x == null ? 0 : x).toLocaleString();
    const fmtDate = (s) => { try { return new Date(s).toLocaleDateString(undefined,
      { month: 'short', day: 'numeric' }); } catch { return ''; } };
    const card = (n, l) => `<div class="card"><div class="n">${num(n)}</div><div class="l">${esc(l)}</div></div>`;

    function showRebuildBanner() { const b = $('banner'); b.classList.add('show'); b.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

    // ---- auth gate --------------------------------------------------------
    function showLogin() { $('login').classList.remove('hidden'); $('app').classList.add('hidden'); }
    function showApp(email) {
      $('login').classList.add('hidden'); $('app').classList.remove('hidden');
      $('who').textContent = email || '';
    }

    $('signin').addEventListener('click', signIn);
    $('password').addEventListener('keydown', (e) => { if (e.key === 'Enter') signIn(); });
    async function signIn() {
      $('loginErr').textContent = '';
      $('signin').disabled = true;
      const { error } = await sb.auth.signInWithPassword({
        email: $('email').value.trim(), password: $('password').value
      });
      $('signin').disabled = false;
      if (error) { $('loginErr').textContent = error.message; }
      // success → onAuthStateChange fires and loads the app
    }
    $('signout').addEventListener('click', () => sb.auth.signOut());

    sb.auth.onAuthStateChange((_e, session) => {
      if (session) { showApp(session.user.email); load(); }
      else { showLogin(); }
    });
    // initial check
    sb.auth.getSession().then(({ data }) => {
      if (data.session) { showApp(data.session.user.email); load(); }
      else { showLogin(); }
    });

    // ---- data + render ----------------------------------------------------
    async function load() {
      $('loading').classList.remove('hidden'); $('content').classList.add('hidden');
      try {
        const [stats, claims, paid, leads] = await Promise.all([
          sb.rpc('admin_stats'),
          sb.from('claims').select('*').order('created_at', { ascending: false }).limit(100),
          sb.from('clinics').select('npi,name,city,state,slug,listing_tier')
            .neq('listing_tier', 'free').order('listing_tier', { ascending: false }).limit(200),
          sb.from('leads').select('*').order('created_at', { ascending: false }).limit(15),
        ]);
        if (stats.error) throw new Error('stats: ' + stats.error.message);
        renderCards(stats.data || {});
        renderClaims(claims.data || []);
        renderPaid(paid.data || []);
        renderLeads(leads.data || []);
        $('loading').classList.add('hidden'); $('content').classList.remove('hidden');
      } catch (e) {
        $('loading').innerHTML = 'Could not load: ' + esc(e.message) +
          '<br><span class="who">If this says permission denied, confirm you ran admin_login_setup.sql and added yourself to the admins table.</span>';
      }
    }

    function renderCards(s) {
      const live = (s.tier_enhanced || 0) + (s.tier_featured || 0);
      $('cards').innerHTML =
        card(s.clinics_total, 'Clinics') +
        card(s.claims_total, 'Claim requests') +
        card(live, 'Paying listings') +
        card(s.leads_total, 'Leads (all time)') +
        card(s.leads_30d, 'Leads · 30d');
    }

    function renderClaims(rows) {
      const newCount = rows.filter(r => (r.status || 'new') === 'new').length;
      const pill = $('claimsPill');
      pill.textContent = newCount ? newCount + ' new' : rows.length;
      pill.className = 'pill' + (newCount ? ' hot' : '');
      if (!rows.length) { $('claims').innerHTML = '<div class="empty">No claim requests yet.</div>'; return; }

      const STATUSES = ['new', 'verifying', 'verified', 'customer', 'declined'];
      $('claims').innerHTML = rows.map(r => {
        const opts = STATUSES.map(st =>
          `<option value="${st}"${(r.status || 'new') === st ? ' selected' : ''}>${st}</option>`).join('');
        const tierSel = TIERS.map(t =>
          `<option value="${t}"${t === 'verified' ? ' selected' : ''}>${t}</option>`).join('');
        const profile = r.clinic_slug
          ? `<a href="https://painbeacon.com/clinic/${esc(r.clinic_slug)}/" target="_blank" rel="noopener">view profile ↗</a>` : '';
        const contact = [r.contact_name, r.role].filter(Boolean).map(esc).join(' · ');
        const reach = [r.work_email, r.phone].filter(Boolean).map(esc).join(' · ');
        const web = r.website
          ? `<a href="${esc(r.website)}" target="_blank" rel="noopener nofollow">${esc(r.website)} ↗</a>`
          : '<span style="color:var(--muted)">no website submitted</span>';
        const decided = (r.status === 'verified' || r.status === 'customer' || r.status === 'declined');
        return `<div class="item ${ (r.status||'new')==='new' ? 'new' : '' } ${ decided ? 'resolved' : '' }" id="claim-${esc(r.id)}">
          <div class="main">
            <div class="name">${esc(r.clinic_name || 'Unknown clinic')}
              <span class="who" style="font-weight:500">${esc(r.state || '')}</span></div>
            <div class="meta">${esc(fmtDate(r.created_at))} · ${contact || 'no name'}${ r.interest ? ' · wants: ' + esc(r.interest) : '' }</div>
            <div class="meta">${reach || 'no contact info'} ${profile}</div>
            <div class="meta">website: ${web}</div>
            ${ r.message ? `<div class="meta">“${esc(r.message)}”</div>` : '' }
          </div>
          <div class="claim-actions">
            <select class="ctl" data-tier="${esc(r.id)}" title="Tier to set on approve">${tierSel}</select>
            <button class="btn-approve" data-approve="${esc(r.id)}" data-npi="${esc(r.npi || '')}">✓ Approve</button>
            <button class="btn-reject" data-reject="${esc(r.id)}">✕ Reject</button>
            <select class="ctl" data-claim="${esc(r.id)}" title="Or set status manually">${opts}</select>
            <span class="saved" id="cs-${esc(r.id)}">saved</span>
            <span class="decided" id="cd-${esc(r.id)}" ${decided ? '' : 'hidden'}>${esc(r.status||'')}</span>
          </div>
        </div>`;
      }).join('');

      $('claims').querySelectorAll('select[data-claim]').forEach(sel => {
        sel.addEventListener('change', async () => {
          const id = sel.getAttribute('data-claim');
          sel.disabled = true;
          const { error } = await sb.from('claims').update({ status: sel.value }).eq('id', id);
          sel.disabled = false;
          if (error) { alert('Could not save: ' + error.message); return; }
          flash('cs-' + id);
          renderClaimsPill();
        });
      });

      $('claims').querySelectorAll('button[data-approve]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-approve');
          const npi = btn.getAttribute('data-npi');
          const row = (rows.find(x => String(x.id) === String(id)) || {});
          const tier = (document.querySelector(`select[data-tier="${id}"]`) || {}).value || 'verified';
          if (!npi) { alert('This claim has no NPI, so it cannot be linked to a clinic record. Use the status dropdown instead.'); return; }
          const clinicPatch = { listing_tier: tier };
          if (row.website) clinicPatch.website = row.website;
          if (row.work_email) clinicPatch.contact_email = row.work_email;
          if (!confirm('Approve "' + (row.clinic_name || npi) + '"?\n\n• tier -> ' + tier + '\n• website -> ' + (row.website || '(none)') + '\n• contact email -> ' + (row.work_email || '(none)') + '\n\nThen click "Rebuild site" to push it live.')) return;
          btn.disabled = true; btn.textContent = '…';
          const r1 = await sb.from('clinics').update(clinicPatch).eq('npi', npi);
          if (r1.error) { btn.disabled = false; btn.textContent = '✓ Approve'; alert('Clinic update failed: ' + r1.error.message); return; }
          const r2 = await sb.from('claims').update({ status: 'verified' }).eq('id', id);
          if (r2.error) { alert('Clinic updated, but marking the claim failed: ' + r2.error.message); }
          const d = $('cd-' + id); if (d) { d.hidden = false; d.textContent = 'approved ✓ — rebuild to publish'; }
          const rowEl = $('claim-' + id); if (rowEl) { rowEl.classList.remove('new'); rowEl.classList.add('resolved'); }
          const stSel = document.querySelector(`select[data-claim="${id}"]`); if (stSel) stSel.value = 'verified';
          btn.textContent = '✓ Approved'; renderClaimsPill();
          showRebuildBanner();
        });
      });

      $('claims').querySelectorAll('button[data-reject]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-reject');
          if (!confirm('Reject this claim? Nothing will be published. You can still change it later.')) return;
          btn.disabled = true;
          const { error } = await sb.from('claims').update({ status: 'declined' }).eq('id', id);
          btn.disabled = false;
          if (error) { alert('Could not save: ' + error.message); return; }
          const d = $('cd-' + id); if (d) { d.hidden = false; d.textContent = 'declined'; }
          const rowEl = $('claim-' + id); if (rowEl) { rowEl.classList.remove('new'); rowEl.classList.add('resolved'); }
          const stSel = document.querySelector(`select[data-claim="${id}"]`); if (stSel) stSel.value = 'declined';
          renderClaimsPill();
          showRebuildBanner();
        });
      });
    }
    function renderClaimsPill() {
      const sels = [...document.querySelectorAll('select[data-claim]')];
      const newCount = sels.filter(s => s.value === 'new').length;
      const pill = $('claimsPill');
      pill.textContent = newCount ? newCount + ' new' : sels.length;
      pill.className = 'pill' + (newCount ? ' hot' : '');
    }

    function renderPaid(rows) {
      $('paidPill').textContent = rows.length;
      if (!rows.length) { $('paid').innerHTML = '<div class="empty">No paid or featured listings yet.</div>'; return; }

      $('paid').innerHTML = rows.map(r => {
        const tier = r.listing_tier || 'free';
        const opts = TIERS.map(t => `<option value="${t}"${tier === t ? ' selected' : ''}>${t}</option>`).join('');
        const loc = [r.city, r.state].filter(Boolean).map(esc).join(', ');
        return `<div class="item">
          <div class="main">
            <div class="name"><span class="tag ${esc(tier)}">${esc(tier)}</span> ${esc(r.name || '')}</div>
            <div class="meta">${loc} · <a href="https://painbeacon.com/clinic/${esc(r.slug)}/" target="_blank" rel="noopener">view profile ↗</a></div>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            <select class="ctl" data-npi="${esc(r.npi)}">${opts}</select>
            <span class="saved" id="ps-${esc(r.npi)}">saved</span>
          </div>
        </div>`;
      }).join('');

      $('paid').querySelectorAll('select[data-npi]').forEach(sel => {
        sel.addEventListener('change', async () => {
          const npi = sel.getAttribute('data-npi');
          sel.disabled = true;
          const { error } = await sb.from('clinics').update({ listing_tier: sel.value }).eq('npi', npi);
          sel.disabled = false;
          if (error) { alert('Could not save: ' + error.message); return; }
          flash('ps-' + npi);
          showRebuildBanner();
        });
      });
    }

    function renderLeads(rows) {
      $('leadsPill').textContent = rows.length;
      if (!rows.length) { $('leads').innerHTML = '<div class="empty">No leads yet.</div>'; return; }
      const skip = new Set(['id', 'created_at', 'user_agent', 'source_page', 'wants_contact']);
      $('leads').innerHTML = rows.map(r => {
        const fields = Object.entries(r)
          .filter(([k, v]) => !skip.has(k) && v != null && String(v).trim() !== '')
          .map(([k, v]) => `${esc(k)}: <b>${esc(v)}</b>`).join(' · ');
        const wants = r.wants_contact ? '<span class="tag verified">wants contact</span>' : '';
        return `<div class="item">
          <div class="main">
            <div class="name">${esc(fmtDate(r.created_at))} ${wants}</div>
            <div class="meta">${fields || '(no detail captured)'}</div>
          </div>
        </div>`;
      }).join('');
    }

    function flash(id) {
      const el = $(id); if (!el) return;
      el.classList.add('show');
      setTimeout(() => el.classList.remove('show'), 1400);
    }

    // ---- rebuild button ---------------------------------------------------
    if (DEPLOY_HOOK) {
      const b = $('rebuildBtn');
      b.classList.remove('hidden');
      $('rebuildHint').classList.add('hidden');
      b.addEventListener('click', async () => {
        b.disabled = true; b.textContent = 'Triggering…';
        try {
          await fetch(DEPLOY_HOOK, { method: 'POST', mode: 'no-cors' });
          b.textContent = 'Build requested ✓';
        } catch { b.textContent = 'Failed — retry in CF'; }
        setTimeout(() => { b.disabled = false; b.textContent = 'Rebuild site'; }, 5000);
      });
    }
  </script>
</body>
</html>
