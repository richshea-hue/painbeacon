---
// PainBeacon internal dashboard — now gated by a real Supabase login.
// Drop this in at src/pages/dashboard.astro (replaces the old anon-key page).
//
// The anon key is still embedded as the Supabase `apikey` (it's meant to be
// public). Security now comes from RLS + is_admin(): claim PII, leads, and all
// writes are only available once you're logged in as an allowlisted admin.
//
// Recommended: keep Cloudflare Access on /dashboard as the edge gate, and use
// this login as the data-layer gate. You'll log in twice; that's the strongest
// posture and lets the page hold things like a deploy hook safely.
const SUPABASE_URL = process.env.SUPABASE_URL || '';
const SUPABASE_ANON_KEY = process.env.SUPABASE_ANON_KEY || '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>PainBeacon · Admin</title>
  <style>
    :root {
      --bg: #0e1113;
      --panel: #161a1d;
      --panel-2: #1d2226;
      --line: #2a3137;
      --ink: #e8edf0;
      --muted: #8b97a0;
      --teal: #2dd4bf;
      --amber: #f5b94a;
      --red: #f0726a;
      --green: #4ec98a;
      --radius: 12px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--bg); color: var(--ink); }
    body {
      font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      padding: 0 0 64px;
    }
    a { color: var(--teal); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .wrap { max-width: 980px; margin: 0 auto; padding: 0 18px; }

    /* Header */
    header {
      position: sticky; top: 0; z-index: 5;
      background: rgba(14,17,19,.85); backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line);
    }
    header .wrap { display: flex; align-items: center; gap: 12px; height: 58px; }
    .brand { font-weight: 700; letter-spacing: .2px; display: flex; align-items: center; gap: 8px; }
    .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 12px var(--teal); }
    .brand small { color: var(--muted); font-weight: 500; letter-spacing: .5px; text-transform: uppercase; font-size: 11px; }
    .spacer { flex: 1; }
    .who { color: var(--muted); font-size: 13px; }

    /* Buttons */
    .btn {
      appearance: none; border: 1px solid var(--line); background: var(--panel-2);
      color: var(--ink); padding: 8px 14px; border-radius: 9px; cursor: pointer;
      font-size: 14px; font-weight: 600; transition: border-color .15s, background .15s;
    }
    .btn:hover { border-color: var(--teal); }
    .btn.primary { background: var(--teal); color: #04201c; border-color: var(--teal); }
    .btn.ghost { background: transparent; }
    .btn:disabled { opacity: .5; cursor: default; }

    /* Login */
    .login { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
    .login-card {
      width: 100%; max-width: 360px; background: var(--panel); border: 1px solid var(--line);
      border-radius: 16px; padding: 28px;
    }
    .login-card h1 { font-size: 20px; margin: 0 0 4px; }
    .login-card p { color: var(--muted); margin: 0 0 20px; font-size: 14px; }
    .field { display: block; margin-bottom: 14px; }
    .field span { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .5px; }
    .field input {
      width: 100%; background: var(--bg); border: 1px solid var(--line); color: var(--ink);
      border-radius: 9px; padding: 11px 12px; font-size: 15px;
    }
    .field input:focus { outline: none; border-color: var(--teal); }
    .login .btn { width: 100%; padding: 12px; }
    .err { color: var(--red); font-size: 13px; margin-top: 12px; min-height: 18px; }

    /* Sections */
    section { margin-top: 28px; }
    .sec-head { display: flex; align-items: baseline; gap: 10px; margin: 0 0 12px; }
    .sec-head h2 { font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin: 0; font-weight: 700; }
    .pill { font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 999px; background: var(--panel-2); color: var(--muted); }
    .pill.hot { background: rgba(245,185,74,.16); color: var(--amber); }

    /* Stat cards */
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
    .card .n { font-size: 26px; font-weight: 700; line-height: 1; }
    .card .l { color: var(--muted); font-size: 13px; margin-top: 6px; }

    /* Lists */
    .list { display: flex; flex-direction: column; gap: 10px; }
    .item {
      background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 14px 16px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
    }
    .item.new { border-color: rgba(245,185,74,.4); }
    :global(.item.resolved) { opacity: .5; }
    :global(.item.resolved.new) { border-color: var(--border); }
    .item .main { flex: 1 1 240px; min-width: 0; }
    .item .name { font-weight: 700; }
    .item .meta { color: var(--muted); font-size: 13px; margin-top: 3px; word-break: break-word; }
    .item .meta a { color: var(--teal); }
    .tag { display: inline-block; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: var(--panel-2); color: var(--muted); margin-right: 6px; text-transform: uppercase; letter-spacing: .4px; }
    .claim-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .btn-approve { background:var(--teal,#0e6e62); color:#fff; border:0; border-radius:7px; padding:7px 12px; font-size:13px; font-weight:600; cursor:pointer; }
    .btn-approve:hover { filter:brightness(1.08); }  .btn-approve:disabled { opacity:.6; cursor:default; }
    .btn-reject { background:transparent; color:#c2603f; border:1px solid #c2603f55; border-radius:7px; padding:7px 12px; font-size:13px; font-weight:600; cursor:pointer; }
    .btn-reject:hover { background:#c2603f12; }
    .decided { font-size:12px; font-weight:600; color:var(--teal,#0e6e62); }
    .tag.featured { background: rgba(245,185,74,.18); color: var(--amber); }
    .tag.enhanced { background: rgba(45,212,191,.16); color: var(--teal); }
    .tag.verified { background: rgba(78,201,138,.16); color: var(--green); }
    select.ctl, input.ctl {
      background: var(--bg); border: 1px solid var(--line); color: var(--ink);
      border-radius: 8px; padding: 8px 10px; font-size: 14px; font-weight: 600;
    }
    input.ctl { font-weight: 500; min-width: 190px; }
    select.ctl:focus, input.ctl:focus { outline: none; border-color: var(--teal); }

    /* Non-registry listings: the add/edit form */
    .nr-form { margin-top: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; }
    .nr-form summary { cursor: pointer; font-weight: 700; }
    .nr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px 12px; margin: 14px 0; }
    .nr-grid label { display: block; font-size: 12px; color: var(--muted); }
    .nr-grid label.wide { grid-column: 1 / -1; }
    .nr-grid input, .nr-grid textarea, .nr-grid select {
      display: block; width: 100%; margin-top: 4px; background: var(--bg); border: 1px solid var(--line);
      color: var(--ink); border-radius: 8px; padding: 8px 10px; font-size: 14px; font-family: inherit;
    }
    .nr-grid input:focus, .nr-grid textarea:focus { outline: none; border-color: var(--teal); }
    .nr-note { font-size: 13px; color: var(--muted); margin: 6px 0 0; }
    .nr-err { color: var(--red); font-size: 13px; margin: 8px 0 0; min-height: 18px; white-space: pre-line; }
    .tag.published { background: rgba(78,201,138,.16); color: var(--green); }
    .tag.draft { background: rgba(245,185,74,.18); color: var(--amber); }
    .btn-mini { background: transparent; color: var(--teal); border: 1px solid var(--line); border-radius: 7px; padding: 7px 12px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn-mini:hover { border-color: var(--teal); }
    .saved { font-size: 12px; color: var(--green); opacity: 0; transition: opacity .2s; }
    .saved.show { opacity: 1; }

    .empty { color: var(--muted); font-size: 14px; padding: 18px; text-align: center; border: 1px dashed var(--line); border-radius: var(--radius); }

    /* Rebuild banner */
    .banner {
      position: sticky; bottom: 0; margin-top: 28px;
      background: rgba(245,185,74,.12); border: 1px solid rgba(245,185,74,.4);
      color: var(--amber); border-radius: var(--radius); padding: 14px 16px;
      display: none; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .banner.show { display: flex; }
    .banner .txt { flex: 1 1 280px; font-size: 14px; }
    .banner .txt b { color: var(--ink); }

    .loading { padding: 60px 0; text-align: center; color: var(--muted); }
    .hidden { display: none !important; }
  </style>
</head>
<body data-su={SUPABASE_URL} data-sk={SUPABASE_ANON_KEY}>

  <!-- LOGIN -->
  <div id="login" class="login hidden">
    <div class="login-card">
      <h1>PainBeacon Admin</h1>
      <p>Sign in to manage claims and listings.</p>
      <label class="field"><span>Email</span><input id="email" type="email" autocomplete="username" /></label>
      <label class="field"><span>Password</span><input id="password" type="password" autocomplete="current-password" /></label>
      <button id="signin" class="btn primary">Sign in</button>
      <div id="loginErr" class="err"></div>
    </div>
  </div>

  <!-- APP -->
  <div id="app" class="hidden">
    <header>
      <div class="wrap">
        <div class="brand"><span class="dot"></span> PainBeacon <small>Admin</small></div>
        <div class="spacer"></div>
        <span id="who" class="who"></span>
        <button id="signout" class="btn ghost">Sign out</button>
      </div>
    </header>

    <main class="wrap">
      <div id="loading" class="loading">Loading…</div>

      <div id="content" class="hidden">
        <section>
          <div class="sec-head"><h2>Overview</h2></div>
          <div id="cards" class="cards"></div>
        </section>

        <section>
          <div class="sec-head"><h2>Claim requests</h2><span id="claimsPill" class="pill">0</span></div>
          <div id="claims" class="list"></div>
        </section>

        <section>
          <div class="sec-head"><h2>Paid &amp; featured listings</h2><span id="paidPill" class="pill">0</span></div>
          <div id="paid" class="list"></div>
        </section>

        <section id="nrSection">
          <div class="sec-head"><h2>Listed, not ranked</h2><span id="nrPill" class="pill">0</span></div>
          <div id="nr" class="list"></div>
          <details id="nrFormWrap" class="nr-form">
            <summary id="nrFormTitle">Add a non-registry listing</summary>
            <p class="nr-note">For a practice that asked to be listed and has no record of its own in the federal NPI
              registry. It gets its own page at /listing/…/ and a labeled spot below the ranked list on its area page.
              It is never ranked and never called verified. Check the registry first: if the practice has an NPI with a
              pain taxonomy it belongs in the ranked directory, not here.</p>
            <input type="hidden" id="nr-id" /><input type="hidden" id="nr-claim_id" />
            <div class="nr-grid">
              <label>Practice name<input id="nr-name" maxlength="120" /></label>
              <label>Practice type (e.g. Chiropractic, Pain management)<input id="nr-practice_type" maxlength="60" /></label>
              <label>Street address<input id="nr-address_1" /></label>
              <label>Suite / unit<input id="nr-address_2" /></label>
              <label>City<input id="nr-city" /></label>
              <label>State (2 letters)<input id="nr-state" maxlength="2" style="text-transform:uppercase" /></label>
              <label>ZIP<input id="nr-postal_code" maxlength="10" /></label>
              <label>Phone<input id="nr-phone" /></label>
              <label>Website<input id="nr-website" placeholder="https://" /></label>
              <label>Additional location of (registry NPI, optional)<input id="nr-parent_npi" inputmode="numeric" maxlength="10" /></label>
              <label>Latitude (optional)<input id="nr-latitude" inputmode="decimal" /></label>
              <label>Longitude (optional)<input id="nr-longitude" inputmode="decimal" /></label>
              <label class="wide">From the practice (optional, 400 characters, shown publicly)<textarea id="nr-description" rows="2" maxlength="400"></textarea></label>
              <label>URL slug (filled in for you)<input id="nr-slug" /></label>
              <label>Their email (private)<input id="nr-contact_email" type="email" /></label>
              <label>Confirmed with the practice on (required to publish)<input id="nr-confirmed_on" type="date" /></label>
              <label>How it was confirmed (required to publish)<input id="nr-confirmed_how" placeholder="e.g. email from info@theirdomain.com" /></label>
              <label class="wide">Notes (private)<textarea id="nr-internal_notes" rows="2"></textarea></label>
            </div>
            <button id="nrSave" class="btn primary" type="button">Save as draft</button>
            <button id="nrReset" class="btn ghost" type="button">Clear</button>
            <p class="nr-note">Saving never publishes. Set the status to “published” in the list above once the practice
              itself has confirmed the details, then rebuild.</p>
            <p id="nrErr" class="nr-err"></p>
          </details>
        </section>

        <section>
          <div class="sec-head"><h2>Recent leads</h2><span id="leadsPill" class="pill">0</span></div>
          <div id="leads" class="list"></div>
        </section>
      </div>
    </main>

    <div id="banner" class="banner">
      <div class="txt"><b>Listing changes saved.</b> They won't appear on the live site until you rebuild (the site is static).</div>
      <button id="rebuildBtn" class="btn primary hidden">Rebuild site</button>
      <span id="rebuildHint" class="who">Cloudflare Pages → Deployments → Retry latest</span>
    </div>
  </div>

  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';

    // OPTIONAL: paste a Cloudflare Pages "Deploy hook" URL here to enable the
    // one-click "Rebuild site" button. Leave '' to use the manual retry hint.
    // Only set this if Cloudflare Access stays on /dashboard — the URL lives in
    // this page's HTML. Create one at: CF Pages → your project → Settings →
    // Builds & deployments → Deploy hooks.
    const DEPLOY_HOOK = 'https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/ae49d78c-2b45-463f-9b8c-2a8bac146200';

    const SU = document.body.dataset.su;
    const SK = document.body.dataset.sk;
    const $ = (id) => document.getElementById(id);

    if (!SU || !SK) {
      document.body.innerHTML =
        '<div class="login"><div class="login-card"><h1>Config missing</h1>' +
        '<p>Set SUPABASE_URL and SUPABASE_ANON_KEY in the Cloudflare Pages env vars and rebuild.</p></div></div>';
      throw new Error('missing supabase config');
    }

    const sb = createClient(SU, SK, { auth: { persistSession: true, autoRefreshToken: true } });

const TIERS = ['free', 'verified', 'enhanced', 'featured']; // shared tier list — used by renderClaims() and renderPaid()

    // ---- helpers ----------------------------------------------------------
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const num = (x) => (x == null ? 0 : x).toLocaleString();
    const fmtDate = (s) => { try { return new Date(s).toLocaleDateString(undefined,
      { month: 'short', day: 'numeric' }); } catch { return ''; } };
    const card = (n, l) => `<div class="card"><div class="n">${num(n)}</div><div class="l">${esc(l)}</div></div>`;

    // Is this row a claim on an existing listing, or a practice asking to be
    // added? BOTH forms write to `claims` with the same columns, so nothing in
    // the schema separates them — the clinic-page form (ClaimProfile.astro)
    // carries clinic_slug and npi off the page it sits on, while the
    // /for-practices/ inquiry form sends both as null on purpose. That null is
    // the only signal, and source_page is checked too so a clinic-page claim
    // that somehow arrives without a slug is still read as a claim.
    //
    // Worth telling apart because the two need opposite answers: one is a
    // verification of a practice already in the directory, the other is a
    // question about whether the practice belongs in it at all. Read as the
    // same thing, an inquiry looks like a claim with a broken NPI field.
    const isInquiry = (r) => !r.clinic_slug && !/^\/clinic\//.test(r.source_page || '');
    // The claim form folds "the name patients know us by" into the message as
    // one labeled line rather than a column of its own, so the public write
    // path never depends on a migration having run. Read it back out here.
    const brandFromMessage = (r) => {
      const m = /^Known to patients as:\s*(.+)$/m.exec(r.message || '');
      return m ? m[1].trim() : '';
    };

    function showRebuildBanner() { const b = $('banner'); b.classList.add('show'); b.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

    // ---- auth gate --------------------------------------------------------
    function showLogin() { $('login').classList.remove('hidden'); $('app').classList.add('hidden'); }
    function showApp(email) {
      $('login').classList.add('hidden'); $('app').classList.remove('hidden');
      $('who').textContent = email || '';
    }

    $('signin').addEventListener('click', signIn);
    $('password').addEventListener('keydown', (e) => { if (e.key === 'Enter') signIn(); });
    async function signIn() {
      $('loginErr').textContent = '';
      $('signin').disabled = true;
      const { error } = await sb.auth.signInWithPassword({
        email: $('email').value.trim(), password: $('password').value
      });
      $('signin').disabled = false;
      if (error) { $('loginErr').textContent = error.message; }
      // success → onAuthStateChange fires and loads the app
    }
    $('signout').addEventListener('click', () => sb.auth.signOut());

    sb.auth.onAuthStateChange((_e, session) => {
      if (session) { showApp(session.user.email); load(); }
      else { showLogin(); }
    });
    // initial check
    sb.auth.getSession().then(({ data }) => {
      if (data.session) { showApp(data.session.user.email); load(); }
      else { showLogin(); }
    });

    // ---- data + render ----------------------------------------------------
    async function load() {
      $('loading').classList.remove('hidden'); $('content').classList.add('hidden');
      try {
        const [stats, claims, paid, leads, listed] = await Promise.all([
          sb.rpc('admin_stats'),
          sb.from('claims').select('*').order('created_at', { ascending: false }).limit(100),
          // '*' rather than a column list: brand_name is read here, and naming a
          // column that a database has not been migrated to yet fails the whole
          // dashboard. This is the signed-in admin reading a handful of rows.
          sb.from('clinics').select('*')
            .neq('listing_tier', 'free').order('listing_tier', { ascending: false }).limit(200),
          sb.from('leads').select('*').order('created_at', { ascending: false }).limit(15),
          // Resolves with { error } rather than throwing, and renderListed()
          // reads it: a database that has not had nonregistry_listings.sql run
          // shows a one-line notice in that section and the rest loads as usual.
          sb.from('nonregistry_listings').select('*').order('created_at', { ascending: false }).limit(200),
        ]);
        if (stats.error) throw new Error('stats: ' + stats.error.message);
        renderCards(stats.data || {});
        renderClaims(claims.data || []);
        renderPaid(paid.data || []);
        claimRows = claims.data || [];
        renderListed(listed);
        renderLeads(leads.data || []);
        $('loading').classList.add('hidden'); $('content').classList.remove('hidden');
      } catch (e) {
        $('loading').innerHTML = 'Could not load: ' + esc(e.message) +
          '<br><span class="who">If this says permission denied, confirm you ran admin_login_setup.sql and added yourself to the admins table.</span>';
      }
    }

    function renderCards(s) {
      const live = (s.tier_enhanced || 0) + (s.tier_featured || 0);
      $('cards').innerHTML =
        card(s.clinics_total, 'Clinics') +
        card(s.claims_total, 'Claim requests') +
        card(live, 'Paying listings') +
        card(s.leads_total, 'Leads (all time)') +
        card(s.leads_30d, 'Leads · 30d');
    }

    function renderClaims(rows) {
      const newCount = rows.filter(r => (r.status || 'new') === 'new').length;
      const pill = $('claimsPill');
      pill.textContent = newCount ? newCount + ' new' : rows.length;
      pill.className = 'pill' + (newCount ? ' hot' : '');
      if (!rows.length) { $('claims').innerHTML = '<div class="empty">No claim requests yet.</div>'; return; }

      const STATUSES = ['new', 'verifying', 'verified', 'customer', 'declined'];
      $('claims').innerHTML = rows.map(r => {
        const opts = STATUSES.map(st =>
          `<option value="${st}"${(r.status || 'new') === st ? ' selected' : ''}>${st}</option>`).join('');
        const tierSel = TIERS.map(t =>
          `<option value="${t}"${t === 'verified' ? ' selected' : ''}>${t}</option>`).join('');
        const profile = r.clinic_slug
          ? `<a href="https://painbeacon.com/clinic/${esc(r.clinic_slug)}/" target="_blank" rel="noopener">view profile ↗</a>` : '';
        const contact = [r.contact_name, r.role].filter(Boolean).map(esc).join(' · ');
        const reach = [r.work_email, r.phone].filter(Boolean).map(esc).join(' · ');
        const web = r.website
          ? `<a href="${esc(r.website)}" target="_blank" rel="noopener nofollow">${esc(r.website)} ↗</a>`
          : '<span style="color:var(--muted)">no website submitted</span>';
        const decided = (r.status === 'verified' || r.status === 'customer' || r.status === 'declined');
        return `<div class="item ${ (r.status||'new')==='new' ? 'new' : '' } ${ decided ? 'resolved' : '' }" id="claim-${esc(r.id)}">
          <div class="main">
            <div class="name">${esc(r.clinic_name || 'Unknown clinic')}
              <span class="who" style="font-weight:500">${esc(r.state || '')}</span></div>
            <div class="meta">${esc(fmtDate(r.created_at))} · ${contact || 'no name'}${ r.interest ? ' · wants: ' + esc(r.interest) : '' }</div>
            <div class="meta">${reach || 'no contact info'} ${profile}</div>
            <div class="meta">website: ${web}</div>
            ${ isInquiry(r) ? '<div class="meta" style="color:var(--muted)">practice inquiry from '
              + esc(r.source_page || 'the inquiry form')
              + ' — not a claim on an existing listing, so there is no clinic record to link</div>' : '' }
            ${ r.message ? `<div class="meta">“${esc(r.message)}”</div>` : '' }
          </div>
          <div class="claim-actions">
            ${ r.npi ? `<input class="ctl" data-brand="${esc(r.id)}" type="text" maxlength="80" value="${esc(brandFromMessage(r))}"
              placeholder="Brand name (optional)" title="The name patients know the practice by. Shown first, with the registered name beside it. Leave blank to show the registered name only." />` : '' }
            <select class="ctl" data-tier="${esc(r.id)}" title="Tier to set on approve">${tierSel}</select>
            <button class="btn-approve" data-approve="${esc(r.id)}" data-npi="${esc(r.npi || '')}">✓ Approve</button>
            <button class="btn-reject" data-reject="${esc(r.id)}">✕ Reject</button>
            ${ isInquiry(r) ? `<button class="btn-mini" data-nr-from="${esc(r.id)}" title="Start a non-registry listing from this inquiry. Opens the form below, filled in; nothing is saved or published until you say so.">＋ List, not ranked</button>` : '' }
            <select class="ctl" data-claim="${esc(r.id)}" title="Or set status manually">${opts}</select>
            <span class="saved" id="cs-${esc(r.id)}">saved</span>
            <span class="decided" id="cd-${esc(r.id)}" ${decided ? '' : 'hidden'}>${esc(r.status||'')}</span>
          </div>
        </div>`;
      }).join('');

      $('claims').querySelectorAll('select[data-claim]').forEach(sel => {
        sel.addEventListener('change', async () => {
          const id = sel.getAttribute('data-claim');
          sel.disabled = true;
          const { error } = await sb.from('claims').update({ status: sel.value }).eq('id', id);
          sel.disabled = false;
          if (error) { alert('Could not save: ' + error.message); return; }
          flash('cs-' + id);
          renderClaimsPill();
        });
      });

      $('claims').querySelectorAll('button[data-approve]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-approve');
          const npi = btn.getAttribute('data-npi');
          const row = (rows.find(x => String(x.id) === String(id)) || {});
          const tier = (document.querySelector(`select[data-tier="${id}"]`) || {}).value || 'verified';
          // The guard itself does not move: no NPI means no row in `clinics` to
          // link, and inventing one is the mistake this refuses to make. Only
          // the explanation changes, because "no NPI" is a defect on a real
          // claim and the normal state of an inquiry.
          if (!npi) {
            alert(isInquiry(row)
              ? 'This came from the ' + (row.source_page || 'practice inquiry') + ' form, not a clinic page, so it is not a claim on an '
                + 'existing listing — it is a practice asking to be added. There is no clinic record to link, '
                + 'and nothing here is broken.\n\nAsk for their NPI and check whether it carries a pain taxonomy '
                + 'before anything else. Use the status dropdown to track the row meanwhile — it writes only '
                + 'the status and grants the claimant nothing.'
              : 'This claim has no NPI, so it cannot be linked to a clinic record. Use the status dropdown instead.');
            return;
          }
          const clinicPatch = { listing_tier: tier };
          if (row.website) clinicPatch.website = row.website;
          if (row.work_email) clinicPatch.contact_email = row.work_email;
          // Written only when something was typed, so approving a claim that has
          // no brand name never touches the column (and works before the
          // brand_name migration has run).
          const brand = ((document.querySelector(`input[data-brand="${id}"]`) || {}).value || '').replace(/\s+/g, ' ').trim();
          if (brand) clinicPatch.brand_name = brand;
          if (!confirm('Approve "' + (row.clinic_name || npi) + '"?\n\n• tier -> ' + tier + '\n• website -> ' + (row.website || '(none)') + '\n• contact email -> ' + (row.work_email || '(none)') + '\n• brand name -> ' + (brand || '(none, registered name only)') + '\n\nThen click "Rebuild site" to push it live, and send the Practice Kit link (npm run kit:link -- ' + npi + ').')) return;
          btn.disabled = true; btn.textContent = '…';
          const r1 = await sb.from('clinics').update(clinicPatch).eq('npi', npi);
          if (r1.error) { btn.disabled = false; btn.textContent = '✓ Approve'; alert('Clinic update failed: ' + r1.error.message); return; }
          const r2 = await sb.from('claims').update({ status: 'verified' }).eq('id', id);
          if (r2.error) { alert('Clinic updated, but marking the claim failed: ' + r2.error.message); }
          const d = $('cd-' + id); if (d) { d.hidden = false; d.textContent = 'approved ✓ — rebuild to publish · send the kit link: npm run kit:link -- ' + npi; }
          const rowEl = $('claim-' + id); if (rowEl) { rowEl.classList.remove('new'); rowEl.classList.add('resolved'); }
          const stSel = document.querySelector(`select[data-claim="${id}"]`); if (stSel) stSel.value = 'verified';
          btn.textContent = '✓ Approved'; renderClaimsPill();
          showRebuildBanner();
        });
      });

      $('claims').querySelectorAll('button[data-reject]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-reject');
          if (!confirm('Reject this claim? Nothing will be published. You can still change it later.')) return;
          btn.disabled = true;
          const { error } = await sb.from('claims').update({ status: 'declined' }).eq('id', id);
          btn.disabled = false;
          if (error) { alert('Could not save: ' + error.message); return; }
          const d = $('cd-' + id); if (d) { d.hidden = false; d.textContent = 'declined'; }
          const rowEl = $('claim-' + id); if (rowEl) { rowEl.classList.remove('new'); rowEl.classList.add('resolved'); }
          const stSel = document.querySelector(`select[data-claim="${id}"]`); if (stSel) stSel.value = 'declined';
          renderClaimsPill();
          showRebuildBanner();
        });
      });
    }
    function renderClaimsPill() {
      const sels = [...document.querySelectorAll('select[data-claim]')];
      const newCount = sels.filter(s => s.value === 'new').length;
      const pill = $('claimsPill');
      pill.textContent = newCount ? newCount + ' new' : sels.length;
      pill.className = 'pill' + (newCount ? ' hot' : '');
    }

    function renderPaid(rows) {
      $('paidPill').textContent = rows.length;
      if (!rows.length) { $('paid').innerHTML = '<div class="empty">No paid or featured listings yet.</div>'; return; }

      $('paid').innerHTML = rows.map(r => {
        const tier = r.listing_tier || 'free';
        const opts = TIERS.map(t => `<option value="${t}"${tier === t ? ' selected' : ''}>${t}</option>`).join('');
        const loc = [r.city, r.state].filter(Boolean).map(esc).join(', ');
        return `<div class="item">
          <div class="main">
            <div class="name"><span class="tag ${esc(tier)}">${esc(tier)}</span> ${esc(r.name || '')}</div>
            <div class="meta">${loc} · <a href="https://painbeacon.com/clinic/${esc(r.slug)}/" target="_blank" rel="noopener">view profile ↗</a></div>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            <input class="ctl" data-brand-npi="${esc(r.npi)}" type="text" maxlength="80" value="${esc(r.brand_name || '')}"
              placeholder="Brand name (optional)" title="The name patients know the practice by. Shown first, with the registered name beside it. Clear it to show the registered name only." />
            <select class="ctl" data-npi="${esc(r.npi)}">${opts}</select>
            <span class="saved" id="ps-${esc(r.npi)}">saved</span>
          </div>
        </div>`;
      }).join('');

      // Brand name: saved when the field loses focus with a changed value.
      // Empty clears it (null), which puts the registered name back in front.
      $('paid').querySelectorAll('input[data-brand-npi]').forEach(inp => {
        let last = inp.value;
        inp.addEventListener('change', async () => {
          const npi = inp.getAttribute('data-brand-npi');
          const val = inp.value.replace(/\s+/g, ' ').trim();
          inp.disabled = true;
          const { error } = await sb.from('clinics').update({ brand_name: val || null }).eq('npi', npi);
          inp.disabled = false;
          if (error) {
            inp.value = last;
            alert('Could not save the brand name: ' + error.message +
              (/brand_name/.test(error.message) ? '\n\nThe brand_name column is missing: run brand_name.sql first.' : ''));
            return;
          }
          last = inp.value = val;
          flash('ps-' + npi);
          showRebuildBanner();
        });
      });

      $('paid').querySelectorAll('select[data-npi]').forEach(sel => {
        sel.addEventListener('change', async () => {
          const npi = sel.getAttribute('data-npi');
          sel.disabled = true;
          const { error } = await sb.from('clinics').update({ listing_tier: sel.value }).eq('npi', npi);
          sel.disabled = false;
          if (error) { alert('Could not save: ' + error.message); return; }
          flash('ps-' + npi);
          showRebuildBanner();
        });
      });
    }

    // ---- non-registry listings ("listed, not ranked") ----------------------
    // Practices that asked to be listed and have no record of their own in the
    // federal registry. Their own table, their own page, never a rank: see
    // nonregistry_listings.sql and src/lib/listings.js. The public site reads
    // only rows whose status is "published", and the table refuses that status
    // until confirmed_on / confirmed_how say the practice itself confirmed it.
    let claimRows = [];
    let listedRows = [];
    const NR_FIELDS = ['name', 'practice_type', 'address_1', 'address_2', 'city', 'state', 'postal_code', 'phone',
      'website', 'parent_npi', 'latitude', 'longitude', 'description', 'slug', 'contact_email', 'confirmed_on',
      'confirmed_how', 'internal_notes'];
    const NR_STATUSES = ['draft', 'published', 'removed'];
    const nrVal = (f) => ($('nr-' + f).value || '').replace(/\s+/g, ' ').trim();
    // Same shape as listingSlug() in src/lib/listing-rules.js (this script is
    // inline and cannot import it). The build re-checks every slug regardless.
    const nrSlug = (state, city, name) => [state, city, name].filter(Boolean).join('-')
      .replace(/&/g, ' and ').replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase().slice(0, 120).replace(/-+$/, '');

    function nrFill(row) {
      $('nr-id').value = row.id || '';
      $('nr-claim_id').value = row.claim_id || '';
      NR_FIELDS.forEach(f => { $('nr-' + f).value = row[f] == null ? '' : row[f]; });
      $('nrFormTitle').textContent = row.id ? 'Edit: ' + (row.name || 'listing') : 'Add a non-registry listing';
      $('nrSave').textContent = row.id ? 'Save changes' : 'Save as draft';
      $('nrErr').textContent = '';
    }
    function nrOpen() { const w = $('nrFormWrap'); w.open = true; w.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

    function renderListed(res) {
      const box = $('nr');
      if (res.error) {
        listedRows = [];
        $('nrPill').textContent = '–';
        const missing = /does not exist|schema cache|PGRST205|42P01/i.test((res.error.code || '') + ' ' + (res.error.message || ''));
        box.innerHTML = '<div class="empty">' + (missing
          ? 'Not set up on this database yet. Run <b>nonregistry_listings.sql</b> in the Supabase SQL editor, then reload.'
          : 'Could not load: ' + esc(res.error.message)) + '</div>';
        $('nrFormWrap').hidden = missing;
        return;
      }
      $('nrFormWrap').hidden = false;
      listedRows = res.data || [];
      const live = listedRows.filter(r => r.status === 'published').length;
      $('nrPill').textContent = live + ' live' + (listedRows.length > live ? ' · ' + (listedRows.length - live) + ' not' : '');
      if (!listedRows.length) { box.innerHTML = '<div class="empty">No non-registry listings yet.</div>'; return; }

      box.innerHTML = listedRows.map(r => {
        const opts = NR_STATUSES.map(st => `<option value="${st}"${r.status === st ? ' selected' : ''}>${st}</option>`).join('');
        const loc = [r.address_1, r.city, r.state].filter(Boolean).map(esc).join(', ');
        const conf = r.confirmed_on
          ? 'confirmed ' + esc(r.confirmed_on) + (r.confirmed_how ? ' · ' + esc(r.confirmed_how) : '')
          : '<span style="color:var(--amber)">not yet confirmed with the practice</span>';
        return `<div class="item ${r.status === 'removed' ? 'resolved' : ''}">
          <div class="main">
            <div class="name"><span class="tag ${esc(r.status)}">${esc(r.status)}</span> ${esc(r.name)}
              ${ r.practice_type ? `<span class="who" style="font-weight:500">${esc(r.practice_type)}</span>` : '' }</div>
            <div class="meta">${loc}${ r.parent_npi ? ' · additional location of NPI ' + esc(r.parent_npi) : '' }
              ${ r.status === 'published' ? `· <a href="https://painbeacon.com/listing/${esc(r.slug)}/" target="_blank" rel="noopener">view listing ↗</a>` : '' }</div>
            <div class="meta">${conf}</div>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            <button class="btn-mini" data-nr-edit="${esc(r.id)}">Edit</button>
            <select class="ctl" data-nr-status="${esc(r.id)}">${opts}</select>
            <span class="saved" id="ns-${esc(r.id)}">saved</span>
          </div>
        </div>`;
      }).join('');

      box.querySelectorAll('button[data-nr-edit]').forEach(btn => {
        btn.addEventListener('click', () => {
          const row = listedRows.find(x => String(x.id) === btn.getAttribute('data-nr-edit'));
          if (row) { nrFill(row); nrOpen(); }
        });
      });

      box.querySelectorAll('select[data-nr-status]').forEach(sel => {
        sel.addEventListener('change', async () => {
          const id = sel.getAttribute('data-nr-status');
          const row = listedRows.find(x => String(x.id) === id) || {};
          const was = row.status;
          if (sel.value === 'published') {
            if (!row.confirmed_on || !(row.confirmed_how || '').trim()) {
              sel.value = was;
              alert('Not published.\n\nRecord when and how the practice itself confirmed this listing first (Edit, then the two "Confirmed" fields). A request from a marketing firm or anyone else writing on the practice\'s behalf is not a confirmation.');
              return;
            }
            if (!confirm('Publish "' + row.name + '"?\n\nIt will get a public page at /listing/' + row.slug + '/ and appear below the ranked list on its area page, labeled as listed and not ranked. Live after the next rebuild.')) { sel.value = was; return; }
          }
          sel.disabled = true;
          const { error } = await sb.from('nonregistry_listings')
            .update({ status: sel.value, updated_at: new Date().toISOString() }).eq('id', id);
          sel.disabled = false;
          if (error) { sel.value = was; alert('Could not save: ' + error.message); return; }
          row.status = sel.value;
          renderListed({ data: listedRows }); // redraws the row, so flash after it
          flash('ns-' + id);
          if (was === 'published' || sel.value === 'published') showRebuildBanner();
        });
      });
    }

    // Slug follows state/city/name until someone edits it by hand.
    let nrSlugTouched = false;
    $('nr-slug').addEventListener('input', () => { nrSlugTouched = true; });
    ['name', 'city', 'state'].forEach(f => $('nr-' + f).addEventListener('input', () => {
      if (!$('nr-id').value && !nrSlugTouched) $('nr-slug').value = nrSlug(nrVal('state'), nrVal('city'), nrVal('name'));
    }));
    $('nrReset').addEventListener('click', () => { nrSlugTouched = false; nrFill({}); });

    $('nrSave').addEventListener('click', async () => {
      const id = $('nr-id').value;
      const row = {};
      NR_FIELDS.forEach(f => { row[f] = nrVal(f) || null; });
      row.state = (row.state || '').toUpperCase() || null;
      if (!row.slug) row.slug = nrSlug(row.state, row.city, row.name) || null;
      const errs = [];
      if (!row.name || row.name.length < 2) errs.push('A practice name is required.');
      if (!row.city) errs.push('A city is required.');
      if (!/^[A-Z]{2}$/.test(row.state || '')) errs.push('State must be two letters.');
      if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(row.slug || '')) errs.push('The URL slug may hold only lowercase letters, digits and single hyphens.');
      if (row.parent_npi && !/^\d{10}$/.test(row.parent_npi)) errs.push('The registry NPI must be ten digits.');
      for (const f of ['latitude', 'longitude']) {
        if (row[f] != null && !Number.isFinite(Number(row[f]))) errs.push(f + ' must be a number.');
        row[f] = row[f] == null ? null : Number(row[f]);
      }
      if ((row.latitude == null) !== (row.longitude == null)) errs.push('Give both latitude and longitude, or neither.');
      row.parent_npi = row.parent_npi ? Number(row.parent_npi) : null;
      if (errs.length) { $('nrErr').textContent = errs.join('\n'); return; }

      row.updated_at = new Date().toISOString();
      if (!id) { row.status = 'draft'; row.claim_id = $('nr-claim_id').value || null; }
      const btn = $('nrSave'); btn.disabled = true;
      const res = id
        ? await sb.from('nonregistry_listings').update(row).eq('id', id).select().single()
        : await sb.from('nonregistry_listings').insert(row).select().single();
      btn.disabled = false;
      if (res.error) {
        $('nrErr').textContent = /duplicate key|23505/.test(res.error.message + res.error.code)
          ? 'Another listing already uses that URL slug. Change the slug and save again.'
          : /published_listing_was_confirmed/.test(res.error.message)
            ? 'This listing is published, so the two "Confirmed" fields cannot be emptied. Set it to draft first.'
            : /foreign key|23503/.test(res.error.message + res.error.code)
              ? 'No clinic in the directory has that NPI. Leave the field empty, or check the number.'
              : 'Could not save: ' + res.error.message;
        return;
      }
      const saved = res.data;
      const i = listedRows.findIndex(x => String(x.id) === String(saved.id));
      if (i >= 0) listedRows[i] = saved; else listedRows.unshift(saved);
      renderListed({ data: listedRows });
      if (saved.status === 'published') showRebuildBanner();
      nrSlugTouched = false; nrFill({}); $('nrFormWrap').open = false;
    });

    // "＋ List, not ranked" on an inquiry: open the form filled in from the row.
    // Nothing is written until Save, and Save only ever writes a draft.
    document.addEventListener('click', (ev) => {
      const btn = ev.target.closest && ev.target.closest('button[data-nr-from]');
      if (!btn) return;
      if ($('nrFormWrap').hidden) { alert('Run nonregistry_listings.sql first: this database has no table for these yet.'); return; }
      const r = claimRows.find(x => String(x.id) === btn.getAttribute('data-nr-from'));
      if (!r) return;
      nrSlugTouched = false;
      nrFill({
        claim_id: r.id,
        name: r.clinic_name || '',
        phone: r.phone || '',
        website: r.website || '',
        contact_email: r.work_email || '',
        internal_notes: 'From the ' + (r.source_page || 'inquiry') + ' form, ' + fmtDate(r.created_at) + ', sent by ' +
          [r.contact_name, r.role].filter(Boolean).join(' / ') + '.' + (r.message ? ' They wrote: ' + r.message : ''),
      });
      nrOpen();
    });

    function renderLeads(rows) {
      $('leadsPill').textContent = rows.length;
      if (!rows.length) { $('leads').innerHTML = '<div class="empty">No leads yet.</div>'; return; }
      const skip = new Set(['id', 'created_at', 'user_agent', 'source_page', 'wants_contact']);
      $('leads').innerHTML = rows.map(r => {
        const fields = Object.entries(r)
          .filter(([k, v]) => !skip.has(k) && v != null && String(v).trim() !== '')
          .map(([k, v]) => `${esc(k)}: <b>${esc(v)}</b>`).join(' · ');
        const wants = r.wants_contact ? '<span class="tag verified">wants contact</span>' : '';
        return `<div class="item">
          <div class="main">
            <div class="name">${esc(fmtDate(r.created_at))} ${wants}</div>
            <div class="meta">${fields || '(no detail captured)'}</div>
          </div>
        </div>`;
      }).join('');
    }

    function flash(id) {
      const el = $(id); if (!el) return;
      el.classList.add('show');
      setTimeout(() => el.classList.remove('show'), 1400);
    }

    // ---- rebuild button ---------------------------------------------------
    if (DEPLOY_HOOK) {
      const b = $('rebuildBtn');
      b.classList.remove('hidden');
      $('rebuildHint').classList.add('hidden');
      b.addEventListener('click', async () => {
        b.disabled = true; b.textContent = 'Triggering…';
        try {
          await fetch(DEPLOY_HOOK, { method: 'POST', mode: 'no-cors' });
          b.textContent = 'Build requested ✓';
        } catch { b.textContent = 'Failed — retry in CF'; }
        setTimeout(() => { b.disabled = false; b.textContent = 'Rebuild site'; }, 5000);
      });
    }
  </script>
</body>
</html>
