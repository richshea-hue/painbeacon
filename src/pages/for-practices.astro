---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../lib/schema.js';
import { SITE } from '../lib/site.js';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'For practices', href: '/for-practices/' }];

// Practice inquiry form writes to the same `claims` table via the PUBLIC anon
// key (RLS = anon INSERT only). npi is blank here; clinic_name is what they type.
const SUPABASE_URL = process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_ANON_KEY || '';
---
<Base title="For pain practices — claim and enrich your listing"
      description="Own or manage a pain practice? Your practice is already listed on PainBeacon from public records. Claim it to control your information, add photos and services, and reach patients searching for pain care."
      jsonld={breadcrumbLd(crumbs)}>
  <div class="wrap narrow prose">
    <Breadcrumbs items={crumbs} />

    <p class="eyebrow">For pain practices</p>
    <h1>Your practice is already on PainBeacon. Claim it.</h1>
    <p class="lede">
      Every pain medicine practice in the U.S. is listed here from public federal
      provider records. Claiming your profile lets you correct your details, show
      patients what you offer, and stand out when they search for pain care near you.
    </p>

    <div class="fp-cta">
      <a class="btn" href="/pain-clinics/">Find your practice</a>
      <a class="btn ghost" href="#talk">Talk to us</a>
    </div>

    <h2>How it works</h2>
    <ol class="fp-steps">
      <li><strong>Find your practice.</strong> Search by state and city, or look up your
        clinic by name — you’re almost certainly already listed.</li>
      <li><strong>Verify you represent it.</strong> We confirm you’re affiliated with the
        practice before any changes go live. No one can edit a profile they don’t own.</li>
      <li><strong>Enrich your profile.</strong> Add photos, services, accepted insurance,
        provider bios, and a booking link so patients choose you with confidence.</li>
    </ol>

    <h2 id="upgrade">What you get</h2>
    <div class="tiers">
      <div class="tier">
        <h3>Listed</h3>
        <p class="tier-price">Free · always</p>
        <ul>
          <li>Name, location, phone, and credentials from the NPI registry</li>
          <li>Verified location, hours, and patient reviews</li>
          <li>Appears in city and condition searches</li>
        </ul>
        <p class="tier-note">You never pay to appear. Every practice is listed.</p>
      </div>

      <div class="tier">
        <h3>Claimed &amp; verified</h3>
        <p class="tier-price">Free</p>
        <ul>
          <li>Confirm you represent the practice</li>
          <li>Correct your address, phone, hours, and website</li>
          <li>A “Verified” badge on your profile</li>
          <li>Your website linked from your profile — a followed link, free for a limited time</li>
          <li>An <a href="/verified-badge/">embeddable “Verified by PainBeacon” badge</a> for your own site</li>
        </ul>
        <p class="tier-note">The foundation — claim first, enrich anytime.</p>
      </div>

      <div class="tier featured">
        <h3>Enhanced</h3>
        <p class="tier-price">{SITE.pricing.enhanced.price}<span class="tier-per">{SITE.pricing.enhanced.period}</span></p>
        {SITE.pricing.enhanced.note && <p class="tier-trial">{SITE.pricing.enhanced.note}</p>}
        <ul>
          <li>Photos and a custom practice description</li>
          <li>Full services, conditions treated, and accepted insurance</li>
          <li>Provider bios and a direct booking / contact link</li>
        </ul>
        <a class="btn tier-btn" href={SITE.pricing.enhanced.url || '#talk'}
           {...(SITE.pricing.enhanced.url ? { target: '_blank', rel: 'noopener' } : {})}>
          {SITE.pricing.enhanced.url ? 'Get Enhanced' : 'Talk to us'}
        </a>
        <p class="tier-commit">
          Or <strong>{SITE.pricing.enhanced.commit.price}</strong> for {SITE.pricing.enhanced.commit.label}
          <span class="tier-per">({SITE.pricing.enhanced.commit.per})</span>
          {SITE.pricing.enhanced.commit.url && <> · <a href={SITE.pricing.enhanced.commit.url} target="_blank" rel="noopener">Prepay 3 months</a></>}
        </p>
        <p class="tier-note">Make your profile the most complete one in your area.</p>
      </div>

      <div class="tier">
        <h3>Featured</h3>
        <p class="tier-price">{SITE.pricing.featured.price}<span class="tier-per">{SITE.pricing.featured.period}</span></p>
        <ul>
          <li><strong>The top slot on every area page you serve</strong> — a labeled Featured card above the ranked list, and one practice per area, so a competitor can never buy in beside you</li>
          <li><strong>On the clinic map</strong> — whenever your practice is in view, it appears in the sponsored rail beside the results, on every search and pan</li>
          <li>A Featured badge on your profile and on your card wherever it appears</li>
          <li>Eligible for the homepage sponsored slot</li>
          <li>Everything in Enhanced</li>
        </ul>
        <a class="btn tier-btn" href={SITE.pricing.featured.url || '#talk'}
           {...(SITE.pricing.featured.url ? { target: '_blank', rel: 'noopener' } : {})}>
          {SITE.pricing.featured.url ? 'Get Featured' : 'Talk to us'}
        </a>
        <p class="tier-commit">
          Or <strong>{SITE.pricing.featured.commit.price}</strong> for {SITE.pricing.featured.commit.label}
          <span class="tier-per">({SITE.pricing.featured.commit.per})</span>
          {SITE.pricing.featured.commit.url && <> · <a href={SITE.pricing.featured.commit.url} target="_blank" rel="noopener">Prepay 3 months</a></>}
        </p>
        <p class="tier-note">Labeled as advertising — kept separate from ranking. Areas sell one at a time; ask whether yours is open.</p>
      </div>
    </div>
    <p class="tier-foot">Secure checkout via Stripe. We verify you represent the practice before an
      upgraded listing goes live — if we can’t verify it, you’re fully refunded. Prepaid terms
      run three months from the day your listing goes live and renew month to month after.</p>
    <p class="tier-foot">Not a clinic? Brands and professional services that serve people in pain can
      sponsor pages by state — see <a href="/advertise/">advertising on PainBeacon</a>.</p>

    <h2>How we keep it fair</h2>
    <p>
      Our rankings are independent and <a href="/how-we-rank/">published in full</a>.
      <strong>Paying never changes your rank</strong> — Enhanced and Featured add
      content and clearly labeled placement, but the order clinics appear in is set
      only by objective signals like credentials, verified reviews, and years in
      practice. Featured spots are always marked as advertising.
    </p>
    <p>
      The directory is built on the public federal NPI registry, so your core listing
      is accurate from day one. See <a href="/ownership-disclosure/">who’s behind this</a>.
    </p>

    <h2 id="talk">Talk to us</h2>
    <p>Can’t find your practice, or want to hear about Enhanced and Featured? Send a note
      and we’ll get back to you.</p>

    <div class="pq" data-su={SUPABASE_URL} data-sk={SUPABASE_KEY}>
      <div class="pq-form">
        <div class="pq-row">
          <label>Practice name
            <input class="pq-in" data-f="clinic_name" type="text" autocomplete="organization" />
          </label>
          <label>Your name
            <input class="pq-in" data-f="contact_name" type="text" autocomplete="name" />
          </label>
        </div>
        <div class="pq-row">
          <label>Work email
            <input class="pq-in" data-f="work_email" type="email" autocomplete="email" placeholder="you@practice.com" />
          </label>
          <label>Phone
            <input class="pq-in" data-f="phone" type="tel" autocomplete="tel" />
          </label>
        </div>
        <div class="pq-row">
          <label>Your role
            <select class="pq-in" data-f="role">
              <option value="">Select…</option>
              <option>Owner</option>
              <option>Physician / provider</option>
              <option>Office manager</option>
              <option>Marketing</option>
              <option>Other</option>
            </select>
          </label>
          <label>Interested in
            <select class="pq-in" data-f="interest">
              <option value="Claim &amp; verify (free)">Claiming my listing (free)</option>
              <option value="Enhanced profile">Enhanced profile</option>
              <option value="Featured placement">Featured placement</option>
              <option value="Not sure yet">Not sure yet — tell me more</option>
            </select>
          </label>
        </div>
        <label>Message <span class="pq-muted">(optional)</span>
          <textarea class="pq-in" data-f="message" rows="3"></textarea>
        </label>
        <input class="pq-hp" data-f="_company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn pq-submit" type="button">Send</button>
        <p class="pq-fine">We verify that you represent a practice before any changes go live.
          Sending doesn’t charge you anything.</p>
      </div>
      <div class="pq-done" hidden>
        <strong>Thanks — your note is in.</strong>
        <p>We’ll get back to you at the email you provided.</p>
      </div>
    </div>
  </div>

  <style>
    .fp-cta { display:flex; gap:.6rem; flex-wrap:wrap; margin:1.5rem 0 0.5rem; }
    .fp-steps { line-height:1.6; }
    .fp-steps li { margin:.5rem 0; }
    .tiers { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:.9rem; margin:1rem 0; }
    .tier { border:1px solid var(--line,#e3ddcf); border-radius:14px; background:var(--card,#fff);
      padding:1.1rem 1.2rem; }
    .tier.featured { border-color:color-mix(in srgb, var(--teal,#0e6e62) 45%, var(--line,#e3ddcf));
      box-shadow:0 1px 3px rgba(10,79,70,.08); }
    .tier h3 { margin:0 0 .15rem; }
    .tier-price { font-family:var(--mono,monospace); font-size:1.35rem; font-weight:600;
      color:var(--teal-deep,#0a4f46); margin:0 0 .7rem; }
    .tier-per { font-size:.8rem; font-weight:400; color:var(--ink-faint,#7c8a87); }
    .tier-trial { display:inline-block; font-size:.74rem; font-weight:600; color:var(--teal-deep,#0a4f46);
      background:color-mix(in srgb, var(--teal,#0e6e62) 14%, transparent); border-radius:999px;
      padding:.1rem .5rem; margin:-.3rem 0 .6rem; }
    .tier-btn { display:inline-block; margin:.2rem 0 .7rem; }
    .tier-foot { font-size:.8rem; color:var(--ink-faint,#7c8a87); margin:.4rem 0 0; line-height:1.5; }
    .tier ul { margin:0 0 .7rem; padding-left:1.1rem; }
    .tier li { margin:.3rem 0; font-size:.93rem; }
    .tier-note { font-size:.8rem; color:var(--ink-faint,#7c8a87); margin:0; }
    .tier-commit { font-size:.86rem; color:var(--ink-soft,#4c5b59); margin:0 0 .6rem; line-height:1.45; }
    .tier-commit strong { font-family:var(--mono,monospace); color:var(--teal-deep,#0a4f46); }
    .pq { border:1px solid var(--line,#e3ddcf); border-radius:14px; background:var(--card,#fff);
      padding:1.1rem 1.2rem; margin:1rem 0; position:relative; }
    .pq-form { display:flex; flex-direction:column; gap:.7rem; }
    .pq-row { display:flex; gap:.7rem; flex-wrap:wrap; }
    .pq-form label { flex:1 1 200px; display:flex; flex-direction:column; gap:.25rem;
      font-size:.82rem; color:var(--ink-soft,#4c5b59); }
    .pq-in { padding:.55rem .65rem; border:1px solid var(--line,#e3ddcf); border-radius:9px;
      font-size:1rem; font-family:inherit; box-sizing:border-box;
      background:var(--paper,#f7f4ed); color:var(--ink,#1c2b2a); }
    .pq-in:focus { outline:none; border-color:var(--teal,#0e6e62);
      box-shadow:0 0 0 3px color-mix(in srgb, var(--teal,#0e6e62) 16%, transparent); }
    .pq-submit { align-self:flex-start; }
    .pq-muted { color:var(--ink-faint,#7c8a87); font-weight:400; }
    .pq-fine { font-size:.72rem; color:var(--ink-faint,#7c8a87); margin:.2rem 0 0; line-height:1.45; }
    .pq-hp { position:absolute; left:-9999px; width:1px; height:1px; opacity:0; }
  </style>

  <script is:inline>
    (function () {
      var root = document.querySelector('.pq');
      if (!root) return;
      var SU = root.getAttribute('data-su'), SK = root.getAttribute('data-sk');
      var form = root.querySelector('.pq-form'), done = root.querySelector('.pq-done');
      function get(f) { var el = root.querySelector('[data-f="' + f + '"]'); return el ? el.value.trim() : ''; }
      root.querySelector('.pq-submit').addEventListener('click', function () {
        if (root.querySelector('.pq-hp').value) return; // honeypot
        var name = get('contact_name'), email = get('work_email');
        if (!name) { root.querySelector('[data-f="contact_name"]').focus(); return; }
        if (!email || email.indexOf('@') < 1) { root.querySelector('[data-f="work_email"]').focus(); return; }
        var payload = {
          npi: null,
          clinic_slug: null,
          clinic_name: get('clinic_name'),
          contact_name: name,
          role: get('role'),
          work_email: email,
          phone: get('phone'),
          interest: get('interest'),
          message: get('message'),
          source_page: location.pathname,
          user_agent: navigator.userAgent,
        };
        if (SU && SK) {
          fetch(SU.replace(/\/$/, '') + '/rest/v1/claims', {
            method: 'POST',
            headers: { apikey: SK, Authorization: 'Bearer ' + SK,
              'Content-Type': 'application/json', Prefer: 'return=minimal' },
            body: JSON.stringify(payload),
          }).catch(function () {});
        }
        form.hidden = true; done.hidden = false;
      });
    })();
  </script>
</Base>
