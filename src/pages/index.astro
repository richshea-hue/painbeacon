---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site.js';
import { getClinics, groupBy, stateName, titleCase } from '../lib/data.js';
import { rankClinics } from '../lib/ranking.js';
import { getDesertStats } from '../lib/deserts.js';
import { websiteLd } from '../lib/schema.js';
import { getCollection } from 'astro:content';

const clinics = await getClinics();
// Count and group PRIMARY practices only, so duplicates folded by dedup never
// inflate the homepage numbers or the search counts.
const primaries = clinics.filter((c) => c.isPrimary);
const byState = groupBy(primaries, (c) => c.state);
const states = [...byState.keys()].sort().map((s) => ({
  abbr: s, name: stateName(s), count: byState.get(s).length,
}));

// Mapped clinic count for the map invitation — must agree with what the
// national map actually shows (same filter as /map-clinics.json).
const mapped = primaries.filter(
  (c) =>
    c.latitude != null &&
    c.longitude != null &&
    (Number(c.latitude) !== 0 || Number(c.longitude) !== 0)
).length;

// Top areas: the biggest zones by clinic count. These are what most visitors
// are actually looking for; the full state wall lives on /pain-clinics/.
const topZones = [...groupBy(primaries.filter((c) => c.zoneUrlSlug), (c) => c.zoneSlug).values()]
  .map((list) => ({
    label: `${list[0].zoneLabel}, ${list[0].state}`,
    href: `/pain-clinics/${list[0].stateSlug}/${list[0].zoneUrlSlug}/`,
    n: list.length,
  }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 10);

// Research & guides row: the deserts study plus the two most recent articles.
const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const desertStats = await getDesertStats();
const fmtDate = (d) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Homepage sponsor slot: at most ONE clearly-labeled featured clinic,
// deterministic (the top-ranked of the featured tier) so builds are stable.
// When none is sold the slot simply doesn't render — the claim-your-listing
// band below it is the pitch.
const sponsored = rankClinics(primaries.filter((c) => c.listing_tier === 'featured'))[0] || null;

// Search index: every CITY stays searchable (that's what people type), but
// each entry links to the ZONE page that contains it — city pages no longer
// exist after the zone migration. Cities split across zones link to the zone
// holding most of their clinics. Zone labels are indexed too, so searching
// either "Providence" or "Logan Area" works.
const routable = primaries.filter((c) => c.zoneUrlSlug);
const entries = new Map();
for (const [, list] of groupBy(routable, (c) => `${c.state}/${c.citySlug}`)) {
  const zoneCount = new Map();
  for (const c of list) zoneCount.set(c.zoneUrlSlug, (zoneCount.get(c.zoneUrlSlug) || 0) + 1);
  const topZone = [...zoneCount.entries()].sort((a, b) => b[1] - a[1])[0][0];
  const c = list[0];
  const label = `${c.cityLabel}, ${c.state}`;
  entries.set(label, { label, href: `/pain-clinics/${c.stateSlug}/${topZone}/`, n: list.length });
}
for (const [, list] of groupBy(routable, (c) => c.zoneSlug)) {
  const c = list[0];
  const label = `${c.zoneLabel}, ${c.state}`;
  if (!entries.has(label)) {
    entries.set(label, { label, href: `/pain-clinics/${c.stateSlug}/${c.zoneUrlSlug}/`, n: list.length });
  }
}
const cityIndex = [...entries.values()].sort((a, b) => b.n - a.n);

const total = primaries.length;
---
<Base description={SITE.description} jsonld={websiteLd()}>
  <section class="hero-dark">
    <picture class="hero-photo">
      <source media="(max-width: 980px)" type="image/webp" srcset="/brand/hero-clinic-band.webp" />
      <source media="(max-width: 980px)" srcset="/brand/hero-clinic-band.jpg" />
      <source type="image/webp" srcset="/brand/hero-clinic-wide.webp" />
      <img
        src="/brand/hero-clinic-wide.jpg"
        width="1600"
        height="720"
        alt="A board-certified pain specialist listening to a patient during a clinic consultation"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="wrap">
      <div class="inner">
        <p class="eyebrow">{total.toLocaleString()} pain clinics · {states.length} states and territories</p>
        <h1>Find the right <span class="hl">pain clinic</span> near you.</h1>
        <p class="lede">
          Board-certified pain specialists, ranked on objective, published
          criteria — board certification, interventional capability, and
          verified patient reviews. <strong>Not on who pays.</strong>
        </p>

        <div class="search">
          <input id="q" type="text" placeholder="Search a city or ZIP — e.g. Providence or 02906"
                 autocomplete="off" inputmode="text" aria-label="Search by city or ZIP" />
        </div>
        <ul id="results" class="tile-grid" style="margin-top:0.75rem"></ul>
        <p style="margin:0.6rem 0 0; font-size:0.92rem; color:#cfe0de;">
          Prefer to look around? <a href="/map/" style="color:#2fd4bf;">Open the interactive clinic map</a>.
        </p>
      </div>

      <div class="hero-trust">
        <span><b>No pay-to-rank</b> — independently ranked</span>
        <span>Built on the <b>federal NPI registry</b></span>
        <span><b>Verified</b> reviews &amp; credentials</span>
      </div>
    </div>
  </section>

  <section class="wrap narrow" style="padding-block:2rem 0.5rem;">
    <p class="lede" style="margin:0 0 .7rem;">Not sure where to start? Answer two quick questions and we’ll point you to top-rated clinics near you.</p>
    <button class="btn" type="button" data-open-leadchat>Find a pain clinic for me</button>
  </section>

  <section class="wrap" style="padding-block:2.5rem 1rem;">
    <p class="eyebrow">The whole directory at a glance</p>
    <a class="home-map" href="/map/">
      <img
        src="/home-map.svg"
        width="975"
        height="610"
        alt={`Map of the United States with a dot marking each of the ${mapped.toLocaleString('en-US')} pain clinics in the directory`}
        loading="lazy"
        decoding="async"
      />
      <span class="home-map-cta">
        <strong>{mapped.toLocaleString('en-US')} clinics on the interactive map</strong>
        <span>Search a city or ZIP, zoom to your area, tap any pin →</span>
      </span>
    </a>
  </section>

  <section class="wrap" style="padding-block:1.5rem;">
    <p class="eyebrow">Top areas</p>
    <ul class="tile-grid">
      {topZones.map((z) => (
        <li><a class="tile" href={z.href}>
          <span class="label">{z.label}</span><span class="n">{z.n}</span>
        </a></li>
      ))}
      <li><a class="tile" href="/pain-clinics/">
        <span class="label">All states →</span><span class="n">{states.length}</span>
      </a></li>
    </ul>
  </section>

  <section class="wrap" style="padding-block:1.5rem;">
    <p class="eyebrow">Why patients trust PainBeacon</p>
    <ul class="trust-grid">
      <li>
        <h3><a href="/how-we-rank/">Rankings you can read</a></h3>
        <p>
          Every clinic is scored on published, objective criteria — board certification,
          interventional capability, verified reviews. No clinic can pay to rank higher.
        </p>
      </li>
      <li>
        <h3>Built on federal data</h3>
        <p>
          Listings come from the U.S. federal NPI registry and are enriched with verified
          location, hours, and review information — not self-submitted marketing.
        </p>
      </li>
      <li>
        <h3><a href="/ownership-disclosure/">Nothing hidden</a></h3>
        <p>
          Our ownership disclosure says exactly who runs this directory, and every paid
          placement on the site is labeled as such.
        </p>
      </li>
    </ul>
  </section>

  <section class="wrap" style="padding-block:1.5rem;">
    <p class="eyebrow">Research &amp; guides</p>
    <ol class="article-feed" style="margin-top:1rem;">
      <li>
        <a class="article-card" href="/research/pain-care-deserts/">
          <div class="article-card-body">
            <p class="article-kicker">Original research</p>
            <h2>Pain Care Deserts: {desertStats.desertCount.toLocaleString('en-US')} U.S. counties have no pain clinic</h2>
            <p class="article-dek">
              {desertStats.desertPct}% of U.S. counties have no pain management clinic at all.
              Our county-by-county analysis of federal registry data — with the full dataset
              free to download and cite.
            </p>
            <span class="article-more">Read the study →</span>
          </div>
          <img class="article-thumb" src="/social/pain-care-deserts-thumb.png"
            alt="County map of pain care deserts in the United States"
            width="180" height="180" loading="lazy" decoding="async" />
        </a>
      </li>
      {articles.map((a) => (
        <li>
          <a class="article-card" href={`/news/${a.slug}/`}>
            <div class="article-card-body">
              <p class="article-kicker">
                {a.data.category} · <time datetime={a.data.date.toISOString().slice(0, 10)}>{fmtDate(a.data.date)}</time>
              </p>
              <h2>{a.data.title}</h2>
              <p class="article-dek">{a.data.dek}</p>
              <span class="article-more">Read →</span>
            </div>
            <img class="article-thumb" src={a.data.thumb || a.data.image || `/social/${a.slug}.png`}
              alt={a.data.thumb ? (a.data.heroAlt || '') : (a.data.imageAlt || '')}
              width="180" height="180" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ol>
  </section>

  {sponsored && (
    <section class="wrap" style="padding-block:0.5rem;">
      <div class="sponsor-card">
        <p class="sponsor-label">Sponsored</p>
        <div class="sponsor-body">
          <h3><a href={`/clinic/${sponsored.slug}/`}>{titleCase(sponsored.name)}</a></h3>
          <p>{sponsored.cityLabel}, {sponsored.state}</p>
        </div>
        <a class="btn" href={`/clinic/${sponsored.slug}/`}>View profile</a>
      </div>
    </section>
  )}

  <section class="cta-band">
    <div class="wrap">
      <div class="grow">
        <h2>Run a pain practice? <span class="hl">You're already listed.</span></h2>
        <p>Claim your free profile to verify your details, add services, and get patient leads.</p>
      </div>
      <a class="btn" href="/for-practices/">Claim your listing — free</a>
    </div>
  </section>

  <section class="wrap" style="padding-block:1.75rem 2.25rem;">
    <p class="all-states">
      <span>Browse by state:</span>
      {states.map((s) => (
        <a href={`/pain-clinics/${s.abbr.toLowerCase()}/`}>{s.name}</a>
      ))}
    </p>
  </section>

  <style>
    .home-map {
      position: relative;
      display: block;
      margin-top: 1rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
      overflow: hidden;
      text-decoration: none;
    }
    .home-map:hover { border-color: color-mix(in srgb, var(--teal) 40%, var(--line)); }
    .home-map img { display: block; width: 100%; height: auto; padding: 1rem 1rem 0; box-sizing: border-box; }
    .home-map-cta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.35rem 0.75rem;
      padding: 0.9rem 1.15rem 1rem;
      font-family: var(--sans);
    }
    .home-map-cta strong { color: var(--ink); font-size: 1.05rem; }
    .home-map-cta span { color: var(--ink-soft); font-size: 0.92rem; }
    .home-map:hover .home-map-cta strong { color: var(--teal-ink, #0f6f62); }

    .trust-grid {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1rem;
      margin: 1rem 0 0;
      padding: 0;
    }
    .trust-grid li {
      margin: 0;
      padding: 1.1rem 1.2rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
    }
    .trust-grid h3 { margin: 0 0 0.4rem; font-size: 1.02rem; }
    .trust-grid p { margin: 0; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; }

    .sponsor-card {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.25rem;
      padding: 1rem 1.2rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
    }
    .sponsor-label {
      margin: 0;
      font-family: var(--sans);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-faint);
      border: 1px solid var(--line);
      border-radius: 3px;
      padding: 0.15rem 0.45rem;
    }
    .sponsor-body { flex: 1; min-width: 12rem; }
    .sponsor-body h3 { margin: 0; font-size: 1.05rem; }
    .sponsor-body p { margin: 0.15rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }

    .all-states {
      margin: 0;
      font-family: var(--sans);
      font-size: 0.85rem;
      line-height: 1.9;
      color: var(--ink-faint);
    }
    .all-states span { font-weight: 600; color: var(--ink-soft); margin-right: 0.4rem; }
    .all-states a { color: var(--ink-soft); margin-right: 0.75rem; white-space: nowrap; }
  </style>

  <style is:global>
    /* Full-width status/hint row inside the hero search results grid. */
    #results .search-hint { grid-column: 1 / -1; list-style: none;
      padding: 0.7rem 0.15rem; color: #cfe0de; font-size: 0.92rem; }
    #results .search-hint a { color: #2fd4bf; }
  </style>
  <script type="application/json" id="city-index" set:html={JSON.stringify(cityIndex)}></script>
  <script>
    const idx = JSON.parse(document.getElementById('city-index').textContent);
    const q = document.getElementById('q');
    const out = document.getElementById('results');

    function render(list) {
      out.innerHTML = list.slice(0, 8).map((c) =>
        `<li><a class="tile" href="${c.href}"><span class="label">${c.label}</span><span class="n">${c.n}</span></a></li>`
      ).join('');
    }
    function hint(html) { out.innerHTML = `<li class="search-hint">${html}</li>`; }
    // Site-wide search logger lives on window.pbTrack (defined by the chat
    // widget, present on every page); fall back to a no-op if unavailable.
    const track = (e) => (window.pbTrack || (() => {}))(e);

    // ZIP -> zone lookup. Fetches the build-time /zip3-zones.json (cached), maps
    // the 3-digit prefix to a "state/zone" segment and navigates there.
    let zoneMap = null;
    function loadZoneMap() {
      if (zoneMap) return Promise.resolve(zoneMap);
      return fetch('/zip3-zones.json')
        .then((r) => (r.ok ? r.json() : {}))
        .then((m) => (zoneMap = m))
        .catch(() => (zoneMap = {}));
    }
    let zipBusy = false;
    function goToZip(digits, source) {
      if (zipBusy) return;
      zipBusy = true;
      hint('Finding clinics near that ZIP…');
      loadZoneMap().then((m) => {
        zipBusy = false;
        const z3 = digits.slice(0, 3);
        const seg = m[z3];
        track({ source: source || 'hero', query: digits, kind: 'zip', zip3: z3,
                matched: !!seg, zone: seg || null });
        if (seg) { window.location.href = `/pain-clinics/${seg}/`; return; }
        hint('We don\'t list clinics for that ZIP yet. <a href="/pain-clinics/">Browse by state</a>.');
      });
    }

    // A search value is "ZIP-like" if it's only digits, spaces and dashes.
    const isZipLike = (v) => v.length > 0 && /^[\d\s-]+$/.test(v);

    q.addEventListener('input', () => {
      const v = q.value.trim();
      if (!v) { out.innerHTML = ''; return; }
      if (isZipLike(v)) {
        const digits = v.replace(/\D/g, '');
        if (digits.length >= 5) goToZip(digits, 'hero');
        else hint('Enter all 5 digits of your ZIP…');
        return;
      }
      render(idx.filter((c) => (c.label || '').toLowerCase().includes(v.toLowerCase())));
    });

    // Enter: fire the ZIP lookup immediately (e.g. after a paste); for a city
    // name, log the search intent (whether or not we have matches for it).
    q.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const v = q.value.trim();
      const digits = v.replace(/\D/g, '');
      if (isZipLike(v) && digits.length >= 5) { e.preventDefault(); goToZip(digits, 'hero'); return; }
      if (v) {
        const matched = idx.some((c) => (c.label || '').toLowerCase().includes(v.toLowerCase()));
        track({ source: 'hero', query: v, kind: 'city', zip3: null, matched, zone: null });
      }
    });

    // Deep link: /?zip=02906 (or ?zip=028) sends the visitor straight to the
    // matching zone — handy for ads and email that should land on a local page.
    (function () {
      const p = new URLSearchParams(location.search).get('zip');
      if (!p) return;
      const digits = p.replace(/\D/g, '');
      if (digits.length < 5) return;
      q.value = digits;
      goToZip(digits, 'deep_link');
    })();
  </script>
</Base>
