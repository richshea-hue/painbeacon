---
import Base from '../layouts/Base.astro';
import ClinicFinderMap from '../components/ClinicFinderMap.astro';
import { SITE } from '../lib/site.js';
import { getClinics, groupBy, stateName } from '../lib/data.js';
import { websiteLd } from '../lib/schema.js';

const clinics = await getClinics();
// Count and group PRIMARY practices only, so duplicates folded by dedup never
// inflate the homepage numbers or the search counts.
const primaries = clinics.filter((c) => c.isPrimary);
const byState = groupBy(primaries, (c) => c.state);
const states = [...byState.keys()].sort().map((s) => ({
  abbr: s, name: stateName(s), count: byState.get(s).length,
}));

// Search index: ONE entry per destination zone page. City pages no longer exist
// after the zone migration, so every city a visitor might type routes to a zone —
// which means indexing cities as their own rows produced duplicates of the same
// page. "Beverly Hills, CA" and "Beverly Hills Area, CA" were two rows for one
// page, and the city row understated the count (its own clinics, not the page's).
//
// So: each zone is one row carrying the zone's true count, and every city inside
// it becomes a search ALIAS (`alt`) — searching "Malibu" still finds the Beverly
// Hills Area page, and a city split across zones now surfaces every zone it's in
// instead of only its majority one.
const routable = primaries.filter((c) => c.zoneUrlSlug);
const zones = new Map();
for (const c of routable) {
  const href = `/pain-clinics/${c.stateSlug}/${c.zoneUrlSlug}/`;
  if (!zones.has(href)) {
    zones.set(href, { label: `${c.zoneLabel}, ${c.state}`, href, n: 0, cities: new Map() });
  }
  const z = zones.get(href);
  z.n++;
  const city = `${c.cityLabel}, ${c.state}`;
  z.cities.set(city, (z.cities.get(city) || 0) + 1);
}
// "Beverly Hills" vs "Beverly Hills Area" match the same thing, so an alias that
// only restates the zone name is dropped — it can never widen what's findable.
const searchKey = (s) => s.toLowerCase().replace(/\s+area\b/g, '').replace(/[^a-z0-9]+/g, '');
const cityIndex = [...zones.values()]
  .map((z) => {
    const zoneKey = searchKey(z.label);
    const alt = [...z.cities.entries()]
      .filter(([label]) => searchKey(label) !== zoneKey)
      .sort((a, b) => b[1] - a[1])
      .map(([label]) => label);
    return { label: z.label, href: z.href, n: z.n, alt };
  })
  .sort((a, b) => b.n - a.n);

const total = primaries.length;
---
<Base description={SITE.description} jsonld={websiteLd()}>
  <section class="hero-dark">
    <picture class="hero-photo">
      <source media="(max-width: 980px)" type="image/webp" srcset="/brand/hero-clinic-band.webp" />
      <source media="(max-width: 980px)" srcset="/brand/hero-clinic-band.jpg" />
      <source type="image/webp" srcset="/brand/hero-clinic-wide.webp" />
      <img
        src="/brand/hero-clinic-wide.jpg"
        width="1600"
        height="720"
        alt="A board-certified pain specialist listening to a patient during a clinic consultation"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="wrap">
      <div class="inner">
        <p class="eyebrow">{total.toLocaleString()} pain clinics · {states.length} states and territories</p>
        <h1>Find the right <span class="hl">pain clinic</span> near you.</h1>
        <p class="lede">
          Board-certified pain specialists, ranked on objective, published
          criteria — board certification, interventional capability, and
          verified patient reviews. <strong>Not on who pays.</strong>
        </p>

        <div class="search">
          <input id="q" type="text" placeholder="Search a clinic, city, or ZIP — e.g. Providence or 02906"
                 autocomplete="off" inputmode="text" aria-label="Search by clinic name, city, or ZIP" />
        </div>
        <ul id="results" class="tile-grid" style="margin-top:0.75rem"></ul>
      </div>

      <div class="hero-trust">
        <span><b>No pay-to-rank</b> — independently ranked</span>
        <span>Built on the <b>federal NPI registry</b></span>
        <span><b>Verified</b> reviews &amp; credentials</span>
      </div>
    </div>
  </section>

  <section class="wrap narrow" style="padding-block:2rem 0.5rem;">
    <p class="lede" style="margin:0 0 .7rem;">Not sure where to start? Answer two quick questions and we’ll point you to top-rated clinics near you.</p>
    <button class="btn" type="button" data-open-leadchat>Find a pain clinic for me</button>
  </section>

  <section class="wrap" style="padding-block:2.5rem;">
    <p class="eyebrow">Every clinic, mapped</p>
    <h2 class="map-head">{total.toLocaleString()} pain clinics across {states.length} states and territories</h2>
    <ClinicFinderMap />

    {/* The map is JavaScript and WebGL; these links are neither. They keep every
        state hub one crawlable hop from the home page — which is what gets them
        indexed — and give a no-JS visitor the same route the map offers. */}
    <nav class="state-links" aria-label="Browse pain clinics by state">
      <span class="state-links-head">Or browse by state:</span>
      {states.map((s) => (
        <a href={`/pain-clinics/${s.abbr.toLowerCase()}/`}>{s.name} <span class="n">{s.count}</span></a>
      ))}
    </nav>
  </section>

  <section class="wrap narrow prose" style="padding-block:1rem 2rem;">
    <hr class="rule" />
    <h2>How this directory works</h2>
    <p>
      Every listing is built from public federal provider data and enriched with
      verified location and review information. We don't accept payment to rank a
      clinic higher. Our <a href="/how-we-rank/">ranking methodology</a> is published
      in full, and our <a href="/ownership-disclosure/">ownership disclosure</a>
      explains exactly who is behind this directory.
    </p>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div class="grow">
        <h2>Run a pain practice? <span class="hl">You're already listed.</span></h2>
        <p>Search the directory by clinic name to claim your free profile — or
          <a href="/for-practices/#add">add your practice</a> if it isn't listed yet.</p>
      </div>
      <a class="btn" href="/for-practices/">Claim your listing — free</a>
    </div>
  </section>

  <style is:global>
    /* Full-width status/hint row inside the hero search results grid. */
    #results .search-hint { grid-column: 1 / -1; list-style: none;
      padding: 0.7rem 0.15rem; color: #cfe0de; font-size: 0.92rem; }
    #results .search-hint a { color: #2fd4bf; }
    /* Group label above a run of city or clinic tiles. */
    #results .search-group { grid-column: 1 / -1; list-style: none; padding: 0.5rem 0.15rem 0;
      color: #9fb4b8; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; }
    /* Tiles carrying a second line (city/ST, or the alias a zone matched on). */
    #results .tile.stacked { flex-direction: column; align-items: flex-start; gap: 0.15rem; }
    /* The "add your clinic" row — always last, so a manager who can't find
       their practice has somewhere to go instead of a dead end. */
    #results .search-add { grid-column: 1 / -1; list-style: none; margin-top: 0.35rem;
      padding: 0.7rem 0.85rem; border: 1px dashed rgba(47, 212, 191, 0.45);
      border-radius: var(--radius, 10px); color: #cfe0de; font-size: 0.9rem; }
    #results .search-add a { color: #2fd4bf; font-weight: 600; }

    /* Map section heading + the crawlable state strip that replaced the tiles. */
    .map-head { margin: 0.2rem 0 0; font-size: 1.35rem; }
    .state-links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.9rem;
      margin-top: 1rem; font-size: 0.92rem; line-height: 1.5; }
    .state-links-head { color: var(--ink-faint); font-size: 0.82rem; }
    .state-links a { color: var(--ink-soft); text-decoration: none;
      border-bottom: 1px solid var(--line); }
    .state-links a:hover { color: var(--teal-deep); border-bottom-color: var(--teal); }
    .state-links .n { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-faint); }
  </style>
  <script type="application/json" id="city-index" set:html={JSON.stringify(cityIndex)}></script>
  <script>
    const idx = JSON.parse(document.getElementById('city-index').textContent);
    const q = document.getElementById('q');
    const out = document.getElementById('results');

    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);

    // A city row that matched through an alias says so, so someone searching
    // "Malibu" understands why they're being sent to the Beverly Hills Area page.
    const cityTile = (c) => c.via
      ? `<li><a class="tile stacked" href="${c.href}"><span class="label">${esc(c.label)}</span>` +
        `<span class="n">includes ${esc(c.via)} · ${c.n}</span></a></li>`
      : `<li><a class="tile" href="${c.href}"><span class="label">${esc(c.label)}</span><span class="n">${c.n}</span></a></li>`;
    const clinicTile = (c) =>
      `<li><a class="tile stacked" href="${esc(c.href)}"><span class="label">${esc(c.name)}</span>` +
      `<span class="n">${esc(c.city)}, ${esc(c.state)}</span></a></li>`;
    // Practice owners who can't find their clinic need a next step, not a dead
    // end — this row is appended to every text search, match or no match.
    const addRow = (v) =>
      `<li class="search-add">Own or manage a pain clinic? ` +
      `<a href="/for-practices/?add=1&practice=${encodeURIComponent(v)}#add">Add your clinic — it's free</a>` +
      `</li>`;

    // One paint for the whole result list: cities (instant, from the build-time
    // index) then clinics (fetched live by name), then the add-your-clinic row.
    function paint(v, cities, clinics, pending) {
      const parts = [];
      if (cities.length) {
        parts.push('<li class="search-group">Cities &amp; areas</li>', ...cities.slice(0, 6).map(cityTile));
      }
      if (clinics.length) {
        parts.push('<li class="search-group">Clinics</li>', ...clinics.slice(0, 6).map(clinicTile));
      } else if (pending) {
        parts.push('<li class="search-hint">Searching clinic names…</li>');
      } else if (!cities.length) {
        parts.push(`<li class="search-hint">No clinic, city, or area matches “${esc(v)}” yet.</li>`);
      }
      parts.push(addRow(v));
      out.innerHTML = parts.join('');
    }
    function hint(html) { out.innerHTML = `<li class="search-hint">${html}</li>`; }
    // Site-wide search logger lives on window.pbTrack (defined by the chat
    // widget, present on every page); fall back to a no-op if unavailable.
    const track = (e) => (window.pbTrack || (() => {}))(e);

    // ZIP -> zone lookup. Fetches the build-time /zip3-zones.json (cached), maps
    // the 3-digit prefix to a "state/zone" segment and navigates there.
    let zoneMap = null;
    function loadZoneMap() {
      if (zoneMap) return Promise.resolve(zoneMap);
      return fetch('/zip3-zones.json')
        .then((r) => (r.ok ? r.json() : {}))
        .then((m) => (zoneMap = m))
        .catch(() => (zoneMap = {}));
    }
    let zipBusy = false;
    function goToZip(digits, source) {
      if (zipBusy) return;
      zipBusy = true;
      hint('Finding clinics near that ZIP…');
      loadZoneMap().then((m) => {
        zipBusy = false;
        const z3 = digits.slice(0, 3);
        const seg = m[z3];
        track({ source: source || 'hero', query: digits, kind: 'zip', zip3: z3,
                matched: !!seg, zone: seg || null });
        if (seg) { window.location.href = `/pain-clinics/${seg}/`; return; }
        hint('We don\'t list clinics for that ZIP yet. <a href="/pain-clinics/">Browse by state</a>.');
      });
    }

    // A search value is "ZIP-like" if it's only digits, spaces and dashes.
    const isZipLike = (v) => v.length > 0 && /^[\d\s-]+$/.test(v);

    // Matching is done on a normalized key, not raw text, so that the zone label
    // "Beverly Hills Area, CA" is still found by "Beverly Hills", "beverly hills,
    // ca" and "beverly-hills" alike — the same normalization the build uses to
    // decide an alias only restates its zone name.
    const key = (s) => String(s || '').toLowerCase().replace(/\s+area\b/g, '').replace(/[^a-z0-9]+/g, '');
    const keyed = idx.map((c) => ({ c, k: key(c.label), ak: (c.alt || []).map((a) => [a, key(a)]) }));

    // Zone label first, then its city aliases. Whichever alias matched rides
    // along as `via` so the tile can explain the hop. idx is pre-sorted by size
    // and the sort below is stable, so ties keep the bigger area first.
    function matchCities(v) {
      const s = key(v);
      if (!s) return [];
      const hits = [];
      for (const { c, k, ak } of keyed) {
        let rank = -1, via = null;
        if (k.startsWith(s)) rank = 0;
        else if (k.includes(s)) rank = 1;
        else {
          const lead = ak.find((a) => a[1].startsWith(s));
          if (lead) { rank = 2; via = lead[0]; }
          else {
            const any = ak.find((a) => a[1].includes(s));
            if (any) { rank = 3; via = any[0]; }
          }
        }
        if (rank >= 0) hits.push({ label: c.label, href: c.href, n: c.n, rank, via });
      }
      return hits.sort((a, b) => a.rank - b.rank);
    }
    // Clinic-name lookup lives on window.pbSearchClinics (defined by the chat
    // widget, present on every page); no-op to "no clinics" if unavailable.
    const findClinics = (v) => (window.pbSearchClinics || (() => Promise.resolve([])))(v);

    // Live name search is debounced, and a sequence number drops any response
    // that lands after the visitor has typed on.
    let timer = null;
    let seq = 0;
    function textSearch(v, opts) {
      const cities = matchCities(v);
      const my = ++seq;
      clearTimeout(timer);
      if (v.length < 3) {
        paint(v, cities, [], false);
        if (opts && opts.track) {
          track({ source: 'hero', query: v, kind: 'city', zip3: null,
                  matched: cities.length > 0, zone: null });
        }
        return;
      }
      paint(v, cities, [], true);
      const run = () => findClinics(v).then((clinics) => {
        if (my !== seq) return;
        paint(v, cities, clinics, false);
        if (opts && opts.track) {
          track({ source: 'hero', query: v, kind: clinics.length ? 'clinic' : 'city',
                  zip3: null, matched: !!(cities.length || clinics.length), zone: null });
        }
      });
      if (opts && opts.now) run(); else timer = setTimeout(run, 260);
    }

    q.addEventListener('input', () => {
      const v = q.value.trim();
      if (!v) { seq++; clearTimeout(timer); out.innerHTML = ''; return; }
      if (isZipLike(v)) {
        const digits = v.replace(/\D/g, '');
        if (digits.length >= 5) goToZip(digits, 'hero');
        else hint('Enter all 5 digits of your ZIP…');
        return;
      }
      textSearch(v);
    });

    // Enter: fire the ZIP lookup immediately (e.g. after a paste); for text,
    // skip the debounce and log the search intent (matched or not).
    q.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const v = q.value.trim();
      const digits = v.replace(/\D/g, '');
      if (isZipLike(v) && digits.length >= 5) { e.preventDefault(); goToZip(digits, 'hero'); return; }
      if (v) { e.preventDefault(); textSearch(v, { now: true, track: true }); }
    });

    // Deep link: /?zip=02906 (or ?zip=028) sends the visitor straight to the
    // matching zone — handy for ads and email that should land on a local page.
    (function () {
      const p = new URLSearchParams(location.search).get('zip');
      if (!p) return;
      const digits = p.replace(/\D/g, '');
      if (digits.length < 5) return;
      q.value = digits;
      goToZip(digits, 'deep_link');
    })();
  </script>
</Base>
