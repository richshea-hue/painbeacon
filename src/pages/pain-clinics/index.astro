---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getClinics, groupBy, stateName } from '../../lib/data.js';
import { breadcrumbLd } from '../../lib/schema.js';

const clinics = await getClinics();
const byState = groupBy(clinics, (c) => c.state);
const states = [...byState.keys()].sort().map((s) => ({
  abbr: s, name: stateName(s), count: byState.get(s).length,
}));
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Pain clinics by state', href: '/pain-clinics/' }];
---
<Base title="Pain clinics by state"
      description="Browse pain medicine clinics by state across the United States."
      jsonld={breadcrumbLd(crumbs)}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Pain clinics by state</h1>
    <p class="lede">Select a state to see clinics by city.</p>
    <ul class="tile-grid">
      {states.map((s) => (
        <li><a class="tile" href={`/pain-clinics/${s.abbr.toLowerCase()}/`}>
          <span class="label">{s.name}</span><span class="n">{s.count}</span>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
