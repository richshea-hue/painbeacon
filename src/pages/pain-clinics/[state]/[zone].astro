---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ClinicCard from '../../../components/ClinicCard.astro';
import ClinicMap from '../../../components/ClinicMap.astro';
import SponsorCard from '../../../components/SponsorCard.astro';
import { getClinics, groupBy, stateName, titleCase } from '../../../lib/data.js';
import { rankClinics } from '../../../lib/ranking.js';
import { isRankable } from '../../../lib/practice-type.js';
import PracticeFilter from '../../../components/PracticeFilter.astro';
import { breadcrumbLd, itemListLd } from '../../../lib/schema.js';
import { getMetroIndex } from '../../../lib/metros.js';
import { metroLabel, bestMetroFor } from '../../../lib/metro-defs.js';

export async function getStaticPaths() {
  const clinics = await getClinics();
  // One page per ZONE. Group only primary (deduped) practices so duplicate
  // NPPES records never appear twice or inflate the count.
  const primaries = clinics.filter((c) => c.isPrimary && c.zoneSlug);
  const byZone = groupBy(primaries, (c) => c.zoneSlug);
  return [...byZone.entries()].map(([, list]) => {
    const c0 = list[0];
    return {
      params: { state: c0.stateSlug, zone: c0.zoneUrlSlug },
      props: { clinics: list },
    };
  });
}

const { state, zone } = Astro.params;
const { clinics } = Astro.props;
const c0 = clinics[0];
const name = stateName(c0.state);
const zoneLabel = c0.zoneLabel;
const ranked = rankClinics(clinics);

// The metro this area belongs to, when at least half its clinics fall inside
// one. Links the state-bound zone page up to the cross-state metro page.
const best = bestMetroFor(await getMetroIndex(), clinics);
const metro = best && best.n * 2 >= clinics.length ? best.entry.metro : null;

// Featured = paid placement, capped at one per ZONE (exclusivity). Shown in a
// labeled, clearly-sponsored slot ABOVE the ranked list and excluded from it,
// so paid placement never mixes with the objective ranking.
const featured = ranked.filter((c) => c.listing_tier === 'featured').slice(0, 1);
const featuredNpis = new Set(featured.map((c) => c.npi));
const inList = ranked.filter((c) => !featuredNpis.has(c.npi));

// Medical-supply and service entities are listed but do not take a rank among
// clinics that treat pain: they declared a pain taxonomy in one of their
// fifteen NPPES slots, which is what put them in the directory, but a company
// that sells braces is not competing with a physician. They keep their place on
// the page — the address may be exactly what someone wants — below the ranked
// list and unnumbered. Filter to their group and they are ranked against each
// other, which is the comparison that means something for them.
const listed = inList.filter(isRankable);
const alsoHere = inList.filter((c) => !isRankable(c));

// Map pins for every clinic in this zone that has coordinates (matched ones).
const mapMarkers = ranked
  .filter((c) => c.latitude != null && c.longitude != null)
  .map((c) => ({
    lat: c.latitude,
    lng: c.longitude,
    name: titleCase(c.name),
    slug: c.slug,
    // Street line included so that clinics sharing a building — which the map
    // groups onto one pin — are told apart by their suite in the popup.
    street: [c.address_1 && titleCase(c.address_1), c.address_2 && titleCase(c.address_2)]
      .filter(Boolean)
      .join(', '),
    address: `${c.cityLabel}, ${c.state}`,
  }));

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'States', href: '/pain-clinics/' },
  { name, href: `/pain-clinics/${state}/` },
  { name: zoneLabel, href: `/pain-clinics/${state}/${zone}/` },
];
---
<Base title={`Pain clinics in ${zoneLabel}, ${c0.state}`}
      description={`${clinics.length} pain medicine clinics in the ${zoneLabel}, ${c0.state} area, ranked by board certification, interventional capability, and verified reviews.`}
      ogImage={`/social/area/${state}-${zone}.png`}
      ogImageAlt={`${clinics.length} pain clinics in the ${zoneLabel}, ${c0.state} area — PainBeacon`}
      ogImageWidth={1200}
      ogImageHeight={630}
      jsonld={[breadcrumbLd(crumbs), itemListLd(ranked, `Pain clinics in ${zoneLabel}, ${c0.state}`)]}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Pain clinics in {zoneLabel}, {c0.state}</h1>
    <p class="lede">
      {clinics.length} {clinics.length === 1 ? 'clinic' : 'clinics'} in this area, ordered by our
      <a href="/how-we-rank/"> ranking methodology</a>.
      {metro && <> Part of the <a href={`/metro/${metro.slug}/`}>{metroLabel(metro)} metro area</a>.</>}
    </p>

    <ClinicMap markers={mapMarkers} />

    {featured.length > 0 && (
      <section class="featured-slot">
        <div class="featured-head">
          <span class="featured-pill">Featured</span>
          <span class="featured-note">Sponsored placement · <a href="/how-we-rank/">independent of our ranking</a></span>
        </div>
        <ul class="clinic-list">
          {featured.map((c) => <ClinicCard clinic={c} />)}
        </ul>
      </section>
    )}

    <PracticeFilter clinics={listed} unranked={alsoHere} />

    <ul class="clinic-list" data-ranked-list>
      {listed.map((c, i) => <ClinicCard clinic={c} rank={i + 1} />)}
    </ul>

    {alsoHere.length > 0 && (
      <section class="also-here" data-also-section>
        <h2>Also listed in {zoneLabel}</h2>
        <p class="also-note">
          {alsoHere.length === 1 ? 'This record carries' : 'These records carry'} a pain taxonomy in
          the federal NPI registry, which is why {alsoHere.length === 1 ? 'it appears' : 'they appear'}
          here, but {alsoHere.length === 1 ? 'it supplies' : 'they supply'} equipment or services
          rather than treating pain — so {alsoHere.length === 1 ? 'it is' : 'they are'} not ranked
          against the clinics above.
        </p>
        <ul class="clinic-list">
          {alsoHere.map((c) => <ClinicCard clinic={c} />)}
        </ul>
      </section>
    )}

    {/* Brand sponsor bought for this STATE (data/sponsors.json). Below the
        ranked list, never inside it — a sponsor is not a clinic. */}
    <SponsorCard placement="zone" state={c0.state} />
  </div>
</Base>
