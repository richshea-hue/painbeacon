---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getClinics, groupBy, stateName } from '../../../lib/data.js';
import { breadcrumbLd, itemListLd } from '../../../lib/schema.js';

export async function getStaticPaths() {
  const clinics = await getClinics();
  // Count primary (deduped) practices only, so state + area totals are real.
  const primaries = clinics.filter((c) => c.isPrimary);
  const byState = groupBy(primaries, (c) => c.stateSlug);
  return [...byState.keys()].map((state) => ({
    params: { state },
    props: { clinics: byState.get(state) },
  }));
}

const { state } = Astro.params;
const { clinics } = Astro.props;
const abbr = clinics[0].state;
const name = stateName(abbr);

// Group by ZONE (was city). Each tile links to a zone page.
const byZone = groupBy(clinics.filter((c) => c.zoneSlug), (c) => c.zoneSlug);
const zones = [...byZone.entries()]
  .map(([, list]) => ({ urlSlug: list[0].zoneUrlSlug, label: list[0].zoneLabel, count: list.length }))
  .sort((a, b) => a.label.localeCompare(b.label));

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'States', href: '/pain-clinics/' },
  { name, href: `/pain-clinics/${state}/` },
];
---
<Base title={`Pain clinics in ${name}`}
      description={`${clinics.length} pain medicine clinics across ${zones.length} areas in ${name}. Ranked on objective, published criteria.`}
      ogImage={`/social/area/${state}.png`}
      ogImageAlt={`${clinics.length} pain clinics across ${zones.length} areas in ${name} — PainBeacon`}
      ogImageWidth={1200}
      ogImageHeight={630}
      jsonld={[breadcrumbLd(crumbs), itemListLd(clinics, `Pain clinics in ${name}`)]}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Pain clinics in {name}</h1>
    <p class="lede">{clinics.length} clinics across {zones.length} areas. Choose an area.</p>
    <ul class="tile-grid">
      {zones.map((z) => (
        <li><a class="tile" href={`/pain-clinics/${state}/${z.urlSlug}/`}>
          <span class="label">{z.label}</span><span class="n">{z.count}</span>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
