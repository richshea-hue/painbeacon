node_modules/
dist/
.astro/
.claude/
.env

# Service-account keys. GSC_SERVICE_ACCOUNT_JSON points at a Google key file
# whose contents are a private key, and the natural place to drop a download is
# the folder you are standing in. Keep it outside the repo — these patterns are
# the backstop for the time it lands here anyway.
.secrets/
*-gsc.json
*service-account*.json
*.zip
stannp_*.csv
Thumbs.db
/scripts/places_hours_cache
/scripts/.cache
# Census gazetteer source for scripts/build_zip_centroids.mjs — 6.4 MB and
# regenerable from census.gov. The generated public/zip/*.json IS committed,
# so a deploy never depends on having this file.
/data/2020_Gaz_zcta_national.txt
scripts/outreach/out/
__pycache__/
# Source photos downloaded by scripts/fetch-article-photo.mjs. Only the crops
# prepare-article-images.mjs makes from them are committed.
/.photo-src/
# Run cache for scripts/check-backlinks.mjs. public.backlinks is the store;
# this only exists so an interrupted run resumes.
/data/backlinks.json
# Sponsor report output. sponsor-report.mjs (--out/--json) and
# sponsor-report-pdf.py write wherever they are pointed, and the usage line in
# both scripts points at the repo root, so reports land here. The deliverable is
# the PDF emailed to the sponsor; the .md and .json carry that sponsor's traffic
# numbers and none of it belongs in git. Better habit: --out into
# scripts/outreach/out/, which is already ignored.
/s.json
/s.pdf
/samakow*
