# Copy to .env and fill in. .env is gitignored — real keys never get committed.
#
#   cp .env.example .env
#
# Node scripts that need keys are run with the file loaded explicitly:
#
#   node --env-file=.env scripts/fetch-article-photo.mjs --contact "physical therapy"
#
# The Astro build reads the PROCESS env, not this file, so for `npm run build`
# export the build vars in your shell or set them in the host's build settings
# (Cloudflare Pages / Vercel).

# --- Article photo sourcing (scripts/fetch-article-photo.mjs) ---------------
# Either provider may be absent; the script warns and carries on with whichever
# it has. Pexels is searched first, Unsplash is the backup.
PEXELS_API_KEY=            # https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=       # https://unsplash.com/developers

# --- Build vars (see SITE_README.md) ---------------------------------------
# With none of these set the build uses the fictional sample data and links no
# clinic websites, so it still succeeds.
SUPABASE_URL=                    # https://<project>.supabase.co
SUPABASE_ANON_KEY=               # anon is fine — it can only read the public VIEW
GOOGLE_SAFE_BROWSING_API_KEY=    # Cloud Console -> enable "Safe Browsing API" -> API key
