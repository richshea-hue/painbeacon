# Copy to .env and fill in. .env is gitignored — real keys never get committed.
#
#   cp .env.example .env
#
# Node scripts that need keys are run with the file loaded explicitly:
#
#   node --env-file=.env scripts/fetch-article-photo.mjs --contact "physical therapy"
#
# The Astro build reads the PROCESS env, not this file, so for `npm run build`
# export the build vars in your shell or set them in the host's build settings
# (Cloudflare Pages / Vercel).

# --- Article photo sourcing (scripts/fetch-article-photo.mjs) ---------------
# Either provider may be absent; the script warns and carries on with whichever
# it has. Pexels is searched first, Unsplash is the backup.
PEXELS_API_KEY=            # https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=       # https://unsplash.com/developers

# --- Build vars (see SITE_README.md) ---------------------------------------
# With none of these set the build uses the fictional sample data and links no
# clinic websites, so it still succeeds.
SUPABASE_URL=                    # https://<project>.supabase.co
SUPABASE_ANON_KEY=               # anon is fine — it can only read the public VIEW
GOOGLE_SAFE_BROWSING_API_KEY=    # Cloud Console -> enable "Safe Browsing API" -> API key

# --- Performance snapshot (scripts/performance-snapshot.mjs) -----------------
# Run on Rich's computer; the cloud container cannot reach these hosts.
SUPABASE_SERVICE_ROLE_KEY=       # server-side only — never in the Astro build env
#   Supabase renamed this in 2025: newer projects show it as the "secret" key
#   (sb_secret_...) under Settings → API Keys. Either value goes here.
#   Scripts also accept SUPABASE_SERVICE_KEY or SUPABASE_SECRET_KEY, because
#   the Python backfills were written against those names. The anon /
#   publishable key is NOT a substitute: sponsor_events and backlinks are RLS
#   default-deny, so it reads back empty rather than failing loudly.
KIT_SECRET=                      # Practice Kit: signs download links and hides the file path (functions/_lib/kit.js).
KIT_FREE_UNTIL=                  # Optional, functions only: YYYY-MM-DD. Set to end the kit's free period; tokens issued after it need a paid tier.
                                 # Set on Cloudflare Pages for BUILD and FUNCTIONS. Any long random string: openssl rand -hex 32
# --- Stripe payment links (scripts/stripe-setup-links.mjs) -------------------
# Only needed to CREATE the paid-listing links; the site itself never calls
# Stripe. Prefer a RESTRICTED key (Developers -> API keys -> Create restricted
# key) with write on Products, Prices and Payment Links and nothing else — it
# cannot refund or read customers. Run the script dry first, then --apply.
STRIPE_SECRET_KEY=

CLOUDFLARE_API_TOKEN=            # Zone > Analytics : Read (+ Zone : Read, or set the id)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=painbeacon.com
GSC_SERVICE_ACCOUNT_JSON=        # path to a service-account key added as a user on the property
GSC_SITE=sc-domain:painbeacon.com
